```indexContext
struct IndexContext
{
    const LibClang& libclang;
    const LanguageCallbacks& callbacks;
    TranslationUnit translationUnit;
    ling::Words hoverPositions;
    ling::WordMap passings;
    ling::WordLists hoverTexts;
    ling::WordLists definitionIndices;
    ling::Words definitions;
    ling::WordLists declarationFiles;
    ling::WordMap includers;
    ling::WordLists includeDirectives;
    ling::Words searchDirectories;
    ling::WordMap hoverIndices;
    ling::WordMap providers;
    ling::WordLists preprocessedFiles;
    ling::Words recordRows;
    ling::Words typeSymbols;
    ling::WordLists records;
    ling::Texts texts;
    ling::Words cursors;
    ling::WordMap outlines;
    ling::Words completionRows;
    ling::WordLists completionsByScope;
    ling::WordLists completionBases;
    ling::WordSet occurrences;
    ling::Words derivedClasses;
    ling::WordMap derivedPaths;
    ling::WordMap foreignFiles;
    ling::WordLists keptRanges;
    ling::WordMap pathKeys;
    ling::WordMap pathFiles;

    bool isPreprocessed (SourceLocation location) const
    {
        SourceFile file { nullptr };

        libclang.getSpellingLocation (location, &file, nullptr, nullptr, nullptr);

        return file == nullptr or preprocessedFiles.contains (getFileWord (file));
    }

    bool isForeign (SourceFile file)
    {
        assert (file != nullptr);

        const auto fileWord { getFileWord (file) };

        if (not foreignFiles.contains (fileWord))
        {
            const auto path { libclang.getFileName (file) };
            const auto normalPath { getNormalPath (libclang.getCString (path)) };

            foreignFiles.add (fileWord, static_cast<unsigned long long> (callbacks.isForeign (callbacks.context, normalPath.c_str())));
            libclang.disposeString (path);
        }

        return foreignFiles.at (fileWord) != 0;
    }

    bool isForeign (SourceLocation location)
    {
        SourceFile file { nullptr };

        libclang.getSpellingLocation (location, &file, nullptr, nullptr, nullptr);

        return file != nullptr and isForeign (file);
    }

    unsigned long long getPathKey (SourceFile file)
    {
        assert (file != nullptr);

        const auto fileWord { getFileWord (file) };

        if (not pathKeys.contains (fileWord))
        {
            const auto path { libclang.getFileName (file) };
            const auto normalPath { getNormalPath (libclang.getCString (path)) };
            const auto pathKey { ling::Wyhash::hashBytes (normalPath.data(), normalPath.size()) };

            pathKeys.add (fileWord, pathKey);
            pathFiles.add (pathKey, fileWord);
            libclang.disposeString (path);
        }

        return pathKeys.at (fileWord);
    }

    int getKeptPosition (SourceFile file, unsigned offset)
    {
        const auto pathKey { getPathKey (file) };

        for (int position { 0 }; position < keptRanges.getSize (pathKey); ++position)
        {
            const auto range { keptRanges.at (pathKey, position) };

            if (static_cast<unsigned> (ling::HalfWords::unpackFirst (range)) <= offset and offset < static_cast<unsigned> (ling::HalfWords::unpackSecond (range))) return position;
        }

        return invalidPosition;
    }

    bool isKept (SourceFile file, unsigned offset)
    {
        return keptRanges.isEmpty() or getKeptPosition (file, offset) != invalidPosition;
    }

    unsigned long long getSymbolHash (const char* symbol, Cursor entity)
    {
        const auto symbolHash { ling::Wyhash::hashBytes (symbol, std::strlen (symbol)) };
        SourceFile file { nullptr };
        unsigned offset { 0 };

        if (not keptRanges.isEmpty())
            libclang.getSpellingLocation (libclang.getCursorLocation (libclang.getCanonicalCursor (entity)), &file, nullptr, nullptr, &offset);

        const auto position { file != nullptr ? getKeptPosition (file, offset) : invalidPosition };

        return position != invalidPosition ? ling::Wyhash::mix (symbolHash, ling::Wyhash::mix (getPathKey (file), keptRanges.at (getPathKey (file), position))) : symbolHash;
    }

    void addPreprocessedFile (SourceFile file, TranslationUnit activeUnit = nullptr)
    {
        const auto active { activeUnit != nullptr ? activeUnit : translationUnit };

        if (file != nullptr and active != nullptr and not preprocessedFiles.contains (getFileWord (file)))
        {
            std::size_t size { 0 };
            const auto* contents { libclang.getFileContents (active, file, &size) };

            preprocessedFiles.add (getFileWord (file), static_cast<unsigned long long> (reinterpret_cast<std::uintptr_t> (contents)));
            preprocessedFiles.add (getFileWord (file), static_cast<unsigned long long> (size));
        }
    }

    std::string_view getFileContents (SourceFile file, TranslationUnit activeUnit = nullptr) const
    {
        const auto fileWord { getFileWord (file) };

        if (preprocessedFiles.contains (fileWord))
        {
            const auto* stored { reinterpret_cast<const char*> (static_cast<std::uintptr_t> (preprocessedFiles.at (fileWord, 0))) };

            if (stored != nullptr)
                return std::string_view (stored, static_cast<std::size_t> (preprocessedFiles.at (fileWord, 1)));
        }

        const auto active { activeUnit != nullptr ? activeUnit : translationUnit };

        if (active != nullptr and file != nullptr)
        {
            std::size_t size { 0 };
            const auto* contents { libclang.getFileContents (active, file, &size) };

            if (contents != nullptr)
                return std::string_view (contents, size);
        }

        return {};
    }

    int addSymbol (IndexLocation location, const char* symbol, Cursor entity, int role, int type, const char* name, int hoverPosition)
    {
        return addSymbol (libclang.indexLocSourceLocation (location), symbol, entity, role, type, name, hoverPosition);
    }

    int addSymbol (SourceLocation location, const char* symbol, Cursor entity, int role, int type, const char* name, int hoverPosition)
    {
        SourceFile file { nullptr };
        unsigned line { 0 };
        unsigned column { 0 };
        unsigned offset { 0 };

        libclang.getSpellingLocation (location, &file, &line, &column, &offset);

        if (file != nullptr and symbol != nullptr and *symbol != Chars::nullCharacter and not isForeign (file) and isKept (file, offset))
        {
            const auto fileWord { getFileWord (file) };
            const auto symbolHash { getSymbolHash (symbol, entity) };
            const auto occurrence { ling::Wyhash::mix (ling::Wyhash::mix (fileWord, static_cast<unsigned long long> (offset)), ling::Wyhash::mix (symbolHash, static_cast<unsigned long long> (role))) };

            if (not occurrences.contains (occurrence))
            {
                addPreprocessedFile (file, translationUnit != nullptr ? translationUnit : libclang.getCursorTranslationUnit (entity));
                const auto contents { getFileContents (file) };
                const std::size_t end { name != nullptr ? offset + std::strlen (name) : offset };
                int nameLength { 0 };

                occurrences.add (occurrence);

                if (name != nullptr and end > offset and end <= contents.size() and contents.compare (offset, end - offset, name) == 0 and (end == contents.size() or not (std::isalnum (static_cast<unsigned char> (contents.at (end))) != 0 or contents.at (end) == static_cast<char> (Chars::underscore))))
                    nameLength = static_cast<int> (end - offset);

                const auto record { recordRows.size() / recordStride };

                records.add (fileWord, static_cast<unsigned long long> (record));
                recordRows.add (ling::HalfWords::pack (static_cast<int> (offset), nameLength));
                recordRows.add (ling::HalfWords::pack (static_cast<int> (line), static_cast<int> (column)));
                recordRows.add (ling::HalfWords::pack (role, type));
                recordRows.add (symbolHash);
                recordRows.add (ling::HalfWords::pack (hoverPosition, 0));
                recordRows.add (ling::HalfWords::pack (typeSymbols.size(), 0));

                return record;
            }
        }

        return invalidPosition;
    }

    int addHover (IndexLocation location, const char* symbol, Cursor cursor)
    {
        return addHover (libclang.indexLocSourceLocation (location), symbol, cursor);
    }

    int addHover (SourceLocation location, const char* symbol, Cursor cursor)
    {
        assert (symbol != nullptr);

        SourceFile file { nullptr };
        unsigned line { 0 };
        unsigned column { 0 };
        unsigned offset { 0 };

        libclang.getSpellingLocation (location, &file, &line, &column, &offset);

        if (libclang.isInvalid (static_cast<int> (libclang.getCursorKind (cursor))) == 0 and (file == nullptr or (not isForeign (file) and isKept (file, offset))))
        {
            const auto position { hoverPositions.size() / hoverPositionStride };

            hoverPositions.add (getFileWord (file));
            hoverPositions.add (ling::HalfWords::pack (static_cast<int> (line), static_cast<int> (column)));
            hoverPositions.add (ling::HalfWords::pack (static_cast<int> (offset), addCursor (cursors, cursor)));
            hoverPositions.add (getSymbolHash (symbol, cursor));
            hoverPositions.add (ling::HalfWords::pack (invalidPosition, 0));

            return position;
        }

        return invalidPosition;
    }

    bool isOutsideMacro (SourceLocation location) const
    {
        SourceFile spellingFile { nullptr };
        SourceFile expansionFile { nullptr };
        unsigned spellingOffset { 0 };
        unsigned expansionOffset { 0 };

        libclang.getSpellingLocation (location, &spellingFile, nullptr, nullptr, &spellingOffset);
        libclang.getExpansionLocation (location, &expansionFile, nullptr, nullptr, &expansionOffset);

        return spellingFile == expansionFile and spellingOffset == expansionOffset;
    }

    void addHint (SourceLocation location, const std::string& label, int type, bool paddingLeft, bool paddingRight)
    {
        SourceFile file { nullptr };
        unsigned line { 0 };
        unsigned column { 0 };

        libclang.getSpellingLocation (location, &file, &line, &column, nullptr);

        if (file != nullptr and isOutsideMacro (location) and not isForeign (file) and keptRanges.isEmpty())
        {
            const auto path { libclang.getFileName (file) };
            const auto normalPath { getNormalPath (libclang.getCString (path)) };

            callbacks.addInlayHint (callbacks.context, normalPath.c_str(), static_cast<int> (line), static_cast<int> (column), label.c_str(), type, static_cast<int> (paddingLeft), static_cast<int> (paddingRight));
            libclang.disposeString (path);
        }
    }

    void addInlayHint (Cursor argument, const std::string& label, int type, bool paddingLeft, bool paddingRight)
    {
        const auto extent { libclang.getCursorExtent (argument) };

        if (isOutsideMacro (libclang.getRangeEnd (extent)))
            addHint (libclang.getRangeStart (extent), label, type, paddingLeft, paddingRight);
    }

    std::string_view getPassing (SourceFile file, unsigned offset) const
    {
        const auto key { ling::Wyhash::mix (getFileWord (file), static_cast<unsigned long long> (offset)) };

        return passings.contains (key) ? texts.get (static_cast<int> (passings.at (key))) : std::string_view {};
    }
};

