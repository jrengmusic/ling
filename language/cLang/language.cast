```getCommandOutput
static std::string getCommandOutput (const std::string& command)
{
    std::string output;
    std::array<char, readBufferSize> buffer;
    FILE* pipe { openPipe (command.c_str()) };

    if (pipe != nullptr)
    {
        while (std::fgets (buffer.data(), readBufferSize, pipe) != nullptr)
            output += buffer.data();

        closePipe (pipe);
        output.erase (output.find_last_not_of (static_cast<char> (Chars::newline)) + 1);
    }

    return output;
}

```
```getQuoted
static std::string getQuoted (const std::string& text)
{
    const std::string quote (quoteLength, static_cast<char> (Chars::doubleQuote));

    return quote + text + quote;
}

```
```getVersionInstallDirectory
static std::string getVersionInstallDirectory (const std::string& versionText)
{
    const std::string_view prefix { ToolchainWord::installDirectoryPrefix };
    const auto prefixStart { versionText.find (prefix) };
    std::string installDirectory;

    if (prefixStart != std::string::npos)
    {
        const auto start { versionText.find_first_not_of (static_cast<char> (Chars::space), prefixStart + prefix.size()) };

        if (start != std::string::npos)
        {
            const auto end { versionText.find (static_cast<char> (Chars::newline), start) };

            installDirectory = versionText.substr (start, end - start);
        }
    }

    return installDirectory;
}

```
```getDriver
static std::string getDriver (const std::string& installDirectory, const char* argument)
{
    const std::string name (std::filesystem::path (argument).filename().string());

    if (const auto driver { getDrivers().find (name) }; driver != getDrivers().end())
    {
        const auto& [driverName, driverPath] { *driver };

        return (std::filesystem::path (installDirectory) / driverPath).string();
    }

    return std::string (argument);
}

```
```applyPrecompiledHeaders
static void applyPrecompiledHeaders (std::vector<std::string>& commandLine)
{
    const std::string_view suffix { ToolchainWord::precompiledSuffix };

    for (auto position { commandLine.size() }; position-- > 0;)
    {
        const std::string_view argument { commandLine.at (position) };

        if (argument.size() >= suffix.size() and argument.compare (argument.size() - suffix.size(), suffix.size(), suffix) == 0)
        {
            assert (position + 1 >= static_cast<std::size_t> (ToolchainValue::precompiledArguments));

            const auto first { commandLine.begin() + static_cast<std::ptrdiff_t> (position) + 1 - ToolchainValue::precompiledArguments };

            commandLine.erase (first, first + ToolchainValue::precompiledArguments);
        }
    }
}

```
```getArguments
static std::vector<std::string> getArguments (const char* const* arguments, int argumentCount, const std::string& installDirectory, const char* directory)
{
    std::vector<std::string> commandLine { getDriver (installDirectory, arguments[0]), ToolchainWord::workingDirectoryFlag, directory };

    for (int position { 1 }; position < argumentCount; ++position)
    {
        const std::string_view argument { arguments[position] };

        if (const auto removal { getArgumentRemovals().find (argument) }; removal != getArgumentRemovals().end())
        {
            const auto& [removalArgument, removalCount] { *removal };

            position += removalCount;
        }
        else
            commandLine.push_back (std::string (argument));
    }

    applyPrecompiledHeaders (commandLine);

    if (const auto sdkCommand { getSdkCommands().find (currentPlatform) }; sdkCommand != getSdkCommands().end())
    {
        const auto& [sdkPlatform, sdkCommandLine] { *sdkCommand };

        commandLine.push_back (getSdkFlags().at (currentPlatform));
        commandLine.push_back (getCommandOutput (sdkCommandLine));
    }

    return commandLine;
}

```
```onDeclaration
static void onDeclaration (CXClientData clientData, const CXIdxDeclInfo* declaration)
{
    const auto& context { *static_cast<const IndexContext*> (clientData) };
    const auto* classInfo { context.libclang.getCXXClassDeclInfo (declaration) };

    context.addSymbol (declaration->loc, declaration->entityInfo->USR, LanguageRole::declaration);

    if (classInfo != nullptr)
        std::for_each (classInfo->bases, classInfo->bases + classInfo->numBases,
                       [&context] (const CXIdxBaseClassInfo* base)
                       {
                           if (base->base != nullptr)
                               context.addSymbol (base->loc, base->base->USR, LanguageRole::reference | LanguageRole::base);
                       });
}

```
```onReference
static void onReference (CXClientData clientData, const CXIdxEntityRefInfo* reference)
{
    const auto& context { *static_cast<const IndexContext*> (clientData) };

    context.addSymbol (reference->loc, reference->referencedEntity->USR, referenceRoles[reference->role & CXSymbolRole_Call]);
}

```
```export
#if defined (_WIN32)
extern "C" __declspec (dllexport) const void* ling_get_language (const char* name);
#else
extern "C" __attribute__ ((visibility ("default"))) const void* ling_get_language (const char* name);
#endif

extern "C" const void* ling_get_language (const char* name)
{
    static const std::pair<const char*, const void*> languageEntries[] {
        { LanguageEntry::build, reinterpret_cast<const void*> (&CLanguageDocument::build) },
        { LanguageEntry::index, reinterpret_cast<const void*> (&CLanguageDocument::index) },
        { LanguageEntry::code, code.data() },
        { LanguageEntry::commentOpen, Chars::cssCommentOpen },
        { LanguageEntry::commentClose, Chars::cssCommentClose },
        { LanguageEntry::lineCommentOpen, Chars::doubleSlash },
        { LanguageEntry::escape, &Chars::backslash },
        { LanguageEntry::keywords, keywords },
        { LanguageEntry::roles, roles.data() },
        { LanguageEntry::extensionPairs, extensionPairs }
    };

    for (const auto& [entryName, entryValue] : languageEntries)
        if (std::strcmp (entryName, name) == 0) return entryValue;

    return nullptr;
}

