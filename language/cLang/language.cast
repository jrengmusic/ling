```getHoverLines
static std::string getHoverLines (IndexContext& context, Cursor cursor, std::string_view passing)
{
    static const ling::LookupTable hoverTypes {
        {
:::[list]:::
        }
    };

    const char space { static_cast<char> (Chars::space) };
    const char newline { static_cast<char> (Chars::newline) };
    const int cursorType { context.libclang.getCursorKind (cursor) };
    const int hoverCursorType { getHoverCursorType (context.libclang, cursor) };
    const bool isFunction { static_cast<HoverScope> (hoverScopes[hoverCursorType]) == HoverScope::function };
    const bool hasResult { isFunction and hoverCursorType != static_cast<int> (CursorType::constructor) and hoverCursorType != static_cast<int> (CursorType::destructor) and hoverCursorType != static_cast<int> (CursorType::conversionFunction) };
    const auto parameters { isFunction ? getHoverParameters (context, cursor) : std::string() };
    const auto type { static_cast<HoverType> (hoverTypes[cursorType]) == HoverType::alias ? context.libclang.getCanonicalType (context.libclang.getTypedefDeclUnderlyingType (cursor)) : context.libclang.getCursorType (cursor) };
    const auto comment { cursorType == static_cast<int> (CursorType::cursorNamespace) ? std::string() : getHoverComment (context.libclang, cursor) };
    std::string lines;

    lines += hasResult ? std::string (HoverLabel::arrow) + space + getHoverType (context.libclang, context.libclang.getCursorResultType (cursor), true) + newline : std::string();
    lines += parameters.empty() ? std::string() : std::string (HoverLabel::parameters) + newline + parameters + newline;
    lines += static_cast<HoverType> (hoverTypes[cursorType]) == HoverType::none ? std::string() : std::string (HoverLabel::type) + space + getHoverType (context.libclang, type, true) + newline;
    lines += cursorType == static_cast<int> (CursorType::enumerationConstantDeclaration) ? std::string (HoverLabel::value) + space + std::to_string (context.libclang.getEnumConstantDeclValue (cursor)) + newline : std::string();
    lines += getHoverValue (context, cursor);
    lines += passing.empty() ? std::string() : std::string (passing) + newline;
    lines += comment.empty() ? std::string() : comment + newline;
    lines.erase (lines.find_last_not_of (newline) + 1);

    return lines;
}

```
```getHoverBlock
static std::string getHoverBlock (const LibClang& libclang, Cursor cursor, bool hasDefinition)
{
    static const ling::AddressTable hoverAccess {
        {
:::[list]:::
        }
    };

    const char space { static_cast<char> (Chars::space) };
    const char newline { static_cast<char> (Chars::newline) };
    const char colon { static_cast<char> (Chars::colon) };
    std::string block;

    if (hasDefinition)
    {
        const auto scope { getHoverScope (libclang, cursor) };
        const std::string access (static_cast<const char*> (hoverAccess[libclang.getCXXAccessSpecifier (cursor)]));

        block = (scope.empty() ? std::string() : scope + newline) + (access.empty() ? std::string() : access + colon + space);
        block += cursor.type == CursorType::macroDefinition ? std::string (HoverLabel::define) + space : std::string();
    }

    return block;
}

```
```getHover
static std::string getHover (IndexContext& context, Cursor cursor, std::string_view passing, std::string_view provider, bool hasDefinition)
{
    const char space { static_cast<char> (Chars::space) };
    const std::string paragraphBreak { static_cast<char> (Chars::newline), static_cast<char> (Chars::newline) };
    const std::string word (getHoverWord (context.libclang, cursor));
    const auto name { getHoverName (context.libclang, cursor) };
    const auto lines { getHoverLines (context, cursor, passing) };
    const auto block { getHoverBlock (context.libclang, cursor, hasDefinition) };
    std::string text (word.empty() ? name : word + space + name);

    text += provider.empty() ? std::string() : static_cast<char> (Chars::newline) + std::string (HoverLabel::providedBy) + space + std::string (provider);
    text += lines.empty() ? std::string() : paragraphBreak + lines;
    text += (hasDefinition or not block.empty()) ? paragraphBreak + block : std::string();

    return text;
}

