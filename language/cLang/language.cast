```addVariableTypeHint
static void addVariableTypeHint (const LibClang& libclang, IndexContext& context, Cursor variable)
{
    const char space { static_cast<char> (Chars::space) };
    const auto name { getText (libclang, libclang.getCursorSpelling (variable)) };

    if (not name.empty() and isDeducedType (libclang, libclang.getCursorType (variable)))
    {
        const auto declaration { getTypeHintDeclaration (libclang, variable) };
        const bool isNamed { declaration.size() >= name.size() and declaration.compare (declaration.size() - name.size(), name.size(), name) == 0 };

        if (isNamed)
        {
            const std::string_view type { std::string_view (declaration).substr (0, declaration.size() - name.size()) };

            addTypeHint (context, libclang.getRangeEnd (libclang.getSpellingNameRange (variable, 0, 0)), InlayHintLabel::typePrefix, type.substr (0, type.find_last_not_of (space) + 1));
        }
    }
}

