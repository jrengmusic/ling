```isIgnoredUnit
static bool isIgnoredUnit (std::string_view path)
{
    bool isIgnored { false };

    getIgnoredUnits().applyToEntries ([path, &isIgnored] (std::string_view pattern, unsigned long long)
    {
        if (not isIgnored and path.find (pattern) != std::string_view::npos)
            isIgnored = true;
    });

    return isIgnored;
}

```
```addUnitCommand
static void addUnitCommand (ling::Texts& texts, ling::Words& unitRows, ling::WordLists& unitArguments, ling::TextMap& paths, const LibClang& libclang, const std::string& installDirectory, const std::string& sdkPath, void* compileCommand, const LanguageCallbacks& callbacks)
{
    const auto unitDirectory { getText (libclang, libclang.getCompileCommandDirectory (compileCommand)) };
    const auto path { getNormalPath ((std::filesystem::path (unitDirectory) / getText (libclang, libclang.getCompileCommandFilename (compileCommand))).string()) };

    if (not isIgnoredUnit (path))
    {
        if (std::filesystem::exists (path))
        {
            if (not paths.contains (path))
            {
                const auto unit { unitRows.size() / unitStride };
                const auto directoryText { texts.add (unitDirectory) };

                for (unsigned argumentIndex { 0 }; argumentIndex < libclang.getCompileCommandNumArgs (compileCommand); ++argumentIndex)
                    unitArguments.add (static_cast<unsigned long long> (unit), static_cast<unsigned long long> (texts.add (getText (libclang, libclang.getCompileCommandArg (compileCommand, argumentIndex)))));

                setArchitecture (texts, unitArguments, unit);
                setPrecompiledHeader (texts, unitArguments, unit, unitDirectory);
                setToolchain (texts, unitArguments, unit, installDirectory, sdkPath);

                const auto outputPosition { getFlagPosition (texts, unitArguments, unit, ToolchainWord::outputFlag) };
                const auto outputText { outputPosition != invalidPosition ? texts.add (getNormalPath ((std::filesystem::path (unitDirectory) / std::string (texts.get (static_cast<int> (unitArguments.at (static_cast<unsigned long long> (unit), outputPosition))))).string())) : invalidPosition };

                paths.add (path, static_cast<unsigned long long> (unit));
                unitRows.add (ling::HalfWords::pack (texts.add (path), directoryText));
                unitRows.add (ling::HalfWords::pack (outputText, 0));
            }
        }
        else
            callbacks.addMessage (callbacks.context, (path + ToolchainWord::messageSeparator + ToolchainWord::unitNotFound).c_str());
    }
}

```
```setArchitecture
static void setArchitecture (const ling::Texts& texts, ling::WordLists& unitArguments, int unit)
{
#if defined (__aarch64__) or defined (_M_ARM64)
    const std::string_view hostArchitecture { ToolchainWord::architectureArm64 };
#else
    const std::string_view hostArchitecture { ToolchainWord::architectureX64 };
#endif
    const std::string_view prefix { ToolchainWord::architecturePrefix };
    const auto key { static_cast<unsigned long long> (unit) };

    for (int position { 0 }; position < unitArguments.getSize (key);)
    {
        const auto argument { texts.get (static_cast<int> (unitArguments.at (key, position))) };
        const bool isLast { position + 1 == unitArguments.getSize (key) };
        const bool isFlag { argument.compare (ToolchainWord::architectureFlag) == 0 };
        const bool isPrefixed { argument.compare (0, prefix.size(), prefix) == 0 };
        const std::string_view architecture { isPrefixed ? argument.substr (prefix.size()) : isFlag and not isLast ? texts.get (static_cast<int> (unitArguments.at (key, position + 1))) : std::string_view {} };
        const bool isHost { architecture.compare (hostArchitecture) == 0 };
        const int width { isLast ? 1 : 2 };
        const int count { isPrefixed ? (isHost ? 1 : width) : (isFlag and not isHost ? width : 0) };

        if (count > 0)
            unitArguments.removeRange (key, position, count);
        else
            ++position;
    }
}

```
```setPrecompiledHeader
static void setPrecompiledHeader (ling::Texts& texts, ling::WordLists& unitArguments, int unit, const std::string& directory)
{
    const auto key { static_cast<unsigned long long> (unit) };
    const std::string_view includeFlag { ToolchainWord::includeFlag };

    for (int position { 0 }; position < unitArguments.getSize (key); ++position)
    {
        const auto argument { texts.get (static_cast<int> (unitArguments.at (key, position))) };

        if (argument.size() > includeFlag.size() and argument.compare (0, includeFlag.size(), includeFlag) == 0)
        {
            const std::string header { argument.substr (includeFlag.size()) };
            const std::string precompiledHeader { (std::filesystem::path (directory) / (header + ToolchainWord::precompiledSuffix)).string() };

            if (std::filesystem::exists (precompiledHeader))
            {
                int insertPosition { position };

                unitArguments.removeRange (key, position, 1);

                for (const std::string_view text : { std::string_view (ToolchainWord::frontendFlag), std::string_view (ToolchainWord::precompiledIncludeFlag), std::string_view (ToolchainWord::frontendFlag), std::string_view (precompiledHeader), std::string_view (ToolchainWord::frontendFlag), includeFlag, std::string_view (ToolchainWord::frontendFlag), std::string_view (header) })
                    unitArguments.insert (key, insertPosition++, static_cast<unsigned long long> (texts.add (text)));
            }

            return;
        }
    }
}

```
```setToolchain
static void setToolchain (ling::Texts& texts, ling::WordLists& unitArguments, int unit, const std::string& installDirectory, const std::string& sdkPath)
{
    const auto key { static_cast<unsigned long long> (unit) };

    unitArguments.set (key, 0, static_cast<unsigned long long> (texts.add (getDriver (installDirectory, texts.get (static_cast<int> (unitArguments.at (key, 0)))))));

    if (not sdkPath.empty())
    {
        unitArguments.add (key, static_cast<unsigned long long> (texts.add (static_cast<const char*> (getSdkFlags().getAddress (currentPlatform)))));
        unitArguments.add (key, static_cast<unsigned long long> (texts.add (sdkPath)));
    }
}

