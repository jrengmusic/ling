```isPunctuation
static bool isPunctuation (std::string_view source, const Token& token, int byte)
{
    return token.type == map::SyntaxTokenType::punctuation
           and static_cast<int> (source.at (token.start)) == byte;
}

```
```isKeyword
static bool isKeyword (const Token& token, int key)
{
    return token.type == map::SyntaxTokenType::keyword and token.key == key;
}

```
```isSameName
static bool isSameName (std::string_view source, const Token& name, const Token& otherName)
{
    return source.substr (name.start, name.end - name.start)
               .compare (source.substr (otherName.start, otherName.end - otherName.start))
           == 0;
}

```
```isMemberAccess
static bool isMemberAccess (std::string_view source, const Tokens& tokens, int namePosition)
{
    return (namePosition >= 1 and isPunctuation (source, tokens.at (namePosition - 1), Chars::dot))
           or (namePosition >= 2 and isPunctuation (source, tokens.at (namePosition - 1), Chars::greaterThan)
               and isPunctuation (source, tokens.at (namePosition - 2), Chars::dash));
}

```
```isLocalReference
static bool isLocalReference (const Element& reference)
{
    const auto type { reference.type };

    return (type == map::SyntaxTokenType::reference or type == map::SyntaxTokenType::call or type == map::SyntaxTokenType::base)
           and reference.name.size() == 1 and not reference.isMember;
}

```
```isSingleColon
static bool isSingleColon (std::string_view source, const Tokens& tokens, int index, int start, int end)
{
    return isPunctuation (source, tokens.at (index), Chars::colon)
           and not (index > start and isPunctuation (source, tokens.at (index - 1), Chars::colon))
           and not (index + 1 < end and isPunctuation (source, tokens.at (index + 1), Chars::colon));
}

```
```isFunctionScope
static bool isFunctionScope (const Element& scope)
{
    return getScopeType (scope) == map::SyntaxTokenType::function;
}

```
```getScopeType
static int getScopeType (const Element& scope)
{
    static constexpr LookupTable<int, int, map::SyntaxTokenType::macro + 1> scopeTypes {
        {
:::[list]:::
        }
    };

    return scopeTypes[scope.type];
}

```
```getDepthChange
static int getDepthChange (std::string_view source, const Token& token)
{
    static constexpr LookupTable<int, int, Chars::closeBrace + 1> depthChanges {
        {
:::[list]:::
        }
    };

    return token.type == map::SyntaxTokenType::punctuation ? depthChanges[source.at (token.start)] : 0;
}

```
```getPreludeEnd
static int getPreludeEnd (std::string_view source, const Tokens& tokens, int position, int end)
{
    int depth { 0 };

    for (int index { position }; index < end; ++index)
    {
        const auto& token { tokens.at (index) };

        if (depth == 0 and (isPunctuation (source, token, Chars::semicolon) or isPunctuation (source, token, Chars::openBrace)))
            return index;

        depth = std::max (0, depth + getDepthChange (source, token));
    }

    return end;
}

```
```getBlockEnd
static int getBlockEnd (std::string_view source, const Tokens& tokens, int blockStart, int end)
{
    int depth { 0 };

    for (int index { blockStart }; index < end; ++index)
    {
        depth += getDepthChange (source, tokens.at (index));

        if (depth == 0)
            return index;
    }

    return end;
}

```
```getBaseStart
static int getBaseStart (std::string_view source, const Tokens& tokens, int start, int end)
{
    for (int index { start }; index < end; ++index)
        if (isSingleColon (source, tokens, index, start, end))
            return index;

    return end;
}

```
```getCandidateEnd
static int getCandidateEnd (std::string_view source, const Tokens& tokens, int start, int end)
{
    int depth { 0 };

    for (int index { start }; index < end; ++index)
    {
        if (depth == 0 and (isPunctuation (source, tokens.at (index), Chars::semicolon) or isSingleColon (source, tokens, index, start, end)))
            return index;

        depth += getDepthChange (source, tokens.at (index));
    }

    return end;
}

```
```getNextPosition
static int getNextPosition (int position, int end)
{
    return std::min (position + 1, end);
}

```
```getStatementEnd
static int getStatementEnd (std::string_view source, const Tokens& tokens, int position, int end)
{
    int statementEnd { getPreludeEnd (source, tokens, position, end) };

    while (statementEnd < end and isPunctuation (source, tokens.at (statementEnd), Chars::openBrace))
        statementEnd = getPreludeEnd (source, tokens, getBlockEnd (source, tokens, statementEnd, end) + 1, end);

    return getNextPosition (statementEnd, end);
}

```
```getStatementStart
static int getStatementStart (std::string_view source, const Tokens& tokens, int candidateStart)
{
    if (candidateStart > 0 and isPunctuation (source, tokens.at (candidateStart - 1), Chars::greaterThan))
    {
        int depth { 0 };
        int open { candidateStart };

        do
        {
            --open;

            if (isPunctuation (source, tokens.at (open), Chars::greaterThan)) ++depth;
            if (isPunctuation (source, tokens.at (open), Chars::lessThan)) --depth;
        }
        while (open > 0 and depth > 0);

        if (depth == 0 and open > 0 and isKeyword (tokens.at (open - 1), map::CppKeyword::tokenTemplate))
            return getStatementStart (source, tokens, open - 1);
    }

    return candidateStart;
}

```
```getLastIdentifierPosition
static int getLastIdentifierPosition (const Tokens& tokens, int start, int end)
{
    for (int index { end - 1 }; index >= start; --index)
        if (tokens.at (index).type == map::SyntaxTokenType::identifier)
            return index;

    return invalidPosition;
}

```
```addStatements
static void addStatements (CLanguageDocument& document, int scope, const Tokens& tokens, int start, int end)
{
    const auto source { document.source };
    const auto& statementConstruction { getStatementConstruction() };
    const auto& punctuationConstruction { getPunctuationConstruction() };
    int position { start };

    while (position < end)
    {
        const auto& token { tokens.at (position) };
        const bool isKeywordToken { token.type == map::SyntaxTokenType::keyword };
        const bool isPunctuationToken { token.type == map::SyntaxTokenType::punctuation };
        const int key { isKeywordToken ? token.key
                        : isPunctuationToken ? static_cast<int> (source.at (token.start))
                        : token.type };

        position = isKeywordToken ? statementConstruction[key] (key, document, scope, tokens, position, end)
                   : isPunctuationToken ? punctuationConstruction[key] (key, document, scope, tokens, position, end)
                   : addDeclaration (key, document, scope, tokens, position, end);
    }
}

```
```skipStatement
static int skipStatement (const int&, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto statementEnd { getStatementEnd (document.source, tokens, position, end) };

    addReferences (document, scope, tokens, position, statementEnd, map::SyntaxTokenType::reference);
    return statementEnd;
}

```
```skipTemplateParameters
static int skipTemplateParameters (const int&, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto source { document.source };

    if (position + 1 < end and isPunctuation (source, tokens.at (position + 1), Chars::lessThan))
    {
        int depth { 0 };

        for (int index { position + 1 }; index < end; ++index)
        {
            if (isPunctuation (source, tokens.at (index), Chars::lessThan)) ++depth;
            if (isPunctuation (source, tokens.at (index), Chars::greaterThan)) --depth;

            if (depth == 0)
            {
                addReferences (document, scope, tokens, position + 1, index, map::SyntaxTokenType::reference);
                return index + 1;
            }
        }

        addReferences (document, scope, tokens, position + 1, end, map::SyntaxTokenType::reference);
        return end;
    }

    return position + 1;
}

```
```addBlock
static int addBlock (const int&, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto blockEnd { getBlockEnd (document.source, tokens, position, end) };

    if (isFunctionScope (document.elements.at (scope)))
        addStatements (document, scope, tokens, position + 1, blockEnd);
    else
        addReferences (document, scope, tokens, position + 1, blockEnd, map::SyntaxTokenType::reference);

    return getNextPosition (blockEnd, end);
}

```
```addExtern
static int addExtern (const int& key, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto source { document.source };

    const auto linkage { position + 1 };
    const auto blockStart { linkage + 1 };

    if (blockStart < end and tokens.at (linkage).type == map::SyntaxTokenType::string
        and isPunctuation (source, tokens.at (blockStart), Chars::openBrace))
    {
        const auto blockEnd { getBlockEnd (source, tokens, blockStart, end) };

        addStatements (document, scope, tokens, blockStart + 1, blockEnd);
        return getNextPosition (blockEnd, end);
    }

    return addDeclaration (key, document, scope, tokens, position, end);
}

```
```addNamespace
static int addNamespace (const int& key, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto preludeEnd { getPreludeEnd (source, tokens, position + 1, end) };

    if (preludeEnd < end and isPunctuation (source, tokens.at (preludeEnd), Chars::openBrace))
    {
        auto namespaceScope { scope };

        for (int index { position + 1 }; index < preludeEnd; ++index)
        {
            if (tokens.at (index).type == map::SyntaxTokenType::identifier)
            {
                namespaceScope = addElement (document, namespaceScope, getNameTokens (tokens, index, index), map::SyntaxTokenType::namespaceToken);
                addComment (document, namespaceScope, tokens, position);
            }
        }

        const auto blockEnd { getBlockEnd (source, tokens, preludeEnd, end) };

        addStatements (document, namespaceScope, tokens, preludeEnd + 1, blockEnd);
        return getNextPosition (blockEnd, end);
    }

    return skipStatement (key, document, scope, tokens, position, end);
}

```
```addClass
static int addClass (const int& key, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto preludeEnd { getPreludeEnd (source, tokens, position + 1, end) };

    if (preludeEnd < end and isPunctuation (source, tokens.at (preludeEnd), Chars::openBrace))
    {
        const auto baseStart { getBaseStart (source, tokens, position + 1, preludeEnd) };
        const auto namePosition { getLastIdentifierPosition (tokens, position + 1, baseStart) };
        const auto blockEnd { getBlockEnd (source, tokens, preludeEnd, end) };
        const int classType { key == map::CppKeyword::tokenClass ? map::SyntaxTokenType::classToken : map::SyntaxTokenType::structToken };

        if (namePosition != invalidPosition)
        {
            const auto classElement { addElement (document, scope, getNameTokens (tokens, namePosition, namePosition), classType) };

            addComment (document, classElement, tokens, position);
            addReferences (document, classElement, tokens, position + 1, namePosition, map::SyntaxTokenType::reference);
            addReferences (document, classElement, tokens, namePosition + 1, baseStart, map::SyntaxTokenType::reference);
            addReferences (document, classElement, tokens, baseStart, preludeEnd, map::SyntaxTokenType::base);
            addStatements (document, classElement, tokens, preludeEnd + 1, blockEnd);
        }
        else
        {
            addReferences (document, scope, tokens, baseStart, preludeEnd, map::SyntaxTokenType::base);
            addReferences (document, scope, tokens, preludeEnd + 1, blockEnd, map::SyntaxTokenType::reference);
        }

        return skipStatement (key, document, scope, tokens, blockEnd + 1, end);
    }

    return skipStatement (key, document, scope, tokens, position, end);
}

```
```addEnum
static int addEnum (const int& key, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto preludeEnd { getPreludeEnd (source, tokens, position + 1, end) };

    if (preludeEnd < end and isPunctuation (source, tokens.at (preludeEnd), Chars::openBrace))
    {
        const auto& first { tokens.at (position + 1) };
        int nameIndex { position + 1 };

        if (isKeyword (first, map::CppKeyword::tokenClass) or isKeyword (first, map::CppKeyword::tokenStruct))
            ++nameIndex;

        auto constantScope { scope };

        if (nameIndex < preludeEnd and tokens.at (nameIndex).type == map::SyntaxTokenType::identifier)
        {
            constantScope = addElement (document, scope, getNameTokens (tokens, nameIndex, nameIndex), map::SyntaxTokenType::enumToken);
            addComment (document, constantScope, tokens, position);
        }

        const auto blockEnd { getBlockEnd (source, tokens, preludeEnd, end) };

        addReferences (document, constantScope, tokens, nameIndex + 1, preludeEnd, map::SyntaxTokenType::reference);
        addEnumConstants (document, constantScope, tokens, preludeEnd + 1, blockEnd);
        return skipStatement (key, document, scope, tokens, blockEnd + 1, end);
    }

    return skipStatement (key, document, scope, tokens, position, end);
}

```
```addEnumConstants
static void addEnumConstants (CLanguageDocument& document, int scope, const Tokens& tokens, int start, int end)
{
    const auto source { document.source };
    int depth { 0 };
    int referenceStart { start };

    for (int index { start }; index < end; ++index)
    {
        const auto& token { tokens.at (index) };

        if (depth == 0 and token.type == map::SyntaxTokenType::identifier
            and (index == start or isPunctuation (source, tokens.at (index - 1), Chars::comma)))
        {
            addReferences (document, scope, tokens, referenceStart, index, map::SyntaxTokenType::reference);
            addComment (document, addElement (document, scope, getNameTokens (tokens, index, index), map::SyntaxTokenType::enumConstant), tokens, index);
            referenceStart = index + 1;
        }

        depth += getDepthChange (source, token);
    }

    addReferences (document, scope, tokens, referenceStart, end, map::SyntaxTokenType::reference);
}

```
```addControl
static int addControl (const int&, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    int open { position + 1 };

    while (open < end and not isPunctuation (source, tokens.at (open), Chars::openParen)
           and not isPunctuation (source, tokens.at (open), Chars::semicolon)
           and not isPunctuation (source, tokens.at (open), Chars::openBrace))
        ++open;

    if (open < end and isPunctuation (source, tokens.at (open), Chars::openParen))
    {
        const auto close { getBlockEnd (source, tokens, open, end) };
        const auto candidateEnd { getCandidateEnd (source, tokens, open + 1, close) };

        addReferences (document, scope, tokens, position + 1, open, map::SyntaxTokenType::reference);
        addDeclarationCandidate (document, scope, tokens, open + 1, candidateEnd);
        addReferences (document, scope, tokens, candidateEnd, close, map::SyntaxTokenType::reference);
        return getNextPosition (close, end);
    }

    return position + 1;
}

```
```addDirective
static int addDirective (const int&, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto row { tokens.at (position).line };
    int directiveEnd { position + 1 };

    while (directiveEnd < end and tokens.at (directiveEnd).line == row)
        ++directiveEnd;

    const auto keywordPosition { position + 1 };
    const auto macroPosition { keywordPosition + 1 };

    if (macroPosition < directiveEnd and isKeyword (tokens.at (keywordPosition), map::CppKeyword::tokenDefine)
        and tokens.at (macroPosition).type == map::SyntaxTokenType::identifier)
        addComment (document, addElement (document, scope, getNameTokens (tokens, macroPosition, macroPosition), map::SyntaxTokenType::macro), tokens, position);

    return directiveEnd;
}

```
```addDeclaration
static int addDeclaration (const int&, CLanguageDocument& document, int scope, const Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto preludeEnd { getPreludeEnd (source, tokens, position, end) };
    const auto element { addDeclarationCandidate (document, scope, tokens, position, preludeEnd) };

    if (element != invalidPosition and isFunctionScope (document.elements.at (element)) and preludeEnd < end
        and isPunctuation (source, tokens.at (preludeEnd), Chars::openBrace))
    {
        const auto bodyStart { getBodyStart (source, tokens, position, preludeEnd, end) };

        if (bodyStart < end and isPunctuation (source, tokens.at (bodyStart), Chars::openBrace))
        {
            const auto blockEnd { getBlockEnd (source, tokens, bodyStart, end) };

            addReferences (document, element, tokens, preludeEnd, bodyStart, map::SyntaxTokenType::reference);
            addStatements (document, element, tokens, bodyStart + 1, blockEnd);
            return getNextPosition (blockEnd, end);
        }
    }

    const auto statementEnd { getStatementEnd (source, tokens, position, end) };

    addReferences (document, getReferenceOwner (document, scope, element), tokens, preludeEnd, statementEnd, map::SyntaxTokenType::reference);

    return statementEnd;
}

```
```getBodyStart
static int getBodyStart (std::string_view source, const Tokens& tokens, int position, int preludeEnd, int end)
{
    int depth { 0 };

    for (int index { position }; index < preludeEnd; ++index)
    {
        if (depth == 0 and isSingleColon (source, tokens, index, position, preludeEnd))
        {
            int bodyStart { preludeEnd };

            while (bodyStart < end and isPunctuation (source, tokens.at (bodyStart), Chars::openBrace)
                   and (tokens.at (bodyStart - 1).type == map::SyntaxTokenType::identifier
                        or isPunctuation (source, tokens.at (bodyStart - 1), Chars::greaterThan)))
                bodyStart = getPreludeEnd (source, tokens, getBlockEnd (source, tokens, bodyStart, end) + 1, end);

            return bodyStart;
        }

        depth += getDepthChange (source, tokens.at (index));
    }

    return preludeEnd;
}

```
```addDeclarationCandidate
static int addDeclarationCandidate (CLanguageDocument& document, int scope, const Tokens& tokens, int start, int end)
{
    const auto source { document.source };
    const auto boundary { getBoundary (source, tokens, start, end) };
    const auto namePosition { getNamePosition (tokens, start, boundary) };

    if (namePosition != invalidPosition)
    {
        const auto qualifierStart { getQualifierStart (source, tokens, start, namePosition) };

        const bool isFunctionShape { boundary < end and isPunctuation (source, tokens.at (boundary), Chars::openParen) };
        const auto type { getDeclarationType (source, document.elements.at (scope), tokens, start, boundary, qualifierStart, namePosition, isFunctionShape) };

        if (isDeclaration (source, tokens, start, qualifierStart)
            or type == map::SyntaxTokenType::constructor or type == map::SyntaxTokenType::destructor)
        {
            const auto element { addElement (document, scope, getNameTokens (tokens, qualifierStart, namePosition), type) };

            addComment (document, element, tokens, start);
            addReferences (document, getReferenceOwner (document, scope, element), tokens, start, qualifierStart, map::SyntaxTokenType::reference);

            addDeclarationContents (document, scope, element, tokens, namePosition, boundary, end, isFunctionShape, start);
            return element;
        }
    }

    addReferences (document, scope, tokens, start, end, map::SyntaxTokenType::reference);
    return invalidPosition;
}

```
```addDeclarationContents
static void addDeclarationContents (CLanguageDocument& document, int scope, int element, const Tokens& tokens, int namePosition, int boundary, int end, bool isFunctionShape, int candidateStart)
{
    const auto owner { getReferenceOwner (document, scope, element) };

    if (isFunctionShape)
    {
        const bool hasParameters { not isFunctionScope (document.elements.at (scope)) };
        const auto close { hasParameters ? getBlockEnd (document.source, tokens, boundary, end) : boundary - 1 };

        addReferences (document, owner, tokens, namePosition + 1, boundary, map::SyntaxTokenType::reference);

        if (hasParameters)
            addParameters (document, element, tokens, boundary, close);

        addReferences (document, owner, tokens, close + 1, end, map::SyntaxTokenType::reference);
    }
    else
    {
        addDeclarators (document, scope, element, tokens, namePosition + 1, end, document.elements.at (element).type, candidateStart);
    }
}

```
```getReferenceOwner
static int getReferenceOwner (const CLanguageDocument& document, int scope, int element)
{
    return element != invalidPosition and not isFunctionScope (document.elements.at (scope)) ? element : scope;
}

```
```getBoundary
static int getBoundary (std::string_view source, const Tokens& tokens, int start, int end)
{
    static constexpr LookupTable<int, bool, Chars::greaterThan + 1> comparisonPrefixes {
        {
:::[list]:::
        }
    };

    if (start + 1 < end and isPunctuation (source, tokens.at (start), Chars::openBracket) and isPunctuation (source, tokens.at (start + 1), Chars::openBracket))
        return getBoundary (source, tokens, std::min (getBlockEnd (source, tokens, start, end) + 1, end), end);

    int angleDepth { 0 };

    for (int index { start }; index < end; ++index)
    {
        const auto& token { tokens.at (index) };
        const bool hasPreviousOperator { index > start
                                         and ((tokens.at (index - 1).type == map::SyntaxTokenType::punctuation
                                               and comparisonPrefixes[source.at (tokens.at (index - 1).start)])
                                              or isKeyword (tokens.at (index - 1), map::CppKeyword::tokenOperator)) };
        const bool hasNextEquals { index + 1 < end and isPunctuation (source, tokens.at (index + 1), Chars::equals) };

        if (index > start and isPunctuation (source, token, Chars::lessThan) and tokens.at (index - 1).type == map::SyntaxTokenType::identifier)
            ++angleDepth;
        else if (angleDepth > 0 and isPunctuation (source, token, Chars::greaterThan))
            --angleDepth;
        else if (angleDepth == 0
                 and (isPunctuation (source, token, Chars::openParen) or isPunctuation (source, token, Chars::openBracket)
                      or (isPunctuation (source, token, Chars::equals) and not hasPreviousOperator and not hasNextEquals)))
            return index;
    }

    return end;
}

```
```getNamePosition
static int getNamePosition (const Tokens& tokens, int start, int boundary)
{
    for (int index { start }; index < boundary; ++index)
        if (isKeyword (tokens.at (index), map::CppKeyword::tokenOperator))
            return index;

    return getLastIdentifierPosition (tokens, start, boundary);
}

```
```getQualifierStart
static int getQualifierStart (std::string_view source, const Tokens& tokens, int start, int namePosition)
{
    int qualifierStart { namePosition };

    if (qualifierStart - 1 >= start and isPunctuation (source, tokens.at (qualifierStart - 1), Chars::tilde))
        --qualifierStart;

    while (qualifierStart - qualifierLength >= start
           and isPunctuation (source, tokens.at (qualifierStart - 1), Chars::colon)
           and isPunctuation (source, tokens.at (qualifierStart - 2), Chars::colon)
           and tokens.at (qualifierStart - qualifierLength).type == map::SyntaxTokenType::identifier)
        qualifierStart -= qualifierLength;

    return qualifierStart;
}

```
```getNameTokens
static Tokens getNameTokens (const Tokens& tokens, int qualifierStart, int namePosition)
{
    Tokens nameTokens;

    for (int index { qualifierStart }; index <= namePosition; ++index)
    {
        const auto& token { tokens.at (index) };

        if (index == namePosition or token.type == map::SyntaxTokenType::identifier)
            nameTokens.push_back (Token { token.start, token.end, token.type, -1, 0 });
    }

    return nameTokens;
}

```
```isDeclaration
static bool isDeclaration (std::string_view source, const Tokens& tokens, int start, int qualifierStart)
{
    static constexpr LookupTable<int, bool, Chars::greaterThan + 1> declaratorBytes {
        {
:::[list]:::
        }
    };

    if (qualifierStart - 1 >= start)
    {
        const auto& previous { tokens.at (qualifierStart - 1) };

        return previous.type == map::SyntaxTokenType::identifier or previous.type == map::SyntaxTokenType::keyword
               or (previous.type == map::SyntaxTokenType::punctuation and declaratorBytes[source.at (previous.start)]);
    }

    return false;
}

```
```isNamedParameter
static bool isNamedParameter (std::string_view source, const Tokens& tokens, int start, int boundary)
{
    return boundary - 1 >= start
           and tokens.at (boundary - 1).type == map::SyntaxTokenType::identifier
           and std::any_of (tokens.begin() + start, tokens.begin() + getQualifierStart (source, tokens, start, boundary - 1),
                            [] (const Token& token)
                            { return not isKeyword (token, map::CppKeyword::tokenConst) and not isKeyword (token, map::CppKeyword::tokenVolatile); });
}

```
```isConstructor
static bool isConstructor (std::string_view source, const Element& scope, const Tokens& tokens, int qualifierStart, int namePosition, bool hasTilde)
{
    const auto scopeType { getScopeType (scope) };
    const auto& name { tokens.at (namePosition) };

    if (scopeType == map::SyntaxTokenType::classToken)
        return not hasTilde and isSameName (source, scope.name.back(), name);

    if (scopeType == map::SyntaxTokenType::namespaceToken)
        return not hasTilde and namePosition - qualifierLength >= qualifierStart and isSameName (source, tokens.at (namePosition - qualifierLength), name);

    return false;
}

```
```isDestructor
static bool isDestructor (std::string_view source, const Element& scope, const Tokens& tokens, int qualifierStart, int namePosition, bool hasTilde)
{
    const auto scopeType { getScopeType (scope) };
    const auto& name { tokens.at (namePosition) };

    if (hasTilde and scopeType == map::SyntaxTokenType::classToken)
        return true;

    if (hasTilde and scopeType == map::SyntaxTokenType::namespaceToken)
        return namePosition - qualifierLength - 1 >= qualifierStart and isSameName (source, tokens.at (namePosition - qualifierLength - 1), name);

    return false;
}

```
```getDeclarationType
static int getDeclarationType (std::string_view source, const Element& scope, const Tokens& tokens, int start, int boundary, int qualifierStart, int namePosition, bool isFunctionShape)
{
    const auto scopeType { scope.type };
    const bool hasTilde { namePosition - 1 >= qualifierStart and isPunctuation (source, tokens.at (namePosition - 1), Chars::tilde) };

    if (isFunctionShape and isConstructor (source, scope, tokens, qualifierStart, namePosition, hasTilde)) return map::SyntaxTokenType::constructor;
    if (isFunctionShape and isDestructor (source, scope, tokens, qualifierStart, namePosition, hasTilde)) return map::SyntaxTokenType::destructor;
    if (isFunctionShape and qualifierStart < namePosition and scopeType == map::SyntaxTokenType::namespaceToken) return map::SyntaxTokenType::instanceMethod;

    static constexpr LookupTable<int, std::array<int, 4>, map::SyntaxTokenType::macro + 1> declarationTypes {
        {
:::[list]:::
        }
    };

    const bool hasStaticKeyword { std::any_of (tokens.begin() + start, tokens.begin() + boundary, [] (const Token& token) { return isKeyword (token, map::CppKeyword::tokenStatic); }) };
    const auto [functionType, staticFunctionType, variableType, staticVariableType] { declarationTypes[scopeType] };

    return isFunctionShape ? (hasStaticKeyword ? staticFunctionType : functionType)
                           : (hasStaticKeyword ? staticVariableType : variableType);
}

```
```addDeclarators
static void addDeclarators (CLanguageDocument& document, int scope, int element, const Tokens& tokens, int start, int end, int type, int candidateStart)
{
    const auto source { document.source };
    auto declarator { element };
    int depth { 0 };
    int referenceStart { start };

    for (int index { start }; index < end; ++index)
    {
        if (depth == 0 and isPunctuation (source, tokens.at (index), Chars::comma))
        {
            int nameIndex { index + 1 };

            while (nameIndex < end and (isPunctuation (source, tokens.at (nameIndex), Chars::asterisk)
                                        or isPunctuation (source, tokens.at (nameIndex), Chars::ampersand)))
                ++nameIndex;

            if (nameIndex < end and tokens.at (nameIndex).type == map::SyntaxTokenType::identifier)
            {
                addReferences (document, getReferenceOwner (document, scope, declarator), tokens, referenceStart, nameIndex, map::SyntaxTokenType::reference);
                declarator = addElement (document, scope, getNameTokens (tokens, nameIndex, nameIndex), type);
                addComment (document, declarator, tokens, candidateStart);
                referenceStart = nameIndex + 1;
            }
        }

        depth += getDepthChange (source, tokens.at (index));
    }

    addReferences (document, getReferenceOwner (document, scope, declarator), tokens, referenceStart, end, map::SyntaxTokenType::reference);
}

```
```addParameter
static Token addParameter (CLanguageDocument& document, int function, const Tokens& tokens, int start, int end)
{
    const auto boundary { getBoundary (document.source, tokens, start, end) };

    if (isNamedParameter (document.source, tokens, start, boundary))
    {
        const auto& name { tokens.at (boundary - 1) };

        addDeclarationCandidate (document, function, tokens, start, end);
        return Token { name.start, name.end, map::SyntaxTokenType::variable, -1, 0 };
    }

    const auto lastPosition { boundary > start ? boundary - 1 : end - 1 };

    addReferences (document, function, tokens, start, end, map::SyntaxTokenType::reference);
    return Token { tokens.at (start).start, tokens.at (lastPosition).end, map::SyntaxTokenType::variable, -1, 0 };
}

```
```addParameters
static void addParameters (CLanguageDocument& document, int function, const Tokens& tokens, int open, int close)
{
    const auto source { document.source };
    int depth { 0 };
    int partStart { open + 1 };
    Tokens parameters;

    for (int index { open + 1 }; index < close; ++index)
    {
        if (depth == 0 and isPunctuation (source, tokens.at (index), Chars::comma))
        {
            if (partStart < index)
                parameters.push_back (addParameter (document, function, tokens, partStart, index));

            partStart = index + 1;
        }

        depth += getDepthChange (source, tokens.at (index));
    }

    if (partStart < close)
        parameters.push_back (addParameter (document, function, tokens, partStart, close));

    document.callbacks.addParameters (document.callbacks.context, function, parameters.data(), static_cast<int> (parameters.size()));
}

```
```addElement
static int addElement (CLanguageDocument& document, int scope, Tokens nameTokens, int type)
{
    const auto element { document.callbacks.addElement (document.callbacks.context, scope, type, nameTokens.data(), static_cast<int> (nameTokens.size())) };

    document.elements.push_back (Element { scope, type, std::move (nameTokens), {}, false });
    document.elements.at (scope).children.push_back (element);
    return element;
}

```
```addComment
static void addComment (CLanguageDocument& document, int element, const Tokens& tokens, int candidateStart)
{
    const auto statementStart { getStatementStart (document.source, tokens, candidateStart) };

    const auto previousEnd { statementStart > 0 ? tokens.at (statementStart - 1).end : 0 };
    const auto isBefore { [] (const Token& token, int position) { return token.start < position; } };
    Tokens commentTokens;

    std::for_each (std::lower_bound (document.tokens.begin(), document.tokens.end(), previousEnd, isBefore),
                   std::lower_bound (document.tokens.begin(), document.tokens.end(), tokens.at (statementStart).start, isBefore),
                   [&commentTokens] (const Token& token) { commentTokens.push_back (Token { token.start, token.end, token.type, -1, 0 }); });

    if (not commentTokens.empty())
        document.callbacks.addComment (document.callbacks.context, element, commentTokens.data(), static_cast<int> (commentTokens.size()));
}

```
```addReferences
static void addReferences (CLanguageDocument& document, int owner, const Tokens& tokens, int start, int end, int type)
{
    const auto source { document.source };

    for (int index { start }; index < end; ++index)
    {
        if (tokens.at (index).type == map::SyntaxTokenType::identifier)
        {
            const auto qualifierStart { index };

            while (index + qualifierLength < end
                   and isPunctuation (source, tokens.at (index + 1), Chars::colon)
                   and isPunctuation (source, tokens.at (index + 2), Chars::colon)
                   and tokens.at (index + qualifierLength).type == map::SyntaxTokenType::identifier)
                index += qualifierLength;

            const bool isCall { type == map::SyntaxTokenType::reference and index + 1 < static_cast<int> (tokens.size())
                                and isPunctuation (source, tokens.at (index + 1), Chars::openParen) };
            const auto reference { addElement (document, owner, getNameTokens (tokens, qualifierStart, index), isCall ? map::SyntaxTokenType::call : type) };

            if (isMemberAccess (source, tokens, qualifierStart))
            {
                document.elements.at (reference).isMember = true;
                document.callbacks.addMember (document.callbacks.context, reference);
            }
        }
    }
}

```
```addLocalLinks
static void addLocalLinks (CLanguageDocument& document, int scope)
{
    for (const auto element : document.elements.at (scope).children)
    {
        if (isFunctionScope (document.elements.at (element)))
        {
            for (const auto reference : document.elements.at (element).children)
            {
                if (isLocalReference (document.elements.at (reference)))
                    addLinkEndpoints (document, reference, getLocalDeclarations (document, element, document.elements.at (reference).name.back()));
            }
        }

        addLocalLinks (document, element);
    }
}

```
```getLocalDeclarations
static Elements getLocalDeclarations (const CLanguageDocument& document, int function, const Token& name)
{
    Elements declarations;

    for (const auto declaration : document.elements.at (function).children)
    {
        const auto type { document.elements.at (declaration).type };

        if (isSameName (document.source, document.elements.at (declaration).name.back(), name) and (type == map::SyntaxTokenType::variable or type == map::SyntaxTokenType::staticVariable))
            declarations.push_back (declaration);
    }

    return declarations;
}

```
```addLinkEndpoints
static void addLinkEndpoints (CLanguageDocument& document, int reference, const Elements& targets)
{
    for (const auto target : targets)
        document.callbacks.addLinkEndpoints (document.callbacks.context, reference, target);
}

