```export
#if defined (_WIN32)
extern "C" __declspec (dllexport) const void* ling_get_language (const char* name);
#else
extern "C" __attribute__ ((visibility ("default"))) const void* ling_get_language (const char* name);
#endif

extern "C" const void* ling_get_language (const char* name)
{
    static const ling::TextMap languageEntries {
        { LanguageEntry::build, reinterpret_cast<const void*> (&CLanguageDocument::build) },
        { LanguageEntry::index, reinterpret_cast<const void*> (&CLanguageDocument::index) },
        { LanguageEntry::units, reinterpret_cast<const void*> (&CLanguageDocument::units) },
        { LanguageEntry::code, code.begin() },
        { LanguageEntry::commentOpen, Chars::cssCommentOpen },
        { LanguageEntry::commentClose, Chars::cssCommentClose },
        { LanguageEntry::lineCommentOpen, Chars::doubleSlash },
        { LanguageEntry::escape, &Chars::backslash },
        { LanguageEntry::rawStringOpen, Chars::rawStringOpen },
        { LanguageEntry::keywords, keywords },
        { LanguageEntry::roles, roles.begin() },
        { LanguageEntry::symbolTypes, symbolTypes.begin() },
        { LanguageEntry::completionTypes, completionTypes.begin() },
        { LanguageEntry::semanticTokenTypes, semanticTokenTypes },
        { LanguageEntry::semanticTokenModifiers, semanticTokenModifiers },
        { LanguageEntry::semanticTypes, semanticTypes.begin() },
        { LanguageEntry::semanticModifiers, semanticModifiers.begin() },
        { LanguageEntry::extensionPairs, extensionPairs }
    };

    return languageEntries.contains (name) ? languageEntries.getAddress (name) : nullptr;
}

