```getHoverWord
static std::string_view getHoverWord (const LibClang& libclang, Cursor cursor)
{
    static const ling::AddressTable hoverWords {
        {
:::[list]:::
        }
    };
    static const ling::AddressTable hoverStaticWords {
        {
:::[list]:::
        }
    };

    const int hoverCursorType { getHoverCursorType (libclang, cursor) };
    const bool isStaticFunction { hoverCursorType == static_cast<int> (CursorType::cxxMethod) and libclang.isStaticMethod (cursor) != 0 };
    const bool isStaticVariable { hoverCursorType == static_cast<int> (CursorType::variableDeclaration) and static_cast<HoverScope> (hoverScopes[libclang.getCursorKind (libclang.getCursorSemanticParent (cursor))]) == HoverScope::record };

    return isStaticFunction or isStaticVariable ? static_cast<const char*> (hoverStaticWords[hoverCursorType]) : static_cast<const char*> (hoverWords[hoverCursorType]);
}

```
```getHoverOwnerName
static std::string getHoverOwnerName (const LibClang& libclang, Cursor owner)
{
    std::string name;

    if (libclang.isAnonymous (owner) == 0)
        name = getText (libclang, libclang.getCursorSpelling (owner));
    else if (owner.type != CursorType::enumerationDeclaration)
        name = std::string (HoverLabel::anonymous) + static_cast<char> (Chars::space) + std::string (getHoverWord (libclang, owner)) + HoverLabel::anonymousClose;

    return name;
}

```
```getHoverScope
static std::string getHoverScope (const LibClang& libclang, Cursor cursor)
{
    const char space { static_cast<char> (Chars::space) };
    ling::Texts ownerNames;
    ling::Texts namespaceNames;
    const auto getJoined { [] (const ling::Texts& names)
    {
        std::string joined;

        for (int position { names.size() - 1 }; position >= 0; --position)
        {
            const auto name { names.get (position) };

            if (not name.empty()) joined += std::string (joined.empty() ? std::string_view {} : std::string_view (HoverLabel::scopeSeparator)) + std::string (name);
        }

        return joined;
    } };

    for (auto parent { libclang.getCursorSemanticParent (cursor) }; libclang.isInvalid (static_cast<int> (parent.type)) == 0 and parent.type != CursorType::translationUnit; parent = libclang.getCursorSemanticParent (parent))
    {
        if (parent.type == CursorType::cursorNamespace) { if (libclang.isInlineNamespace (parent) == 0) namespaceNames.add (getText (libclang, libclang.getCursorSpelling (parent))); }
        else if (static_cast<HoverScope> (hoverScopes[static_cast<int> (parent.type)]) != HoverScope::none) ownerNames.add (getHoverOwnerName (libclang, parent));
    }

    const auto owners { getJoined (ownerNames) };
    const auto namespaces { getJoined (namespaceNames) };

    if (not owners.empty()) return std::string (HoverLabel::scope) + space + owners;
    if (not namespaces.empty()) return std::string (HoverLabel::namespaceScope) + space + namespaces;
    return {};
}

