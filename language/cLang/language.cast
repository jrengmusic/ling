```getHoverPassing
static std::string getHoverPassing (const LibClang& libclang, Cursor parameter, Cursor inner)
{
    static const ling::LookupTable typeFamilies {
        {
:::[list]:::
        }
    };

    const char space { static_cast<char> (Chars::space) };
    const auto parameterType { libclang.getCursorType (parameter) };
    const auto name { getText (libclang, libclang.getCursorSpelling (parameter)) };
    const auto innerType { getBareType (libclang, libclang.getCursorType (inner)) };
    const auto bareType { getBareType (libclang, parameterType) };
    const int family { typeFamilies[static_cast<int> (bareType.type)] };
    const bool isConverted { libclang.equalTypes (innerType, bareType) == 0 and not (family != 0 and family == typeFamilies[static_cast<int> (innerType.type)]) };
    const bool isValue { isConverted or not (parameterType.type == ValueCategory::lValueReference or parameterType.type == ValueCategory::rValueReference) };
    const auto reference { isValue ? std::string() : std::string (HoverLabel::passedBy) + space + (libclang.isConstQualifiedType (libclang.getPointeeType (parameterType)) != 0 ? std::string (HoverLabel::passedConst) + space : std::string()) + HoverLabel::passedReference + space };
    const auto subject { name.empty() ? (isValue ? std::string (HoverLabel::passedByValue) : std::string()) : std::string (HoverLabel::passedAs) + space + name };
    const auto conversion { isConverted ? space + std::string (HoverLabel::convertedTo) + space + getHoverType (libclang, parameterType, false) + HoverLabel::convertedClose : std::string() };

    return std::string (HoverLabel::passed) + space + reference + subject + conversion;
}

