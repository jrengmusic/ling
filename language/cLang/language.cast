```isTokenByte
static bool isTokenByte (const LibClang& libclang, TranslationUnit translationUnit, SourceToken token, int byte)
{
    const auto spelling { getText (libclang, libclang.getTokenSpelling (translationUnit, token)) };

    return spelling.size() == 1 and static_cast<int> (spelling.at (0)) == byte;
}

