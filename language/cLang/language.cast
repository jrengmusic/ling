```isScopeOperatorBefore
static bool isScopeOperatorBefore (std::string_view contents, int position)
{
    return position >= 2 and position <= static_cast<int> (contents.size()) and static_cast<int> (contents.at (position - 1)) == Chars::colon and static_cast<int> (contents.at (position - 2)) == Chars::colon;
}

