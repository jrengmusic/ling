```getEnumeratorName
static std::string getEnumeratorName (IndexContext& context, Cursor enumeration, long long value)
{
    std::string enumeratorName;

    applyToChildren (context.libclang, enumeration, [&context, &enumeratorName, value] (Cursor child)
    {
        if (child.type == CursorType::enumerationConstantDeclaration and context.libclang.getEnumConstantDeclValue (child) == value)
        {
            enumeratorName = getText (context.libclang, context.libclang.getCursorSpelling (child));
            return ChildVisitResult::visitBreak;
        }

        return ChildVisitResult::visitContinue;
    });

    return enumeratorName;
}

