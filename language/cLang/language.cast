```addUnitRecords
static void addUnitRecords (const LibClang& libclang, IndexContext& context, const ling::Pointers& commandLine, const char* directory, TranslationUnit translationUnit)
{
    addSearchDirectories (context, commandLine, directory);
    addMacroSymbols (libclang, context, translationUnit);
    addIncludes (libclang, context, translationUnit);
    addCallPassings (libclang, context, translationUnit);
    addHovers (libclang, context);
    addChosenSymbols (libclang, context);
    addCompletions (context);
    addDiagnostics (libclang, context, translationUnit);
}

