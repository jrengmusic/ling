```getParameterLabel
static std::string getParameterLabel (IndexContext& context, Cursor parameter, Cursor argument)
{
    const auto& libclang { context.libclang };
    const auto trimFront { [] (std::string_view text, bool (*isTrimmed) (char))
    {
        while (not text.empty() and isTrimmed (text.front()))
            text.remove_prefix (1);

        return text;
    } };
    const auto trimBack { [] (std::string_view text, bool (*isTrimmed) (char))
    {
        while (not text.empty() and isTrimmed (text.back()))
            text.remove_suffix (1);

        return text;
    } };
    const auto endsWith { [] (std::string_view text, std::string_view suffix)
    {
        return text.size() >= suffix.size() and text.compare (text.size() - suffix.size(), suffix.size(), suffix) == 0;
    } };
    const auto isWhitespace { [] (char character) { return std::isspace (static_cast<unsigned char> (character)) != 0; } };
    const auto isIgnored { [] (char character) { return static_cast<int> (character) == Chars::space or static_cast<int> (character) == Chars::equals or static_cast<int> (character) == Chars::dot; } };
    const auto parameterName { getText (libclang, libclang.getCursorSpelling (parameter)) };
    const std::string_view name { getStrippedName (parameterName) };
    const auto extent { libclang.getCursorExtent (argument) };
    const auto parameterType { libclang.getCursorType (parameter) };
    SourceFile file { nullptr };
    SourceFile endFile { nullptr };
    unsigned offset { 0 };
    unsigned endOffset { 0 };
    bool isSpelledName { false };
    bool isNamedByComment { false };

    libclang.getSpellingLocation (libclang.getRangeStart (extent), &file, nullptr, nullptr, &offset);
    libclang.getSpellingLocation (libclang.getRangeEnd (extent), &endFile, nullptr, nullptr, &endOffset);

    if (file != nullptr and not name.empty())
    {
        context.addPreprocessedFile (file, libclang.getCursorTranslationUnit (argument));

        const auto contents { context.getFileContents (file) };

        if (file == endFile and endOffset > offset and endOffset <= contents.size())
        {
            const auto trimmed { trimBack (trimFront (contents.substr (offset, endOffset - offset), isWhitespace), isWhitespace) };

            isSpelledName = trimmed.compare (name) == 0;
        }

        auto prefix { trimBack (contents.substr (0, std::min (static_cast<std::size_t> (offset), contents.size())), isWhitespace) };

        if (endsWith (prefix, Chars::cssCommentClose))
        {
            prefix = trimBack (prefix.substr (0, prefix.size() - std::string_view (Chars::cssCommentClose).size()), isIgnored);

            if (endsWith (prefix, name))
            {
                prefix = trimBack (prefix.substr (0, prefix.size() - name.size()), isIgnored);
                isNamedByComment = endsWith (prefix, Chars::cssCommentOpen);
            }
        }
    }

    const bool isReference { parameterType.type == ValueCategory::lValueReference and libclang.isConstQualifiedType (libclang.getPointeeType (parameterType)) == 0 };
    const bool hasName { not name.empty() and not isSpelledName and not isNamedByComment };

    return isReference or hasName ? std::string (isReference ? std::string_view (InlayHintLabel::reference) : std::string_view {}) + std::string (hasName ? name : std::string_view {}) + InlayHintLabel::parameterSuffix : std::string();
}

```
```addParameterHints
static void addParameterHints (const LibClang& libclang, IndexContext& context, Cursor call, Cursor callee, std::string_view name)
{
    const auto getEndOffset { [&libclang] (Cursor cursor)
    {
        unsigned offset { 0 };

        libclang.getSpellingLocation (libclang.getRangeEnd (libclang.getCursorExtent (cursor)), nullptr, nullptr, nullptr, &offset);

        return offset;
    } };
    const int parameterCount { libclang.getNumArguments (callee) };
    const auto parameterName { parameterCount == 1 ? getText (libclang, libclang.getCursorSpelling (libclang.getArgument (callee, 0))) : std::string {} };
    const std::string_view operatorName { HoverLabel::operatorName };
    const std::string_view setterPrefix { InlayHintLabel::setterPrefix };
    const int objectArgumentCount { static_cast<int> (name.compare (HoverLabel::callOperator) == 0) };
    auto parent { libclang.getCursorSemanticParent (callee) };

    while (parent.type == CursorType::cursorNamespace and libclang.isInlineNamespace (parent) != 0)
        parent = libclang.getCursorSemanticParent (parent);

    const bool isStandard { parent.type == CursorType::cursorNamespace and getText (libclang, libclang.getCursorSpelling (parent)).compare (InlayHintLabel::standardNamespace) == 0 };
    const bool isBuiltin { isStandard and getSimpleBuiltins().contains (name) };
    const bool isOperator { name.compare (0, operatorName.size(), operatorName) == 0 and name.compare (HoverLabel::callOperator) != 0 };
    const bool isCopyOrMove { libclang.isCopyConstructor (callee) != 0 or libclang.isMoveConstructor (callee) != 0 };
    const bool isSetter { parameterCount == 1 and name.size() >= setterPrefix.size() and isSameText (name.substr (0, setterPrefix.size()), setterPrefix) and isSameText (getStrippedName (name.substr (setterPrefix.size())), getStrippedName (parameterName)) };
    const bool isHinted { not (isOperator or isCopyOrMove or isBuiltin or isSetter) };
    const int count { std::min (libclang.getNumArguments (call) - objectArgumentCount, parameterCount) };
    const auto callEndOffset { getEndOffset (call) };

    for (int index { 0 }; isHinted and index < count and libclang.getArgument (call, static_cast<unsigned> (index + objectArgumentCount)).type != CursorType::packExpansionExpression; ++index)
    {
        const auto argument { libclang.getArgument (call, static_cast<unsigned> (index + objectArgumentCount)) };
        const auto label { getParameterLabel (context, libclang.getArgument (callee, static_cast<unsigned> (index)), argument) };

        if (not label.empty() and getEndOffset (argument) != callEndOffset)
            context.addInlayHint (argument, label, ToolchainValue::parameterHintType, false, true);
    }
}

```
```getClosingIndex
static unsigned getClosingIndex (const LibClang& libclang, TranslationUnit translationUnit, SourceToken* tokens, unsigned tokenCount, unsigned open, int openByte, int closeByte)
{
    assert (open < tokenCount);

    int depth { 0 };
    unsigned index { open };

    do
    {
        depth += static_cast<int> (isTokenByte (libclang, translationUnit, tokens[index], openByte)) - static_cast<int> (isTokenByte (libclang, translationUnit, tokens[index], closeByte));
        ++index;
    }
    while (depth > 0 and index < tokenCount);

    return index - 1;
}

