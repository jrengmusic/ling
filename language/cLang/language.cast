```getCallOperator
static Cursor getCallOperator (IndexContext& context, Cursor lambda)
{
    Cursor callOperator {};

    applyToChildren (context.libclang, context.libclang.getTypeDeclaration (context.libclang.getCursorType (lambda)), [&context, &callOperator] (Cursor child)
    {
        if (child.type == CursorType::cxxMethod and getText (context.libclang, context.libclang.getCursorSpelling (child)).compare (HoverLabel::callOperator) == 0)
        {
            callOperator = child;
            return ChildVisitResult::visitBreak;
        }

        return ChildVisitResult::visitContinue;
    });

    return callOperator;
}

