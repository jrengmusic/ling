```addCompletionRow
static void addCompletionRow (IndexContext& context, unsigned long long scope, unsigned long long symbol, const std::string& name, const std::string& insertText, int type, int flags, SourceFile file)
{
    const auto row { static_cast<unsigned long long> (context.completionRows.size() / completionStride) };

    context.completionRows.add (scope);
    context.completionRows.add (symbol);
    context.completionRows.add (ling::HalfWords::pack (context.texts.add (name), context.texts.add (insertText)));
    context.completionRows.add (ling::HalfWords::pack (type, flags));
    context.completionRows.add (getFileWord (file));
    context.completionsByScope.add (scope, row);
}

```
```storeCompletion
static void storeCompletion (IndexContext& context, const IndexDeclarationInfo* declaration, Cursor parent, int type, SourceFile file)
{
    const auto& libclang { context.libclang };
    const int flags { libclang.getCXXAccessSpecifier (declaration->cursor) == accessPrivate ? completionPrivateFlag : 0 };
    const auto symbol { ling::Wyhash::hashBytes (declaration->entityInfo->USR, std::strlen (declaration->entityInfo->USR)) };

    addCompletionRow (context, getScopeSymbol (libclang, parent), symbol, declaration->entityInfo->name, getInsertText (libclang, declaration->cursor, declaration->entityInfo->name, type), type, flags, file);
}

```
```storeEnumeratorScope
static void storeEnumeratorScope (IndexContext& context, const IndexDeclarationInfo* declaration, Cursor enumeration, int type, SourceFile file)
{
    const auto enclosing { context.libclang.getCursorLexicalParent (enumeration) };

    if (context.libclang.isScopedEnum (enumeration) == 0 and completionScopeTypes[static_cast<int> (enclosing.type)] != 0)
        storeCompletion (context, declaration, enclosing, type, file);
}

