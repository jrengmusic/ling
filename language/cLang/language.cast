```addOutputs
static void addOutputs (const ling::Texts& texts, const ling::Words& unitRows, ling::TextMap& outputs)
{
    for (int unit { 0 }; unit < unitRows.size() / unitStride; ++unit)
    {
        const auto outputText { ling::HalfWords::unpackFirst (unitRows.at (unit * unitStride + 1)) };

        if (outputText != invalidPosition)
            outputs.add (texts.get (outputText), static_cast<unsigned long long> (unit));
    }
}

