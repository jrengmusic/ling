static std::optional<std::string> getCommandOutput (const std::string& command, const char* workingDirectory)
{
    auto output { ling::Subprocess::getOutput (command, workingDirectory) };

    if (output.has_value())
        output->erase (output->find_last_not_of (static_cast<char> (Chars::newline)) + 1);

    return output;
}

