struct LibClang
{
    explicit LibClang (const std::string& path)
        : library { path.c_str() }
:::[list]:::
    {
    }

    LibClang (const LibClang&) = delete;
    LibClang& operator= (const LibClang&) = delete;

    bool isLoaded() const
    {
        const std::initializer_list<const void*> symbols {
:::[list]:::
        };

        return std::all_of (symbols.begin(), symbols.end(), [] (const void* symbol) { return symbol != nullptr; });
    }

    ling::DynamicLibrary library;
:::[list]:::
};

struct IndexSession
{
    void setLoaded (const std::string& path, int excludeDeclarationsFromPCH, int displayDiagnostics)
    {
        if (libclang == nullptr or libraryPath.compare (path) != 0)
        {
            static std::mutex initMutex;
            const std::scoped_lock<std::mutex> lock { initMutex };

            action.reset();
            indexHandle.reset();
            libclang.reset();
            libraryPath = path;

            auto candidate { std::make_unique<LibClang> (path) };

            if (candidate->isLoaded())
            {
                indexHandle = { candidate->createIndex (excludeDeclarationsFromPCH, displayDiagnostics), candidate->disposeIndex };
                action = { indexHandle != nullptr ? candidate->createIndexAction (indexHandle.get()) : nullptr, candidate->disposeIndexAction };
                libclang = std::move (candidate);
            }
        }
    }

    bool isLoaded() const noexcept
    {
        return libclang != nullptr and indexHandle != nullptr and action != nullptr;
    }

    std::string libraryPath;
    std::unique_ptr<LibClang> libclang;
    std::unique_ptr<void, decltype (LibClang::disposeIndex)> indexHandle { nullptr, nullptr };
    std::unique_ptr<void, decltype (LibClang::disposeIndexAction)> action { nullptr, nullptr };
};

static IndexSession& getIndexSession (const std::string& path, int excludeDeclarationsFromPCH, int displayDiagnostics)
{
    thread_local IndexSession session;

    session.setLoaded (path, excludeDeclarationsFromPCH, displayDiagnostics);
    return session;
}

