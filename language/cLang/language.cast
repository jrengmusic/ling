```getDefinitionRange
static SourceRange getDefinitionRange (IndexContext& context, Cursor cursor)
{
    static const ling::LookupTable scopeDefinitionTypes {
        {
:::[list]:::
        }
    };

    const auto& libclang { context.libclang };
    const auto translationUnit { libclang.getCursorTranslationUnit (cursor) };
    const auto extent { libclang.getCursorExtent (cursor) };
    SourceFile extentFile { nullptr };
    unsigned extentStart { 0 };

    libclang.getExpansionLocation (libclang.getRangeStart (extent), &extentFile, nullptr, nullptr, &extentStart);

    const bool isScopeDefinition { scopeDefinitionTypes[static_cast<int> (cursor.type)] != 0 };
    const bool isLongInitializer { cursor.type == CursorType::variableDeclaration and getInitializerTokenCount (context, cursor) > static_cast<unsigned> (ToolchainValue::initializerTokenLimit) };
    const bool isObjCInterface { cursor.type == CursorType::objCInterfaceDeclaration };
    SourceLocation bodyStart {};
    bool hasBody { false };

    applyToChildren (libclang, cursor, [&libclang, extentFile, extentStart, &bodyStart, &hasBody] (Cursor child)
    {
        if (child.type == CursorType::compoundStatement)
        {
            const auto start { libclang.getRangeStart (libclang.getCursorExtent (child)) };
            SourceFile bodyFile { nullptr };
            unsigned bodyOffset { 0 };

            libclang.getExpansionLocation (start, &bodyFile, nullptr, nullptr, &bodyOffset);

            if (bodyFile == extentFile and bodyOffset > extentStart)
            {
                bodyStart = start;
                hasBody = true;
            }
        }

        return ChildVisitResult::visitContinue;
    });

    SourceRange definitionRange { extent };

    if (hasBody or isScopeDefinition or isLongInitializer or isObjCInterface)
    {
        SourceToken* tokens { nullptr };
        unsigned tokenCount { 0 };

        libclang.tokenize (translationUnit, hasBody ? libclang.getRange (libclang.getRangeStart (extent), bodyStart) : extent, &tokens, &tokenCount);

        unsigned cutIndex { tokenCount };

        if (isObjCInterface)
        {
            const auto nameStart { libclang.getRangeStart (libclang.getSpellingNameRange (cursor, 0, 0)) };
            unsigned index { 0 };

            while (index < tokenCount and libclang.equalLocations (libclang.getRangeStart (libclang.getTokenExtent (translationUnit, tokens[index])), nameStart) == 0)
                ++index;

            ++index;

            while (index < tokenCount and (isTokenByte (libclang, translationUnit, tokens[index], Chars::lessThan) or isTokenByte (libclang, translationUnit, tokens[index], Chars::colon)))
            {
                if (isTokenByte (libclang, translationUnit, tokens[index], Chars::colon))
                    index += 2;
                else
                    index = getClosingIndex (libclang, translationUnit, tokens, tokenCount, index, Chars::lessThan, Chars::greaterThan) + 1;
            }

            cutIndex = index;
        }
        else if (hasBody)
        {
            cutIndex = tokenCount > 0 and libclang.equalLocations (libclang.getRangeStart (libclang.getTokenExtent (translationUnit, tokens[tokenCount - 1])), bodyStart) != 0 ? tokenCount - 1 : tokenCount;
        }
        else
        {
            for (unsigned index { 0 }; index < tokenCount and cutIndex == tokenCount; ++index)
                if (isTokenByte (libclang, translationUnit, tokens[index], Chars::openBrace) or (isLongInitializer and isTokenByte (libclang, translationUnit, tokens[index], Chars::equals)))
                    cutIndex = index;
        }

        assert (cutIndex > 0 or cutIndex == tokenCount);

        if (cutIndex < tokenCount or (hasBody and tokenCount > 0))
        {
            const auto rangeEnd { libclang.getRangeEnd (libclang.getTokenExtent (translationUnit, tokens[cutIndex - 1])) };
            SourceFile endFile { nullptr };

            libclang.getExpansionLocation (rangeEnd, &endFile, nullptr, nullptr, nullptr);

            if (endFile == extentFile)
                definitionRange = libclang.getRange (libclang.getRangeStart (extent), rangeEnd);
        }

        libclang.disposeTokens (translationUnit, tokens, tokenCount);
    }

    return definitionRange;
}

