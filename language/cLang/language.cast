```onInclusion
static void onInclusion (SourceFile includedFile, SourceLocation* inclusionStack, unsigned includeLength, ClientData clientData)
{
    auto& context { *static_cast<IndexContext*> (clientData) };

    if (includeLength > 0)
    {
        SourceFile includer { nullptr };
        unsigned offset { 0 };

        context.libclang.getFileLocation (*inclusionStack, &includer, nullptr, nullptr, &offset);

        if (includer != nullptr)
        {
            const auto contents { context.getFileContents (includer) };
            const std::string_view window { contents.substr (std::min (static_cast<std::size_t> (offset), contents.size()), ToolchainValue::sniffByteCount) };
            const bool isAngled { not window.empty() and window.front() == Chars::lessThan };
            const auto closing { window.find (isAngled ? Chars::greaterThan : Chars::doubleQuote, 1) };
            const int spelledText { context.texts.add (closing == std::string::npos ? std::string_view {} : window.substr (1, closing - 1)) };

            context.includers.set (getFileWord (includedFile), getFileWord (includer));
            context.includeDirectives.add (getFileWord (includer), getFileWord (includedFile));
            context.includeDirectives.add (getFileWord (includer), ling::HalfWords::pack (spelledText, isAngled ? 1 : 0));
        }
    }
}

