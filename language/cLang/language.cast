```getText
static std::string getText (const LibClang& libclang, OwnedString text)
{
    const char* characters { libclang.getCString (text) };
    std::string result (characters != nullptr ? std::string_view (characters) : std::string_view {});

    libclang.disposeString (text);

    return result;
}

