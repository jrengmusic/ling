```getIndexerCallbacks
static IndexerCallbacks getIndexerCallbacks()
{
    return {
        [] (ClientData clientData, void*)
        {
            const auto& indexContext { *static_cast<IndexContext*> (clientData) };

            return indexContext.callbacks.shouldExit (indexContext.callbacks.context);
        },
        nullptr,
        [] (ClientData clientData, SourceFile mainFile, void*) -> IndexClientFile
        {
            auto& indexContext { *static_cast<IndexContext*> (clientData) };

            indexContext.addPreprocessedFile (mainFile);
            return nullptr;
        },
        [] (ClientData clientData, const IncludedFileInfo* includedFile) -> IndexClientFile
        {
            static_cast<IndexContext*> (clientData)->addPreprocessedFile (includedFile->file);
            return nullptr;
        },
        nullptr, nullptr, onDeclaration, onReference
    };
}

