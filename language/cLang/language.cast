```addTemplateParameterSymbols
static void addTemplateParameterSymbols (const LibClang& libclang, IndexContext& context, Cursor cursor)
{
    const auto parameter { libclang.getCursorReferenced (cursor) };
    const int type { templateParameterTypes[static_cast<int> (parameter.type)] };

    if (type != 0)
    {
        const int role { parameter.type == cursor.type ? LanguageRole::declaration | LanguageRole::definition : LanguageRole::reference };
        const auto usr { libclang.getCursorUSR (parameter) };
        const auto spelling { libclang.getCursorSpelling (parameter) };

        const auto record { context.addSymbol (libclang.getCursorLocation (cursor), libclang.getCString (usr), parameter, role, type, libclang.getCString (spelling), context.addHover (libclang.getCursorLocation (cursor), libclang.getCString (usr), parameter)) };
        addTypeDefinition (context, record, parameter);
        libclang.disposeString (spelling);
        libclang.disposeString (usr);
    }
}

