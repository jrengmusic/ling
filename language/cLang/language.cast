```isDirective
static bool isDirective (std::string_view line, std::string_view word)
{
    const auto hash { line.find_first_not_of (horizontalSpaces) };
    const auto start { hash != std::string_view::npos and line.at (hash) == Chars::hash ? line.find_first_not_of (horizontalSpaces, hash + 1) : std::string_view::npos };

    return start != std::string_view::npos and line.compare (start, word.size(), word) == 0;
}

