```reportOutline
static void reportOutline (IndexContext& context, const IndexDeclarationInfo* declaration, int type)
{
    static const ling::LookupTable outlineContainerTypes {
        {
:::[list]:::
        }
    };

    const auto& libclang { context.libclang };
    SourceFile file { nullptr };
    unsigned line { 0 };
    unsigned column { 0 };
    unsigned offset { 0 };
    unsigned endLine { 0 };
    unsigned endColumn { 0 };

    libclang.getSpellingLocation (libclang.indexLocSourceLocation (declaration->loc), &file, &line, &column, &offset);
    libclang.getSpellingLocation (libclang.getRangeEnd (libclang.getCursorExtent (declaration->cursor)), nullptr, &endLine, &endColumn, nullptr);

    context.addPreprocessedFile (file, context.translationUnit != nullptr ? context.translationUnit : libclang.getCursorTranslationUnit (declaration->cursor));
    const auto contents { context.getFileContents (file) };
    const auto qualifierLength { static_cast<int> (offset) - getOutlineQualifierStart (contents, static_cast<int> (offset)) };
    const auto nameLength { getOutlineNameLength (libclang, declaration->cursor, offset, declaration->entityInfo->name) };
    const auto path { libclang.getFileName (file) };
    const auto normalPath { getNormalPath (libclang.getCString (path)) };
    int index { invalidPosition };

    if (context.callbacks.addOutline != nullptr and nameLength > 0 and not context.isForeign (file) and context.keptRanges.isEmpty())
        index = context.callbacks.addOutline (context.callbacks.context, normalPath.c_str(), static_cast<int> (line), static_cast<int> (column), static_cast<int> (endLine), static_cast<int> (endColumn), nameLength, qualifierLength, getOutlineType (libclang, declaration->cursor, type), getOutlineParent (context, declaration));

    if (outlineContainerTypes[type] != 0)
        context.outlines.set (static_cast<unsigned long long> (libclang.hashCursor (declaration->cursor)), static_cast<unsigned long long> (index));

    libclang.disposeString (path);
}

```
```isNamedDeclaration
static bool isNamedDeclaration (const IndexDeclarationInfo* declaration)
{
    return declaration->entityInfo->name != nullptr and *declaration->entityInfo->name != Chars::nullCharacter;
}

```
```addOutline
static void addOutline (IndexContext& context, const IndexDeclarationInfo* declaration)
{
    SourceFile file { nullptr };
    const auto type { getEntityType (static_cast<int> (declaration->entityInfo->type)) };

    context.libclang.getSpellingLocation (context.libclang.indexLocSourceLocation (declaration->loc), &file, nullptr, nullptr, nullptr);

    if (file != nullptr and context.libclang.isInSystemHeader (context.libclang.indexLocSourceLocation (declaration->loc)) == 0 and (roles[type] & LanguageRole::declaration) != 0 and declaration->cursor.type != CursorType::parameterDeclaration and isNamedDeclaration (declaration) and isOutlineParent (context, declaration))
        reportOutline (context, declaration, type);
}

```
```isArrowOperator
static bool isArrowOperator (const LibClang& libclang, Cursor cursor)
{
    return cursor.type == CursorType::cxxMethod and not libclang.isStaticMethod (cursor) and getText (libclang, libclang.getCursorSpelling (cursor)).compare (HoverLabel::arrowOperator) == 0;
}

```
```hasArrowOperator
static bool hasArrowOperator (IndexContext& context, Cursor pattern)
{
    bool hasArrow { false };

    applyToChildren (context.libclang, pattern, [&context, &hasArrow] (Cursor child) { hasArrow = hasArrow or isArrowOperator (context.libclang, child); return ChildVisitResult::visitContinue; });

    return hasArrow;
}

```
```getSmartPointee
static ValueType getSmartPointee (IndexContext& context, ValueType type)
{
    const auto& libclang { context.libclang };
    const auto pattern { getTemplatePattern (context, libclang.getTypeDeclaration (type)) };

    return hasArrowOperator (context, pattern) and libclang.getNumTemplateArguments (type) > 0 ? libclang.getTemplateArgumentType (type, 0) : ValueType { ValueCategory::invalid, {} };
}

```
```reportTypeSymbol
static void reportTypeSymbol (IndexContext& context, int record, Cursor typeCursor)
{
    const auto& libclang { context.libclang };
    const auto usr { libclang.getCursorUSR (typeCursor) };
    const char* usrText { libclang.getCString (usr) };

    if (libclang.isInvalid (static_cast<int> (typeCursor.type)) == 0 and usrText != nullptr and *usrText != Chars::nullCharacter)
    {
        const auto row { record * recordStride + 5 };
        const auto start { ling::HalfWords::unpackFirst (context.recordRows.at (row)) };
        const auto count { ling::HalfWords::unpackSecond (context.recordRows.at (row)) };

        assert (start + count == context.typeSymbols.size());

        context.typeSymbols.add (context.getSymbolHash (usrText, typeCursor));
        context.recordRows.set (row, ling::HalfWords::pack (start, count + 1));
    }

    libclang.disposeString (usr);
}

```
```reportTypeOf
static void reportTypeOf (IndexContext& context, int record, ValueType type)
{
    static const ling::LookupTable indirectTypes {
        {
:::[list]:::
        }
    };

    const auto& libclang { context.libclang };
    const auto declaration { libclang.getTypeDeclaration (type) };
    const auto canonical { libclang.getCanonicalType (type) };

    if (indirectTypes[static_cast<int> (type.type)] != 0)
    {
        reportTypeOf (context, record, libclang.getPointeeType (type));
    }
    else if (libclang.isInvalid (static_cast<int> (declaration.type)) != 0 and canonical.type != type.type)
    {
        reportTypeOf (context, record, canonical);
    }
    else
    {
        const auto pointee { getSmartPointee (context, type) };

        reportTypeSymbol (context, record, getTemplatePattern (context, declaration));

        if (pointee.type != ValueCategory::invalid)
            reportTypeOf (context, record, pointee);
    }
}

```
```getDeclarationValueType
static ValueType getDeclarationValueType (const LibClang& libclang, Cursor cursor)
{
    if (cursor.type == CursorType::functionDeclaration or cursor.type == CursorType::cxxMethod)
        return libclang.getCursorResultType (cursor);

    return libclang.getCursorType (cursor);
}

```
```getMemberPattern
static Cursor getMemberPattern (IndexContext& context, Cursor parentPattern, Cursor member)
{
    const auto& libclang { context.libclang };
    Cursor pattern { member };

    applyToChildren (libclang, parentPattern, [&libclang, &pattern, member] (Cursor child)
    {
        if (child.type == member.type and libclang.equalLocations (libclang.getCursorLocation (child), libclang.getCursorLocation (member)) != 0)
        {
            pattern = child;
            return ChildVisitResult::visitBreak;
        }

        return ChildVisitResult::visitContinue;
    });

    return pattern;
}

```
```getTemplatePattern
static Cursor getTemplatePattern (IndexContext& context, Cursor cursor)
{
    const auto& libclang { context.libclang };
    const auto pattern { libclang.getSpecializedCursorTemplate (cursor) };
    const auto parentPattern { libclang.getSpecializedCursorTemplate (libclang.getCursorSemanticParent (cursor)) };

    if (libclang.isInvalid (static_cast<int> (pattern.type)) == 0)
        return pattern;

    if (libclang.isInvalid (static_cast<int> (parentPattern.type)) == 0)
        return getMemberPattern (context, parentPattern, cursor);

    return cursor;
}

```
```addTypeDefinition
static void addTypeDefinition (IndexContext& context, int record, Cursor cursor)
{
    static const ling::LookupTable typedDeclarationTypes {
        {
:::[list]:::
        }
    };
    static const ling::LookupTable selfTypeDeclarationTypes {
        {
:::[list]:::
        }
    };

    if (record != invalidPosition)
    {
        if (typedDeclarationTypes[static_cast<int> (cursor.type)] != 0)
            reportTypeOf (context, record, getDeclarationValueType (context.libclang, cursor));

        if (selfTypeDeclarationTypes[static_cast<int> (cursor.type)] != 0)
            reportTypeSymbol (context, record, getTemplatePattern (context, cursor));
    }
}

