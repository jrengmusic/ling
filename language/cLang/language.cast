```build
static int build (const char* source, int sourceSize, const LanguageToken* tokens, int tokenCount, const LanguageCallbacks& callbacks)
{
    CLanguageDocument document { std::string_view (source, static_cast<std::size_t> (sourceSize)), {}, callbacks, { Element { invalidPosition, map::SyntaxTokenType::namespaceToken, {}, {}, false } } };
    Tokens codeTokens;

    std::for_each (tokens, tokens + tokenCount,
                   [&document, &codeTokens] (const Token& token)
                   { (token.type == map::SyntaxTokenType::comment ? document.tokens : codeTokens).push_back (token); });

    addStatements (document, 0, codeTokens, 0, static_cast<int> (codeTokens.size()));
    addLocalLinks (document, 0);
    return static_cast<int> (document.elements.size());
}

