```onMacro
static ChildVisitResult onMacro (Cursor cursor, Cursor, ClientData clientData)
{
    auto& context { *static_cast<IndexContext*> (clientData) };
    const auto& libclang { context.libclang };

    if ((cursor.type == CursorType::macroDefinition or cursor.type == CursorType::macroExpansion) and context.isPreprocessed (libclang.getCursorLocation (cursor)))
    {
        const bool isDefinition { cursor.type == CursorType::macroDefinition };
        const auto hoverCursor { isDefinition ? cursor : libclang.getCursorReferenced (cursor) };
        const auto usr { libclang.getCursorUSR (hoverCursor) };
        const auto spelling { libclang.getCursorSpelling (cursor) };

        context.addSymbol (libclang.getCursorLocation (cursor), libclang.getCString (usr), hoverCursor, isDefinition ? LanguageRole::declaration : LanguageRole::reference, map::SyntaxTokenType::macro, libclang.getCString (spelling), context.addHover (libclang.getCursorLocation (cursor), libclang.getCString (usr), hoverCursor));
        addMacroCompletion (context, cursor);
        libclang.disposeString (spelling);
        libclang.disposeString (usr);
    }

    return ChildVisitResult::visitContinue;
}

```
