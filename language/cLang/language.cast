```onBinding
static ChildVisitResult onBinding (Cursor cursor, Cursor, ClientData clientData)
{
    auto& context { *static_cast<IndexContext*> (clientData) };
    const auto& libclang { context.libclang };

    if (cursor.type == CursorType::unexposedDeclaration)
    {
        const auto usr { libclang.getCursorUSR (cursor) };
        const auto spelling { libclang.getCursorSpelling (cursor) };

        const auto record { context.addSymbol (libclang.getCursorLocation (cursor), libclang.getCString (usr), cursor, LanguageRole::declaration, getEntityType (static_cast<int> (IndexEntityType::variable)), libclang.getCString (spelling), invalidPosition) };
        addTypeDefinition (context, record, cursor);
        libclang.disposeString (spelling);
        libclang.disposeString (usr);
    }

    return ChildVisitResult::visitContinue;
}

