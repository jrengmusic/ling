```getModuleDeclaration
static std::string_view getModuleDeclaration (std::string_view headerText)
{
    const std::string_view beginMarker { ToolchainWord::moduleDeclarationBegin };
    const auto begin { headerText.find (beginMarker) };
    const auto end { headerText.find (ToolchainWord::moduleDeclarationEnd, begin) };

    return begin != std::string_view::npos and end != std::string_view::npos ? headerText.substr (begin + beginMarker.size(), end - begin - beginMarker.size()) : std::string_view {};
}

```
```getModuleClosure
static ling::Texts getModuleClosure (std::string_view declaration, const std::filesystem::path& moduleParent, const std::string& juceModulesPath)
{
    ling::Texts closure;
    const std::string_view dependencyText { getFieldValue (declaration, ToolchainWord::moduleDependenciesField) };
    const std::string_view separators { ToolchainWord::dependencySeparators };
    const std::string_view prefix { ToolchainWord::juceModulePrefix };
    std::size_t start { dependencyText.find_first_not_of (separators) };

    while (start != std::string_view::npos)
    {
        const std::size_t end { std::min (dependencyText.find_first_of (separators, start), dependencyText.size()) };
        const std::string dependencyName { dependencyText.substr (start, end - start) };
        const std::filesystem::path dependencyFolder { std::string_view (dependencyName).compare (0, prefix.size(), prefix) == 0 ? std::filesystem::path (juceModulesPath) / dependencyName : moduleParent / dependencyName };
        const std::string dependencyHeaderText { ling::File ((dependencyFolder / (dependencyName + ToolchainWord::headerExtension)).string().c_str()).loadFileAsString() };
        const std::string dependencyFolderText { dependencyFolder.string() };

        if (not closure.contains (dependencyFolderText))
            closure.add (dependencyFolderText);

        const auto nestedClosure { getModuleClosure (getModuleDeclaration (dependencyHeaderText), dependencyFolder.parent_path(), juceModulesPath) };

        for (int index { 0 }; index < nestedClosure.size(); ++index)
            if (not closure.contains (nestedClosure.get (index)))
                closure.add (nestedClosure.get (index));

        start = dependencyText.find_first_not_of (separators, end);
    }

    return closure;
}

```
```getModuleArguments
static ling::Texts getModuleArguments (std::string_view declaration, const std::filesystem::path& moduleFolder, std::string_view moduleId, const std::string& juceModulesPath, const std::string& installDirectory, const std::string& sdkPath)
{
    ling::Texts arguments;
    const std::string_view declaredStandard { getFieldValue (declaration, ToolchainWord::moduleStandardField) };
    const std::string_view standardValue { declaredStandard.empty() ? std::string_view (static_cast<const char*> (getCppStandards().getAddress (currentPlatform))) : declaredStandard };
    const auto closure { getModuleClosure (declaration, moduleFolder.parent_path(), juceModulesPath) };
    const std::string juceModulesFlag { std::string (ToolchainWord::includeDirectoryFlag) + juceModulesPath };

    arguments.add (getDriver (installDirectory, ToolchainWord::databaseDriver));
    arguments.add (std::string (ToolchainWord::standardFlag) + std::string (standardValue));
    arguments.add (std::string (ToolchainWord::includeDirectoryFlag) + moduleFolder.parent_path().string());

    if (not arguments.contains (juceModulesFlag))
        arguments.add (juceModulesFlag);

    arguments.add (std::string (ToolchainWord::moduleAvailableDefine) + std::string (moduleId) + ToolchainWord::moduleAvailableValue);
    arguments.add (ToolchainWord::moduleSettingsDefine);

    for (int index { 0 }; index < closure.size(); ++index)
    {
        const std::filesystem::path dependencyPath (closure.get (index));
        const std::string dependencyIncludeFlag { std::string (ToolchainWord::includeDirectoryFlag) + dependencyPath.parent_path().string() };

        if (not arguments.contains (dependencyIncludeFlag))
            arguments.add (dependencyIncludeFlag);

        arguments.add (std::string (ToolchainWord::moduleAvailableDefine) + dependencyPath.filename().string() + ToolchainWord::moduleAvailableValue);
    }

    if (getSdkFlags().contains (currentPlatform) and not sdkPath.empty())
    {
        arguments.add (static_cast<const char*> (getSdkFlags().getAddress (currentPlatform)));
        arguments.add (sdkPath);
    }

    return arguments;
}

```
```getModuleFiles
static ling::Texts getModuleFiles (const std::filesystem::path& moduleFolder, const std::filesystem::path& unitPath)
{
    ling::Texts moduleFiles;

    for (const auto& entry : std::filesystem::recursive_directory_iterator (moduleFolder))
    {
        if (entry.is_regular_file())
        {
            const std::string extension { entry.path().extension().string() };
            const std::string_view extensionName { extension.empty() ? std::string_view {} : std::string_view (extension).substr (1) };

            for (const char* const* name { extensionPairs }; *name != nullptr; ++name)
            {
                if (std::string_view (*name).compare (extensionName) == 0)
                {
                    if (entry.path() != unitPath) moduleFiles.add (entry.path().string());
                    break;
                }
            }
        }
    }

    return moduleFiles;
}

```
```getModuleCandidates
static ling::Texts getModuleCandidates (const char* directory)
{
    ling::Texts candidates;

    for (const auto& entry : std::filesystem::directory_iterator (directory))
        if (entry.is_directory()) candidates.add (entry.path().string());

    candidates.add (directory);

    for (std::filesystem::path ancestor { directory }; ancestor != ancestor.parent_path(); ancestor = ancestor.parent_path())
        candidates.add (ancestor.parent_path().string());

    return candidates;
}

```
```addModuleUnits
static void addModuleUnits (const std::string& installDirectory, const std::string& sdkPath, const char* directory, const LanguageCallbacks& callbacks)
{
    const char* const homeDirectory { std::getenv (static_cast<const char*> (getHomeVariables().getAddress (currentPlatform))) };
    assert (homeDirectory != nullptr);
    const std::string juceModulesPath { (std::filesystem::path (homeDirectory) / static_cast<const char*> (getJuceModulePaths().getAddress (currentPlatform))).string() };
    const auto candidates { getModuleCandidates (directory) };

    for (int candidateIndex { 0 }; candidateIndex < candidates.size(); ++candidateIndex)
    {
        const std::filesystem::path moduleFolder (candidates.get (candidateIndex));
        const std::string headerText { ling::File ((moduleFolder / (moduleFolder.filename().string() + ToolchainWord::headerExtension)).string().c_str()).loadFileAsString() };
        const auto declaration { getModuleDeclaration (headerText) };
        const auto moduleId { getFieldValue (declaration, ToolchainWord::moduleIdField) };
        const std::filesystem::path unitPath { moduleFolder / (std::string (moduleId) + static_cast<char> (Chars::dot) + static_cast<const char*> (getModuleExtensions().getAddress (currentPlatform))) };

        if (not declaration.empty() and std::filesystem::exists (unitPath))
        {
            auto arguments (getModuleArguments (declaration, moduleFolder, moduleId, juceModulesPath, installDirectory, sdkPath));
            const auto moduleFiles (getModuleFiles (moduleFolder, unitPath));
            ling::Pointers commandLine;
            ling::Pointers dependencies;
            arguments.add (unitPath.string());

            for (int index { 0 }; index < arguments.size(); ++index) commandLine.add (arguments.getPointer (index));

            for (int index { 0 }; index < moduleFiles.size(); ++index) dependencies.add (moduleFiles.getPointer (index));

            callbacks.addUnit (callbacks.context, commandLine.at (commandLine.size() - 1), candidates.getPointer (candidateIndex), "", commandLine.begin(), commandLine.size(), dependencies.begin(), dependencies.size(), nullptr, 0);
        }
    }
}

```
```addUnitCommands
static void addUnitCommands (ling::Texts& texts, ling::Words& unitRows, ling::WordLists& unitArguments, ling::TextMap& paths, const LibClang& libclang, const std::string& installDirectory, const std::string& sdkPath, const char* const* row, int argumentCount, const char* directory, const LanguageCallbacks& callbacks)
{
    if (std::string_view (row[0]).compare (ToolchainWord::compilerManifestCommand) == 0 and not getFlagValue (row + 1, row + argumentCount, ToolchainWord::flagBuildDirectory).empty())
    {
        const auto buildDirectory { getNormalPath ((std::filesystem::path (directory) / std::string (getFlagValue (row + 1, row + argumentCount, ToolchainWord::flagBuildDirectory))).string()) };
        const auto compilerManifest { getNormalPath ((std::filesystem::path (buildDirectory) / ToolchainWord::compilerManifest).string()) };

        if (std::filesystem::exists (compilerManifest))
        {
            int errorCode { 0 };
            const std::unique_ptr<void, decltype (LibClang::disposeCompilationDatabase)> database { libclang.createCompilationDatabase (buildDirectory.c_str(), &errorCode), libclang.disposeCompilationDatabase };

            if (database != nullptr)
            {
                const std::unique_ptr<void, decltype (LibClang::disposeCompileCommands)> compileCommands { libclang.getAllCompileCommands (database.get()), libclang.disposeCompileCommands };

                callbacks.addBuildFile (callbacks.context, compilerManifest.c_str());

                for (unsigned commandIndex { 0 }; commandIndex < libclang.getCompileCommandsSize (compileCommands.get()); ++commandIndex)
                    addUnitCommand (texts, unitRows, unitArguments, paths, libclang, installDirectory, sdkPath, libclang.getCompileCommand (compileCommands.get(), commandIndex), callbacks);
            }
            else
                callbacks.addMessage (callbacks.context, (compilerManifest + ToolchainWord::messageSeparator + ToolchainWord::compilerManifestInvalid).c_str());
        }
        else
            callbacks.addMessage (callbacks.context, (compilerManifest + ToolchainWord::messageSeparator + ToolchainWord::compilerManifestNotFound).c_str());
    }
}

