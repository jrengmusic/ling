```getBodyEnd
static int getBodyEnd (std::string_view source, const ling::Tokens& tokens, int bodyStart, int end)
{
    return bodyStart < end and isPunctuation (source, tokens.at (bodyStart), Chars::openBrace)
           ? getNextPosition (getBlockEnd (source, tokens, bodyStart, end), end)
           : getUnbracedBodyEnd (source, tokens, bodyStart, end);
}

