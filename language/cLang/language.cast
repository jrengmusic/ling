```isPunctuation
static bool isPunctuation (std::string_view source, const Token& token, int byte)
{
    return token.type == map::SyntaxTokenType::punctuation
           and static_cast<int> (source.at (token.start)) == byte;
}

```
```isKeyword
static bool isKeyword (const Token& token, int key)
{
    return token.type == map::SyntaxTokenType::keyword and token.key == key;
}

```
```isSameName
static bool isSameName (std::string_view source, const Token& name, const Token& otherName)
{
    return source.substr (name.start, name.end - name.start)
               .compare (source.substr (otherName.start, otherName.end - otherName.start))
           == 0;
}

```
```isMemberAccess
static bool isMemberAccess (std::string_view source, const ling::Tokens& tokens, int namePosition)
{
    return (namePosition >= 1 and isPunctuation (source, tokens.at (namePosition - 1), Chars::dot))
           or (namePosition >= 2 and isPunctuation (source, tokens.at (namePosition - 1), Chars::greaterThan)
               and isPunctuation (source, tokens.at (namePosition - 2), Chars::dash));
}

```
```isLocalReference
static bool isLocalReference (const CLanguageDocument& document, int reference)
{
    const auto type { getElementType (document, reference) };

    return (type == map::SyntaxTokenType::reference or type == map::SyntaxTokenType::call or type == map::SyntaxTokenType::base)
           and ling::HalfWords::unpackSecond (document.elements.at (reference * elementStride + 1)) == 1
           and document.elements.at (reference * elementStride + 2) == 0;
}

```
```getElementType
static int getElementType (const CLanguageDocument& document, int element)
{
    return ling::HalfWords::unpackSecond (document.elements.at (element * elementStride));
}

```
```getLastNameToken
static const Token& getLastNameToken (const CLanguageDocument& document, int element)
{
    const auto name { document.elements.at (element * elementStride + 1) };
    return document.nameTokens.at (ling::HalfWords::unpackFirst (name) + ling::HalfWords::unpackSecond (name) - 1);
}

```
```isSingleColon
static bool isSingleColon (std::string_view source, const ling::Tokens& tokens, int index, int start, int end)
{
    return isPunctuation (source, tokens.at (index), Chars::colon)
           and not (index > start and isPunctuation (source, tokens.at (index - 1), Chars::colon))
           and not (index + 1 < end and isPunctuation (source, tokens.at (index + 1), Chars::colon));
}

```
```isFunctionScope
static bool isFunctionScope (const CLanguageDocument& document, int scope)
{
    return getScopeType (document, scope) == map::SyntaxTokenType::function;
}

