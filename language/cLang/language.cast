```addCallRecords
static void addCallRecords (const LibClang& libclang, IndexContext& context, Cursor cursor)
{
    const auto callee { libclang.getCursorReferenced (cursor) };
    const auto calleeName { getText (libclang, libclang.getCursorSpelling (callee)) };
    const std::string_view operatorName { HoverLabel::operatorName };
    const bool isImplicit { libclang.getNumArguments (cursor) == 1 and libclang.equalRanges (libclang.getCursorExtent (cursor), libclang.getCursorExtent (libclang.getArgument (cursor, 0))) != 0 };
    const bool isSkipped { isImplicit or libclang.isVariadic (callee) != 0 or calleeName.compare (0, operatorName.size(), operatorName) == 0 };

    if (context.keptRanges.isEmpty())
        addParameterHints (libclang, context, cursor, callee, calleeName);

    for (int index { 0 }; not isSkipped and index < std::min (libclang.getNumArguments (cursor), libclang.getNumArguments (callee)); ++index)
    {
        const auto inner { getInnerArgument (context, libclang.getArgument (cursor, static_cast<unsigned> (index))) };
        SourceFile file { nullptr };
        unsigned offset { 0 };

        libclang.getSpellingLocation (libclang.getCursorLocation (inner), &file, nullptr, nullptr, &offset);

        if (inner.type == CursorType::declarationReferenceExpression or inner.type == CursorType::memberReferenceExpression)
            context.passings.set (ling::Wyhash::mix (getFileWord (file), static_cast<unsigned long long> (offset)), static_cast<unsigned long long> (context.texts.add (getHoverPassing (libclang, libclang.getArgument (callee, static_cast<unsigned> (index)), inner))));
    }
}

```
```onCursor
static ChildVisitResult onCursor (Cursor cursor, Cursor, ClientData clientData)
{
    using AddRecord = void (*) (const LibClang&, IndexContext&, Cursor);

    static const ling::AddressTable cursorRecords {
        {
:::[list]:::
        }
    };

    auto& context { *static_cast<IndexContext*> (clientData) };

    if (context.callbacks.shouldExit != nullptr and context.callbacks.shouldExit (context.callbacks.context) != 0)
        return ChildVisitResult::visitBreak;

    const auto& libclang { context.libclang };
    const auto location { libclang.getCursorLocation (cursor) };

    if (context.isPreprocessed (location))
    {
        if (not context.isForeign (location))
        {
            const auto addCursorRecord { reinterpret_cast<AddRecord> (reinterpret_cast<std::uintptr_t> (cursorRecords[static_cast<int> (cursor.type)])) };

            if (addCursorRecord != nullptr)
                addCursorRecord (libclang, context, cursor);
        }

        return ChildVisitResult::recurse;
    }

    return ChildVisitResult::visitContinue;
}

