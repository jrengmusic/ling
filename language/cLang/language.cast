```addFunctionReturnHint
static void addFunctionReturnHint (const LibClang& libclang, IndexContext& context, Cursor function)
{
    if (isDeducedType (libclang, libclang.getCursorResultType (function)))
    {
        const auto translationUnit { libclang.getCursorTranslationUnit (function) };
        const auto nameEnd { libclang.getRangeEnd (libclang.getSpellingNameRange (function, 0, 0)) };
        SourceToken* tokens { nullptr };
        unsigned tokenCount { 0 };

        libclang.tokenize (translationUnit, libclang.getRange (nameEnd, libclang.getRangeEnd (libclang.getCursorExtent (function))), &tokens, &tokenCount);

        if (tokenCount > 0 and isTokenByte (libclang, translationUnit, tokens[0], Chars::openParen))
        {
            const auto listEnd { getClosingIndex (libclang, translationUnit, tokens, tokenCount, 0, Chars::openParen, Chars::closeParen) };

            addTypeHint (context, libclang.getRangeEnd (libclang.getTokenExtent (translationUnit, tokens[listEnd])), InlayHintLabel::returnPrefix, getReturnTypeText (libclang, function));
        }

        libclang.disposeTokens (translationUnit, tokens, tokenCount);
    }
}

