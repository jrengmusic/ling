```getOutlineQualifierStart
static int getOutlineQualifierStart (std::string_view contents, int offset)
{
    int qualifierStart { offset };

    while (isScopeOperatorBefore (contents, qualifierStart) and getIdentifierStart (contents, qualifierStart - 2) < qualifierStart - 2)
        qualifierStart = getIdentifierStart (contents, qualifierStart - 2);

    return qualifierStart;
}

