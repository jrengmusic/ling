```lookup-table
template <typename Key, typename Value, int Capacity>
struct LookupTable
{
    struct Entry
    {
        Key key;
        Value value;
    };

    constexpr LookupTable (std::initializer_list<Entry> entries) noexcept
        : defaultValue { entries.begin()->value }
    {
        for (auto& slot : slots)
            slot = defaultValue;

        for (const auto& entry : entries)
            slots.at (static_cast<std::size_t> (entry.key)) = entry.value;
    }

    constexpr Value operator[] (Key key) const noexcept
    {
        return static_cast<std::size_t> (key) < static_cast<std::size_t> (Capacity) ? slots.at (static_cast<std::size_t> (key)) : defaultValue;
    }

    constexpr const Value* data() const noexcept
    {
        return slots.data();
    }

    Value defaultValue;
    std::array<Value, static_cast<std::size_t> (Capacity)> slots {};
};

