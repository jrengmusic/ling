```getReturnTypeText
static std::string getReturnTypeText (const LibClang& libclang, Cursor function)
{
    const char space { static_cast<char> (Chars::space) };
    const auto declaration { getTypeHintDeclaration (libclang, function) };
    const auto position { declaration.find (getText (libclang, libclang.getCursorSpelling (function)) + HoverLabel::valueOpen) };
    const std::string_view type { std::string_view (declaration).substr (0, position != std::string::npos ? position : 0) };

    return std::string (type.substr (0, type.find_last_not_of (space) + 1));
}

