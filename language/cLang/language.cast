```getOrCreateDefinition
static int getOrCreateDefinition (IndexContext& context, Cursor cursor)
{
    const auto key { static_cast<unsigned long long> (context.libclang.hashCursor (cursor)) };

    for (int candidate { 0 }; candidate < context.definitionIndices.getSize (key); ++candidate)
    {
        const auto word { context.definitionIndices.at (key, candidate) };

        if (context.libclang.equalCursors (getCursor (context.cursors, ling::HalfWords::unpackFirst (word)), cursor) != 0)
            return ling::HalfWords::unpackSecond (word);
    }

    const auto definitionRange { getDefinitionRange (context, cursor) };
    SourceFile definitionFile { nullptr };
    unsigned line { 0 };
    unsigned column { 0 };
    unsigned endLine { 0 };
    unsigned endColumn { 0 };

    context.libclang.getExpansionLocation (context.libclang.getRangeStart (definitionRange), &definitionFile, &line, &column, nullptr);
    context.libclang.getExpansionLocation (context.libclang.getRangeEnd (definitionRange), nullptr, &endLine, &endColumn, nullptr);

    const bool hasDefinition { definitionFile != nullptr and hasDefinitionText (context.libclang, cursor) };
    const auto definition { static_cast<int> (context.definitions.size()) / definitionStride };

    context.definitions.add (ling::HalfWords::pack (hasDefinition ? context.texts.add (getNormalPath (getText (context.libclang, context.libclang.getFileName (definitionFile)))) : invalidPosition, 0));
    context.definitions.add (ling::HalfWords::pack (hasDefinition ? static_cast<int> (line) : 0, hasDefinition ? static_cast<int> (column) : 0));
    context.definitions.add (ling::HalfWords::pack (hasDefinition ? static_cast<int> (endLine) : 0, hasDefinition ? static_cast<int> (endColumn) : 0));
    context.definitionIndices.add (key, ling::HalfWords::pack (addCursor (context.cursors, cursor), definition));

    return definition;
}

```
```addPositionSymbols
static void addPositionSymbols (IndexContext& context, const std::string& path, SourceFile file, int start, int end)
{
    const auto key { getFileWord (file) };
    const auto getRow { [&context, key] (int position) { return static_cast<int> (context.records.at (key, position)) * recordStride; } };
    const auto isNamed { [&context, &getRow] (int position) { return ling::HalfWords::unpackSecond (context.recordRows.at (getRow (position))) != 0; } };
    const auto getType { [&context, &getRow] (int position) { return ling::HalfWords::unpackSecond (context.recordRows.at (getRow (position) + 2)); } };
    const auto getRank { [&isNamed, &getType] (int position) { return std::make_pair (isNamed (position), precedences[getType (position)]); } };
    int best { start };
    bool isMacroUse { false };

    for (int position { start }; position < end; ++position)
    {
        if (getRank (best) < getRank (position))
            best = position;

        isMacroUse = isMacroUse or (getType (position) == map::SyntaxTokenType::macro and isNamed (position));
    }

    for (int position { start }; position < end; ++position)
    {
        const auto row { getRow (position) };
        const auto hoverPosition { ling::HalfWords::unpackFirst (context.recordRows.at (row + 4)) };
        const auto hoverWord { hoverPosition != invalidPosition ? context.hoverPositions.at (hoverPosition * hoverPositionStride + 4) : ling::HalfWords::pack (invalidPosition, invalidPosition) };
        const auto textIndex { ling::HalfWords::unpackFirst (hoverWord) };
        const auto types { context.recordRows.at (row + 5) };

        if (isMacroUse or position == best or isNamed (position))
        {
            const auto hoverKey { ling::Wyhash::mix (key, static_cast<unsigned long long> (textIndex)) };
            const bool hasHover { textIndex != invalidPosition };

            if (hasHover and not context.hoverIndices.contains (hoverKey))
            {
                const auto hoverCursor { getCursor (context.cursors, ling::HalfWords::unpackSecond (context.hoverPositions.at (hoverPosition * hoverPositionStride + 2))) };
                const auto definition { getOrCreateDefinition (context, hoverCursor) * definitionStride };
                const auto pathText { ling::HalfWords::unpackFirst (context.definitions.at (definition)) };
                const auto definitionStart { context.definitions.at (definition + 1) };
                const auto definitionEnd { context.definitions.at (definition + 2) };

                context.hoverIndices.add (hoverKey, static_cast<unsigned long long> (context.callbacks.addHover (context.callbacks.context, path.c_str(), context.texts.getPointer (textIndex), pathText != invalidPosition ? context.texts.getPointer (pathText) : nullptr, ling::HalfWords::unpackFirst (definitionStart), ling::HalfWords::unpackSecond (definitionStart), ling::HalfWords::unpackFirst (definitionEnd), ling::HalfWords::unpackSecond (definitionEnd))));
            }

            const auto hover { hasHover ? static_cast<int> (context.hoverIndices.at (hoverKey)) : LanguageCallbacks::noHover };

            context.callbacks.addSymbol (context.callbacks.context, path.c_str(), ling::HalfWords::unpackFirst (context.recordRows.at (row + 1)), ling::HalfWords::unpackSecond (context.recordRows.at (row + 1)), context.recordRows.at (row + 3), ling::HalfWords::unpackSecond (context.recordRows.at (row)), ling::HalfWords::unpackFirst (context.recordRows.at (row + 2)), getType (position), hover, context.typeSymbols.begin() + ling::HalfWords::unpackFirst (types), ling::HalfWords::unpackSecond (types));
        }
    }
}

```
```addChosenSymbols
static void addChosenSymbols (const LibClang& libclang, IndexContext& context)
{
    context.records.applyToKeys ([&libclang, &context] (unsigned long long key)
    {
        const auto file { getSourceFile (key) };
        const auto path { getNormalPath (getText (libclang, libclang.getFileName (file))) };
        const auto getRow { [&context, key] (int position) { return static_cast<int> (context.records.at (key, position)) * recordStride; } };

        context.records.sort (key, [&context] (unsigned long long first, unsigned long long second)
        {
            return ling::HalfWords::unpackFirst (context.recordRows.at (static_cast<int> (first) * recordStride)) < ling::HalfWords::unpackFirst (context.recordRows.at (static_cast<int> (second) * recordStride));
        });

        for (int start { 0 }; start < context.records.getSize (key);)
        {
            int end { start + 1 };

            while (end < context.records.getSize (key) and ling::HalfWords::unpackFirst (context.recordRows.at (getRow (end))) == ling::HalfWords::unpackFirst (context.recordRows.at (getRow (start))))
                ++end;

            addPositionSymbols (context, path, file, start, end);
            start = end;
        }
    });
}

