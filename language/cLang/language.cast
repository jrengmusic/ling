```getHoverCursorType
static int getHoverCursorType (const LibClang& libclang, Cursor cursor)
{
    const int cursorType { libclang.getCursorKind (cursor) };
    const bool isTemplate { cursorType == static_cast<int> (CursorType::functionTemplate) or cursorType == static_cast<int> (CursorType::classTemplate) };

    return isTemplate ? libclang.getTemplateCursorKind (cursor) : cursorType;
}

