```build
static int build (const char* source, int sourceSize, const LanguageToken* tokens, int tokenCount, const LanguageCallbacks& callbacks)
{
    CLanguageDocument document { std::string_view (source, static_cast<std::size_t> (sourceSize)), {}, callbacks };
    ling::Tokens codeTokens;

    document.elements.add (ling::HalfWords::pack (invalidPosition, map::SyntaxTokenType::namespaceToken));
    document.elements.add (ling::HalfWords::pack (0, 0));
    document.elements.add (0);

    std::for_each (tokens, tokens + tokenCount,
                   [&document, &codeTokens] (const Token& token)
                   { (token.type == map::SyntaxTokenType::comment ? document.tokens : codeTokens).add (token); });

    addStatements (document, 0, codeTokens, 0, codeTokens.size());
    addLocalLinks (document, 0);
    return document.elements.size() / elementStride;
}

```
```index
static int index (const char* const* arguments, int argumentCount, const char* directory, const char* const* bufferPaths, const char* const* bufferTexts, int bufferCount, const LanguageCallbacks& callbacks)
{
    assert (argumentCount > 0);

    const auto installDirectory { std::filesystem::path (arguments[0]).parent_path().string() };
    auto& session { getIndexSession ((std::filesystem::path (installDirectory) / static_cast<const char*> (getLibraryPaths().getAddress (currentPlatform))).string(), excludeDeclarationsFromPCH, displayDiagnostics) };

    if (session.isLoaded())
    {
        const auto commandLine (getArguments (arguments, argumentCount, directory));
        const auto precompiledPath { getOutputPath (arguments, argumentCount, directory) };
        int result { indexFailure };
        auto indexUnit { [&session, &commandLine, &callbacks, directory, &precompiledPath, bufferPaths, bufferTexts, bufferCount, &result] { result = indexSource (session, commandLine, callbacks, directory, precompiledPath, bufferPaths, bufferTexts, bufferCount); } };

        session.libclang->executeOnThread ([] (void* data) { (*static_cast<decltype (indexUnit)*> (data))(); }, &indexUnit, defaultStackSize);
        return result;
    }

    return indexFailure;
}

```
```units
static int units (const char* const* arguments, const int* argumentCounts, int rowCount, const char* directory, const char* cacheDirectory, const LanguageCallbacks& callbacks)
{
    const auto installDirectory { getVersionInstallDirectory (getCommandOutput (std::string (ToolchainWord::databaseDriver) + static_cast<char> (Chars::space) + ToolchainWord::versionFlag, directory).value_or (std::string {})) };
    const LibClang libclang ((std::filesystem::path (installDirectory) / static_cast<const char*> (getLibraryPaths().getAddress (currentPlatform))).string());

    if (not installDirectory.empty() and libclang.isLoaded())
    {
        const std::string sdkPath { getSdkCommands().contains (currentPlatform) ? getCommandOutput (static_cast<const char*> (getSdkCommands().getAddress (currentPlatform)), directory).value_or (std::string {}) : std::string {} };

        ling::Texts texts;
        ling::Words unitRows;
        ling::WordLists unitArguments;
        ling::TextMap paths;
        ling::TextMap outputs;
        ling::WordLists dependencies;
        ling::WordLists prerequisites;

        applyToRows (arguments, argumentCounts, rowCount, [&texts, &unitRows, &unitArguments, &paths, &libclang, &installDirectory, &sdkPath, directory, &callbacks] (const char* const* row, int argumentCount) { addUnitCommands (texts, unitRows, unitArguments, paths, libclang, installDirectory, sdkPath, row, argumentCount, directory, callbacks); });
        addOutputs (texts, unitRows, outputs);
        applyToRows (arguments, argumentCounts, rowCount, [directory, &texts, &unitRows, &outputs, &dependencies, &callbacks] (const char* const* row, int argumentCount)
        {
            if (std::string_view (row[0]).compare (ToolchainWord::dependencyCommand) == 0)
                addDependencies (row, argumentCount, directory, texts, unitRows, outputs, dependencies, callbacks);
        });
        addPrerequisites (texts, unitRows, unitArguments, outputs, cacheDirectory, prerequisites);
        addUnits (texts, unitRows, unitArguments, dependencies, prerequisites, callbacks);

        if (rowCount == 0)
            addModuleUnits (installDirectory, sdkPath, directory, callbacks);

        return 0;
    }

    callbacks.addMessage (callbacks.context, ToolchainWord::compilerManifestNotFound);
    return indexFailure;
}

