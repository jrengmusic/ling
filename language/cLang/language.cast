```hasDefinitionText
static bool hasDefinitionText (const LibClang& libclang, Cursor cursor)
{
    return cursor.type == CursorType::macroDefinition or libclang.equalRanges (libclang.getCursorExtent (cursor), libclang.getSpellingNameRange (cursor, 0, 0)) == 0;
}

