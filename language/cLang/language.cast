```commentSpaces
static constexpr std::string_view horizontalSpaces { " \t" };
static constexpr std::string_view lineSpaces { " \t\r" };

```
```getMarkerLength
static std::size_t getMarkerLength (std::string_view line, bool isInBlock)
{
    const auto markerStart { line.find_first_not_of (horizontalSpaces) };
    const auto isByteAt { [&line] (std::size_t position, int byte) { return position < line.size() and line.at (position) == byte; } };
    const bool isMarked { not isInBlock and isByteAt (markerStart, Chars::slash) };
    const bool isBlockStart { isMarked and isByteAt (markerStart + 1, Chars::asterisk) };
    const bool isLineStart { isMarked and isByteAt (markerStart + 1, Chars::slash) };
    std::size_t length { 0 };

    if (isInBlock) length = isByteAt (markerStart, Chars::asterisk) and not isByteAt (markerStart + 1, Chars::slash) ? markerStart + 1 : 0;
    else if (isBlockStart or isLineStart) length = markerStart + 2;

    if (isBlockStart) length += (isByteAt (length, Chars::asterisk) and not isByteAt (length + 1, Chars::slash)) or isByteAt (length, Chars::exclamation) ? 1 : 0;
    if (isLineStart) length += isByteAt (length, Chars::slash) or isByteAt (length, Chars::exclamation) ? 1 : 0;
    if (isBlockStart or isLineStart) length += isByteAt (length, Chars::lessThan) ? 1 : 0;

    return length;
}

```
```getFormattedComment
static std::string getFormattedComment (std::string_view raw)
{
    std::string formatted;
    std::size_t indentColumn { 0 };
    bool isInBlock { false };

    for (bool isFirstLine { true }; not raw.empty(); isFirstLine = false)
    {
        const auto line { raw.substr (0, std::min (raw.find (static_cast<char> (Chars::newline)), raw.size())) };
        const auto blockOpen { line.find (Chars::cssCommentOpen) };
        const bool isBlockStart { not isInBlock and blockOpen != std::string_view::npos and blockOpen == line.find_first_not_of (horizontalSpaces) };
        const auto skip { getMarkerLength (line, isInBlock) };
        const auto closing { isInBlock or isBlockStart ? line.find (Chars::cssCommentClose, skip) : std::string_view::npos };
        const auto text { line.substr (skip, std::min (closing, line.size()) - skip) };
        const auto whitespaceLength { std::min (text.find_first_not_of (horizontalSpaces), text.size()) };
        const auto skipLength { isFirstLine ? whitespaceLength : std::min (whitespaceLength, indentColumn > skip ? indentColumn - skip : std::size_t { 0 }) };

        raw.remove_prefix (std::min (line.size() + 1, raw.size()));
        isInBlock = (isInBlock or isBlockStart) and closing == std::string_view::npos;

        if (isFirstLine and not text.empty()) indentColumn = skip + whitespaceLength;
        formatted.append (text.substr (skipLength)).push_back (static_cast<char> (Chars::newline));
    }

    formatted.erase (formatted.find_last_not_of (static_cast<char> (Chars::newline)) + 1);

    return formatted;
}

```
```isParagraphEnd
static bool isParagraphEnd (std::string_view line, std::string_view rest)
{
    static constexpr std::string_view sentenceEnds { ".:,;!?" };
    static constexpr std::string_view listStarts { "-*@\\>#`" };
    static constexpr std::string_view digits { "0123456789" };
    const auto next { rest.substr (std::min (rest.find_first_not_of (lineSpaces), rest.size())) };
    const auto lastByte { line.find_last_not_of (lineSpaces) };
    const auto digitsEnd { next.find_first_not_of (digits) };
    const bool isNumbered { digitsEnd > 0 and digitsEnd < next.size() and (next.at (digitsEnd) == Chars::dot or next.at (digitsEnd) == Chars::closeParen) };
    const bool isBreakNext { not next.empty() and (next.front() == Chars::newline or listStarts.find (next.front()) != std::string_view::npos or isNumbered) };
    const bool isSentenceEnd { lastByte != std::string_view::npos and sentenceEnds.find (line.at (lastByte)) != std::string_view::npos };

    return isBreakNext or isSentenceEnd;
}

```
```getCommentParagraphs
static std::string getCommentParagraphs (std::string_view formatted)
{
    static constexpr std::string_view blankBytes { "/*-= \t\r\n" };
    std::string paragraphs;
    std::string paragraph;
    std::string_view rest { formatted.find_first_not_of (blankBytes) == std::string_view::npos ? std::string_view {} : formatted };

    while (not rest.empty())
    {
        auto line { rest.substr (0, std::min (rest.find (static_cast<char> (Chars::newline)), rest.size())) };

        rest.remove_prefix (std::min (line.size() + 1, rest.size()));
        line.remove_prefix (std::min (line.find_first_not_of (lineSpaces), line.size()));
        paragraph.append (static_cast<std::size_t> (not (paragraph.empty() or line.empty())), static_cast<char> (Chars::space)).append (line);

        if ((rest.empty() or isParagraphEnd (line, rest)) and not paragraph.empty())
        {
            std::replace_if (paragraph.begin(), paragraph.end(), [] (char byte) { return lineSpaces.find (byte) != std::string_view::npos; }, static_cast<char> (Chars::space));
            paragraph.erase (std::unique (paragraph.begin(), paragraph.end(), [] (char first, char second) { return first == Chars::space and second == Chars::space; }), paragraph.end());
            paragraph.erase (paragraph.find_last_not_of (static_cast<char> (Chars::space)) + 1);
            paragraphs.append (static_cast<std::size_t> (not paragraphs.empty()), static_cast<char> (Chars::newline)).append (paragraph);
            paragraph.clear();
        }
    }

    return paragraphs;
}

