```getHoverValue
static std::string getHoverValue (IndexContext& context, Cursor cursor)
{
    const char space { static_cast<char> (Chars::space) };
    const int cursorType { context.libclang.getCursorKind (cursor) };
    const auto result { cursorType == static_cast<int> (CursorType::variableDeclaration) or cursorType == static_cast<int> (CursorType::fieldDeclaration) ? context.libclang.evaluate (cursor) : nullptr };
    std::string line;

    if (result != nullptr)
    {
        if (context.libclang.getEvalResultKind (result) == static_cast<int> (EvaluationResultType::integer))
        {
            const bool isUnsigned { context.libclang.isEvalResultUnsigned (result) != 0 };
            const long long number { isUnsigned ? static_cast<long long> (context.libclang.getEvalResultAsUnsigned (result)) : context.libclang.getEvalResultAsLongLong (result) };
            const bool isNegative { not isUnsigned and number < 0 };
            const auto bits { static_cast<unsigned long long> (number) };
            const auto type { context.libclang.getCanonicalType (context.libclang.getCursorType (cursor)) };
            const auto enumerator { type.type == ValueCategory::enumeration ? getEnumeratorName (context, context.libclang.getTypeDeclaration (type), number) : std::string() };
            const bool isHex { not enumerator.empty() or isNegative or bits >= static_cast<unsigned long long> (ToolchainValue::hexThreshold) };
            std::ostringstream hex;

            hex << std::hex << (isNegative and number >= std::numeric_limits<std::int32_t>::min() ? static_cast<std::uint32_t> (number) : bits);
            line = std::string (HoverLabel::value) + space + (enumerator.empty() ? (isUnsigned ? std::to_string (bits) : std::to_string (number)) : enumerator);
            line += (isHex ? space + std::string (HoverLabel::valueOpen) + HoverLabel::hexPrefix + hex.str() + HoverLabel::valueClose : std::string()) + static_cast<char> (Chars::newline);
        }

        context.libclang.disposeEvalResult (result);
    }

    return line;
}

```
```getHoverComment
static std::string getHoverComment (const LibClang& libclang, Cursor cursor)
{
    const auto getParagraphs { [&libclang] (Cursor commentCursor)
    {
        return getCommentParagraphs (getFormattedComment (getText (libclang, libclang.getRawCommentText (commentCursor))));
    } };
    const auto comment { getParagraphs (libclang.getCanonicalCursor (cursor)) };

    return comment.empty() ? getParagraphs (cursor) : comment;
}

