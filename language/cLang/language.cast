```getInnerArgument
static Cursor getInnerArgument (IndexContext& context, Cursor argument)
{
    static const ling::LookupTable innerArgumentTypes {
        {
:::[list]:::
        }
    };

    Cursor found { argument };
    Cursor previous { argument };

    do
    {
        previous = found;

        applyToChildren (context.libclang, previous, [&context, &found, previous] (Cursor child)
        {
            if (innerArgumentTypes[static_cast<int> (child.type)] != 0 and context.libclang.equalRanges (context.libclang.getCursorExtent (child), context.libclang.getCursorExtent (previous)) != 0)
            {
                found = child;
                return ChildVisitResult::visitBreak;
            }

            return ChildVisitResult::visitContinue;
        });
    } while (context.libclang.equalCursors (previous, found) == 0 and found.type != CursorType::declarationReferenceExpression and found.type != CursorType::memberReferenceExpression);

    return found;
}

