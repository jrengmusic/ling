```getFrameworkSpelling
static std::string getFrameworkSpelling (std::string_view relativePath)
{
    const std::string_view frameworkSuffix { ToolchainWord::frameworkSuffix };
    const std::filesystem::path relative (relativePath);
    std::string spelling;

    for (auto component { relative.begin() }; component != relative.end() and spelling.empty(); ++component)
    {
        const auto text { component->generic_string() };
        const auto headers { std::next (component) };
        const bool isSuffixed { text.size() > frameworkSuffix.size() and text.compare (text.size() - frameworkSuffix.size(), frameworkSuffix.size(), frameworkSuffix) == 0 };

        if (isSuffixed and headers != relative.end() and headers->generic_string().compare (ToolchainWord::frameworkHeaders) == 0)
        {
            spelling = text.substr (0, text.size() - frameworkSuffix.size());

            for (auto rest { std::next (headers) }; rest != relative.end(); ++rest)
                spelling += static_cast<char> (Chars::slash) + rest->generic_string();
        }
    }

    return spelling;
}

```
```getSpelledHeader
static std::string getSpelledHeader (const IndexContext& context, SourceFile header, SourceFile mainFile)
{
    static const ling::LookupTable angledGroups {
        {
:::[list]:::
        }
    };
    static const ling::LookupTable frameworkGroups {
        {
:::[list]:::
        }
    };

    const std::string path { getNormalPath (getText (context.libclang, context.libclang.getFileName (header))) };
    const auto getPrefixLength { [&path] (std::string_view directory)
    {
        return path.size() > directory.size() + 1 and path.compare (0, directory.size(), directory) == 0 and path.at (directory.size()) == Chars::slash ? directory.size() + 1 : 0;
    } };
    std::size_t bestLength { 0 };
    int bestGroup { SearchGroup::quoted };

    for (const auto& word : context.searchDirectories)
    {
        const std::string_view directory { context.texts.get (ling::HalfWords::unpackFirst (word)) };

        if (getPrefixLength (directory) > bestLength) { bestLength = getPrefixLength (directory); bestGroup = ling::HalfWords::unpackSecond (word); }
    }

    const bool isFallback { bestLength == 0 };
    const bool isAngled { not isFallback and angledGroups[bestGroup] != 0 };
    const bool isFramework { not isFallback and frameworkGroups[bestGroup] != 0 };

    bestLength = isFallback ? getPrefixLength (getNormalPath (std::filesystem::path (getText (context.libclang, context.libclang.getFileName (mainFile))).parent_path().string())) : bestLength;

    const auto relativePath { path.substr (bestLength) };
    const auto frameworkSpelling { isFramework ? getFrameworkSpelling (relativePath) : std::string() };
    const auto spelled { frameworkSpelling.empty() ? relativePath : frameworkSpelling };

    return isAngled ? static_cast<char> (Chars::lessThan) + spelled + static_cast<char> (Chars::greaterThan) : static_cast<char> (Chars::doubleQuote) + spelled + static_cast<char> (Chars::doubleQuote);
}

