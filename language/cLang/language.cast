```getSkippedRanges
static ling::WordLists getSkippedRanges (const LibClang& libclang, IndexContext& context)
{
    ling::WordLists ranges;
    auto* skipped { libclang.getAllSkippedRanges (context.translationUnit) };

    for (unsigned index { 0 }; index < skipped->count; ++index)
    {
        const auto range { *(skipped->ranges + index) };
        const auto rangeStart { libclang.getRangeStart (range) };
        SourceFile file { nullptr };
        unsigned start { 0 };
        unsigned end { 0 };

        libclang.getSpellingLocation (rangeStart, &file, nullptr, nullptr, &start);
        libclang.getSpellingLocation (libclang.getRangeEnd (range), nullptr, nullptr, nullptr, &end);

        if (file != nullptr and libclang.isInSystemHeader (rangeStart) == 0 and not context.isForeign (file))
            ranges.add (context.getPathKey (file), ling::HalfWords::pack (static_cast<int> (start), static_cast<int> (end)));
    }

    libclang.disposeSourceRangeList (skipped);
    return ranges;
}

```
```getRemainingRanges
static ling::WordLists getRemainingRanges (const ling::WordLists& keptRanges, const ling::WordLists& skippedRanges)
{
    const auto isInside { [] (unsigned long long inner, unsigned long long outer)
    {
        return ling::HalfWords::unpackFirst (outer) <= ling::HalfWords::unpackFirst (inner) and ling::HalfWords::unpackSecond (inner) <= ling::HalfWords::unpackSecond (outer);
    } };
    ling::WordLists remaining;

    keptRanges.applyToKeys ([&keptRanges, &skippedRanges, &remaining, &isInside] (unsigned long long pathKey)
    {
        for (int keptPosition { 0 }; keptPosition < keptRanges.getSize (pathKey); ++keptPosition)
        {
            const auto kept { keptRanges.at (pathKey, keptPosition) };
            bool isStillSkipped { false };

            for (int position { 0 }; position < skippedRanges.getSize (pathKey); ++position)
                isStillSkipped = isStillSkipped or isInside (kept, skippedRanges.at (pathKey, position));

            if (isStillSkipped)
                remaining.add (pathKey, kept);
            else
            {
                for (int position { 0 }; position < skippedRanges.getSize (pathKey); ++position)
                    if (isInside (skippedRanges.at (pathKey, position), kept)) remaining.add (pathKey, skippedRanges.at (pathKey, position));
            }
        }
    });

    return remaining;
}

```
```getContextCommandLine
static ling::Pointers getContextCommandLine (const ling::Pointers& commandLine, const ling::Pointers& flags, bool keepPrecompiled)
{
    const std::string_view frontendFlag { ToolchainWord::frontendFlag };
    const std::string_view precompiledIncludeFlag { ToolchainWord::precompiledIncludeFlag };
    ling::Pointers contextCommandLine;
    bool hasPrecompiledInclude { false };

    for (int position { 0 }; position < commandLine.size(); ++position)
    {
        if (position + 1 < commandLine.size() and frontendFlag.compare (commandLine.at (position)) == 0 and precompiledIncludeFlag.compare (commandLine.at (position + 1)) == 0)
        {
            hasPrecompiledInclude = true;

            if (keepPrecompiled)
                contextCommandLine.add (commandLine.at (position));
            else
                position += static_cast<int> (ToolchainValue::precompiledIncludeWidth) - 1;
        }
        else
            contextCommandLine.add (commandLine.at (position));
    }

    if (keepPrecompiled and hasPrecompiledInclude)
    {
        contextCommandLine.add (ToolchainWord::frontendFlag);
        contextCommandLine.add (ToolchainWord::noValidatePrecompiledFlag);
    }

    for (int position { 0 }; position < flags.size(); ++position)
        contextCommandLine.add (flags.at (position));

    return contextCommandLine;
}

```
```getDirectiveLine
static std::string_view getDirectiveLine (std::string_view contents, unsigned offset)
{
    const auto line { contents.substr (std::min (static_cast<std::size_t> (offset), contents.size())) };

    return line.substr (0, std::min (line.find (static_cast<char> (Chars::newline)), line.size()));
}

```
```applyToDirectiveWords
static void applyToDirectiveWords (std::string_view line, const std::function<void (std::string_view word)>& function)
{
    const auto isWordCharacter { [line] (std::size_t position)
    {
        return std::isalnum (static_cast<unsigned char> (line.at (position))) != 0 or line.at (position) == static_cast<char> (Chars::underscore);
    } };
    std::size_t position { 0 };

    while (position < line.size())
    {
        if (isWordCharacter (position))
        {
            const auto start { position };

            while (position < line.size() and isWordCharacter (position))
                ++position;

            if (std::isdigit (static_cast<unsigned char> (line.at (start))) == 0)
                function (line.substr (start, position - start));
        }
        else
            ++position;
    }
}

```
```getDirectiveKeyword
static std::string_view getDirectiveKeyword (std::string_view line)
{
    std::string_view keyword;

    applyToDirectiveWords (line, [&keyword] (std::string_view word)
    {
        if (keyword.empty()) keyword = word;
    });

    return keyword;
}

```
```getOpeningDirective
static std::string_view getOpeningDirective (std::string_view contents, unsigned offset)
{
    int depth { 0 };
    std::size_t end { std::min (static_cast<std::size_t> (offset), contents.size()) };

    while (end > 0)
    {
        const auto newline { contents.rfind (static_cast<char> (Chars::newline), end - 1) };
        const std::size_t lineStart { newline == std::string_view::npos ? 0 : newline + 1 };
        const auto line { contents.substr (lineStart, end - lineStart) };

        if (isDirective (line, ToolchainWord::endDirective))
            ++depth;
        else if (isDirective (line, ToolchainWord::conditionalDirective))
        {
            if (depth == 0) return line;

            --depth;
        }

        end = lineStart == 0 ? 0 : lineStart - 1;
    }

    return {};
}

```
```addSkippedDirectives
static unsigned addSkippedDirectives (IndexContext& mainContext, const ling::WordLists& keptRanges, ling::Texts& directiveTexts, ling::WordMap& directiveEntries)
{
    unsigned platformMask { 0 };

    keptRanges.applyToKeys ([&mainContext, &keptRanges, &directiveTexts, &directiveEntries, &platformMask] (unsigned long long pathKey)
    {
        const auto contents { mainContext.getFileContents (getSourceFile (mainContext.pathFiles.at (pathKey))) };

        for (int position { 0 }; position < keptRanges.getSize (pathKey); ++position)
        {
            const auto range { keptRanges.at (pathKey, position) };
            const auto start { static_cast<unsigned> (ling::HalfWords::unpackFirst (range)) };
            const auto line { getDirectiveLine (contents, start) };
            const auto keyword { getDirectiveKeyword (line) };

            if (getConditionActions().contains (keyword))
            {
                const auto action { static_cast<ConditionAction> (getConditionActions().at (keyword)) };
                const auto sourceLine { action == ConditionAction::invert ? getOpeningDirective (contents, start) : line };

                applyToDirectiveWords (sourceLine, [&platformMask] (std::string_view word)
                {
                    if (getPlatformMacros().contains (word))
                        platformMask |= 1u << static_cast<unsigned> (getPlatformMacros().at (word));
                });

                directiveEntries.add (ling::Wyhash::mix (pathKey, range), ling::HalfWords::pack (directiveTexts.add (std::string (sourceLine)), static_cast<int> (action)));
            }
        }
    });

    return platformMask;
}

```
```addConditionFlags
static void addConditionFlags (ling::Texts& flagTexts, ling::Words& flagIndices, std::string_view line, ConditionAction action)
{
    const std::string_view prefix { action == ConditionAction::define ? ToolchainWord::defineFlag : ToolchainWord::undefineFlag };
    const auto keyword { getDirectiveKeyword (line) };

    applyToDirectiveWords (line, [line, &flagTexts, &flagIndices, prefix, keyword] (std::string_view word)
    {
        const auto afterWord { static_cast<std::size_t> (word.data() - line.data()) + word.size() };
        const auto nextToken { line.find_first_not_of (static_cast<char> (Chars::space), afterWord) };
        const bool isFunctionLike { nextToken != std::string_view::npos and line.at (nextToken) == static_cast<char> (Chars::openParen) };

        if (word.data() != keyword.data() and word.at (0) != static_cast<char> (Chars::underscore) and not isFunctionLike and word.compare (ToolchainWord::definedOperator) != 0 and not getPlatformMacros().contains (word) and not getIgnoredConditionMacros().contains (word))
            flagIndices.add (static_cast<unsigned long long> (flagTexts.add (std::string (prefix) + std::string (word))));
    });
}

```
```getConditionFlags
static ling::Pointers getConditionFlags (const ling::WordLists& keptRanges, const ling::Texts& directiveTexts, const ling::WordMap& directiveEntries, ling::Texts& flagTexts, bool isInverted)
{
    ling::Words flagIndices;
    ling::Pointers flags;

    keptRanges.applyToKeys ([&keptRanges, &directiveTexts, &directiveEntries, &flagTexts, &flagIndices, isInverted] (unsigned long long pathKey)
    {
        for (int position { 0 }; position < keptRanges.getSize (pathKey); ++position)
        {
            const auto key { ling::Wyhash::mix (pathKey, keptRanges.at (pathKey, position)) };

            if (directiveEntries.contains (key))
            {
                const auto entry { directiveEntries.at (key) };
                const auto line { directiveTexts.get (ling::HalfWords::unpackFirst (entry)) };
                const auto action { static_cast<ConditionAction> (ling::HalfWords::unpackSecond (entry)) };

                if (isInverted and action == ConditionAction::invert)
                {
                    const auto openingKeyword { getDirectiveKeyword (line) };

                    if (getConditionActions().contains (openingKeyword))
                        addConditionFlags (flagTexts, flagIndices, line, static_cast<ConditionAction> (getConditionActions().at (openingKeyword)) == ConditionAction::define ? ConditionAction::undefine : ConditionAction::define);
                }
                else if (not isInverted and action != ConditionAction::invert)
                    addConditionFlags (flagTexts, flagIndices, line, action);
            }
        }
    });

    for (int position { 0 }; position < flagIndices.size(); ++position)
        flags.add (flagTexts.getPointer (static_cast<int> (flagIndices.at (position))));

    return flags;
}

```
```applyToTranslationUnit
static int applyToTranslationUnit (const IndexSession& session, const ling::Pointers& commandLine, UnsavedFile* unsavedFiles, int bufferCount, unsigned options, IndexContext& context, const std::function<int (TranslationUnit translationUnit)>& function)
{
    const auto& libclang { *session.libclang };
    TranslationUnit translationUnit { nullptr };
    auto indexerCallbacks { getIndexerCallbacks() };
    int result { 0 };
    const bool usesPrecompiled { std::any_of (commandLine.begin(), commandLine.begin() + commandLine.size(), [] (const char* argument) { return std::string_view (argument).compare (ToolchainWord::precompiledIncludeFlag) == 0; }) };

    if (bufferCount == 0 and not usesPrecompiled)
        result = libclang.indexSourceFileFullArgv (session.action.get(), &context, &indexerCallbacks, static_cast<unsigned> (sizeof (IndexerCallbacks)), indexOptions, nullptr, commandLine.begin(), commandLine.size(), nullptr, 0, &translationUnit, options);
    else
    {
        result = libclang.parseTranslationUnit2FullArgv (session.indexHandle.get(), nullptr, commandLine.begin(), commandLine.size(), unsavedFiles, static_cast<unsigned> (bufferCount), options, &translationUnit);

        if (result == 0 and translationUnit != nullptr)
        {
            const std::unique_ptr<void, decltype (LibClang::disposeIndexAction)> localAction { libclang.createIndexAction (session.indexHandle.get()), libclang.disposeIndexAction };

            context.translationUnit = translationUnit;
            result = libclang.indexTranslationUnit (localAction.get(), &context, &indexerCallbacks, static_cast<unsigned> (sizeof (IndexerCallbacks)), indexOptions, translationUnit);
        }
    }

    const std::unique_ptr<void, decltype (LibClang::disposeTranslationUnit)> unit { translationUnit, libclang.disposeTranslationUnit };

    if (result == 0 and translationUnit != nullptr)
    {
        context.translationUnit = translationUnit;
        result = function (translationUnit);
    }

    return result;
}

```
```addContextPass
static ling::WordLists addContextPass (const IndexSession& session, const ling::Pointers& commandLine, const LanguageCallbacks& callbacks, UnsavedFile* unsavedFiles, int bufferCount, ling::WordLists keptRanges)
{
    const auto& libclang { *session.libclang };
    IndexContext context { libclang, callbacks, nullptr };
    ling::WordLists remaining;

    context.keptRanges = std::move (keptRanges);

    const int result { applyToTranslationUnit (session, commandLine, unsavedFiles, bufferCount, contextOptions, context, [&libclang, &context, &remaining] (TranslationUnit translationUnit)
    {
        addCallPassings (libclang, context, translationUnit);
        addHovers (libclang, context);
        addChosenSymbols (libclang, context);
        remaining = getRemainingRanges (context.keptRanges, getSkippedRanges (libclang, context));
        return 0;
    }) };

    return result == 0 and context.translationUnit != nullptr ? std::move (remaining) : std::move (context.keptRanges);
}

```
```addContextPasses
static void addContextPasses (const IndexSession& session, const ling::Pointers& commandLine, const LanguageCallbacks& callbacks, UnsavedFile* unsavedFiles, int bufferCount, ling::WordLists keptRanges, const ling::Texts& directiveTexts, const ling::WordMap& directiveEntries, unsigned platformMask)
{
    for (const int platform : { platformMac, platformWindows, platformLinux })
    {
        if (platform != currentPlatform and (platformMask & (1u << static_cast<unsigned> (platform))) != 0 and not keptRanges.isEmpty())
        {
            ling::Pointers flags;

            flags.add (static_cast<const char*> (getPlatformTargets().getAddress (platform)));
            keptRanges = addContextPass (session, getContextCommandLine (commandLine, flags, false), callbacks, unsavedFiles, bufferCount, std::move (keptRanges));
        }
    }

    for (const bool isInverted : { false, true })
    {
        if (not keptRanges.isEmpty())
        {
            ling::Texts flagTexts;
            const auto flags (getConditionFlags (keptRanges, directiveTexts, directiveEntries, flagTexts, isInverted));

            if (flags.size() > 0)
                keptRanges = addContextPass (session, getContextCommandLine (commandLine, flags, true), callbacks, unsavedFiles, bufferCount, std::move (keptRanges));
        }
    }
}

```
```indexSource
static int indexSource (const IndexSession& session, const ling::Pointers& commandLine, const LanguageCallbacks& callbacks, const char* directory, const std::string& precompiledPath, const char* const* bufferPaths, const char* const* bufferTexts, int bufferCount)
{
    const auto& libclang { *session.libclang };
    const auto options { precompiledPath.empty() ? translationUnitOptions : translationUnitOptions | precompiledOptions };
    const auto unsavedFiles { std::make_unique<UnsavedFile[]> (static_cast<size_t> (bufferCount)) };

    for (int i { 0 }; i < bufferCount; ++i)
    {
        unsavedFiles[i].filename = bufferPaths[i];
        unsavedFiles[i].contents = bufferTexts[i];
        unsavedFiles[i].length = static_cast<unsigned long> (std::strlen (bufferTexts[i]));
    }

    int result { 0 };
    ling::WordLists keptRanges;
    ling::Texts directiveTexts;
    ling::WordMap directiveEntries;
    unsigned platformMask { 0 };

    {
        IndexContext context { libclang, callbacks, nullptr };

        assert (callbacks.isForeign != nullptr);

        result = applyToTranslationUnit (session, commandLine, unsavedFiles.get(), bufferCount, options, context, [&libclang, &context, &commandLine, directory, &precompiledPath, &keptRanges, &directiveTexts, &directiveEntries, &platformMask] (TranslationUnit translationUnit)
        {
            const int saveResult { precompiledPath.empty() ? 0 : libclang.saveTranslationUnit (translationUnit, precompiledPath.c_str(), libclang.defaultSaveOptions (translationUnit)) };

            if (saveResult == 0)
            {
                addUnitRecords (libclang, context, commandLine, directory, translationUnit);
                keptRanges = getSkippedRanges (libclang, context);
                platformMask = addSkippedDirectives (context, keptRanges, directiveTexts, directiveEntries);
            }

            return saveResult;
        });
    }

    if (result == 0 and not keptRanges.isEmpty())
        addContextPasses (session, commandLine, callbacks, unsavedFiles.get(), bufferCount, std::move (keptRanges), directiveTexts, directiveEntries, platformMask);

    return result;
}

