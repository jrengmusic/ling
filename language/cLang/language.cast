```addPrerequisites
static void addPrerequisites (ling::Texts& texts, ling::Words& unitRows, ling::WordLists& unitArguments, const ling::TextMap& outputs, const char* cacheDirectory, ling::WordLists& prerequisites)
{
    outputs.applyToEntries ([&texts, &unitRows, &unitArguments, cacheDirectory] (std::string_view output, unsigned long long producer)
    {
        setCachePath (texts, unitRows, unitArguments, static_cast<int> (producer), getCachePath (cacheDirectory, std::string (output)));
    });

    for (int unit { 0 }; unit < unitRows.size() / unitStride; ++unit)
    {
        const auto key { static_cast<unsigned long long> (unit) };
        const std::string unitDirectory { texts.get (ling::HalfWords::unpackSecond (unitRows.at (unit * unitStride))) };

        for (int position { 0 }; position < unitArguments.getSize (key); ++position)
        {
            const auto argumentPath { getNormalPath ((std::filesystem::path (unitDirectory) / std::string (texts.get (static_cast<int> (unitArguments.at (key, position))))).string()) };

            if (outputs.contains (argumentPath) and static_cast<int> (outputs.at (argumentPath)) != unit)
            {
                prerequisites.add (key, outputs.at (argumentPath));
                unitArguments.set (key, position, static_cast<unsigned long long> (texts.add (getCachePath (cacheDirectory, argumentPath))));
            }
        }
    }
}

