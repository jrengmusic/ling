```setCachePath
static void setCachePath (ling::Texts& texts, ling::Words& unitRows, ling::WordLists& unitArguments, int producer, const std::string& cachePath)
{
    const auto cacheText { texts.add (cachePath) };
    const auto outputPosition { getFlagPosition (texts, unitArguments, producer, ToolchainWord::outputFlag) };

    assert (outputPosition != invalidPosition);
    unitRows.set (producer * unitStride + 1, ling::HalfWords::pack (cacheText, 0));
    unitArguments.set (static_cast<unsigned long long> (producer), outputPosition, static_cast<unsigned long long> (cacheText));
}

