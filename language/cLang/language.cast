static bool isSameText (std::string_view first, std::string_view second)
{
    return first.size() == second.size() and std::equal (first.begin(), first.end(), second.begin(), [] (char firstCharacter, char secondCharacter) { return std::tolower (static_cast<unsigned char> (firstCharacter)) == std::tolower (static_cast<unsigned char> (secondCharacter)); });
}

