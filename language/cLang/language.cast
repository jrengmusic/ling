```addDependencies
static void addDependencies (const char* const* row, int argumentCount, const char* directory, ling::Texts& texts, const ling::Words& unitRows, const ling::TextMap& outputs, ling::WordLists& dependencies, const LanguageCallbacks& callbacks)
{
    const auto buildDirectory { getNormalPath ((std::filesystem::path (directory) / std::string (getFlagValue (row + 1, row + argumentCount, ToolchainWord::flagDependencyDirectory))).string()) };
    std::string commandLine { getQuoted (row[0]) };

    for (int position { 1 }; position < argumentCount; ++position)
        commandLine += static_cast<char> (Chars::space) + getQuoted (std::string_view (row[position - 1]).compare (ToolchainWord::flagDependencyDirectory) == 0 ? buildDirectory : std::string (row[position]));

    commandLine += static_cast<char> (Chars::space) + std::string (ToolchainWord::dependencyFlag);

    if (const auto output { getCommandOutput (commandLine, directory) }; output.has_value())
    {
        for (std::size_t position { 0 }; position < output->size();)
            position = addRecord (texts, dependencies, *output, position, buildDirectory, outputs);

        for (int unit { 0 }; unit < unitRows.size() / unitStride; ++unit)
            if (not dependencies.contains (static_cast<unsigned long long> (unit)))
                callbacks.addMessage (callbacks.context, (std::string (texts.get (ling::HalfWords::unpackFirst (unitRows.at (unit * unitStride)))) + ToolchainWord::messageSeparator + ToolchainWord::dependenciesNotFound).c_str());

        callbacks.addBuildFile (callbacks.context, getNormalPath ((std::filesystem::path (buildDirectory) / ToolchainWord::dependencyRecord).string()).c_str());
    }
    else
    {
        callbacks.addMessage (callbacks.context, (commandLine + ToolchainWord::messageSeparator + ToolchainWord::toolchainFailed).c_str());
    }
}

```
```addRecord
static std::size_t addRecord (ling::Texts& texts, ling::WordLists& dependencies, const std::string& record, std::size_t position, const std::string& buildDirectory, const ling::TextMap& outputs)
{
    const auto headEnd { std::min (record.find (static_cast<char> (Chars::newline), position), record.size()) };
    const std::string head { record.substr (position, headEnd - position) };
    const auto outputEnd { head.find (ToolchainWord::dependencyHead) };
    const auto unitOutput { outputEnd != std::string::npos ? getNormalPath ((std::filesystem::path (buildDirectory) / head.substr (0, outputEnd)).string()) : std::string {} };
    const bool isUnit { outputEnd != std::string::npos and outputs.contains (unitOutput) };
    auto lineStart { headEnd + 1 };

    while (lineStart < record.size() and record.at (lineStart) == static_cast<char> (Chars::space))
    {
        const auto lineEnd { std::min (record.find (static_cast<char> (Chars::newline), lineStart), record.size()) };
        const std::string line { record.substr (lineStart, lineEnd - lineStart) };
        const auto pathStart { line.find_first_not_of (static_cast<char> (Chars::space)) };

        if (isUnit)
            dependencies.add (outputs.at (unitOutput), static_cast<unsigned long long> (texts.add (getNormalPath ((std::filesystem::path (buildDirectory) / line.substr (pathStart)).string()))));

        lineStart = lineEnd + 1;
    }

    return lineStart;
}

```
```getFlagValue
static std::string_view getFlagValue (const char* const* begin, const char* const* end, std::string_view flag)
{
    const auto flagPosition { std::find_if (begin, end, [flag] (std::string_view argument) { return argument.compare (flag) == 0; }) };

    if (flagPosition != end and std::next (flagPosition) != end)
        return *std::next (flagPosition);

    return {};
}

```
```getFieldValue
static std::string_view getFieldValue (std::string_view declaration, const char* field)
{
    const std::string_view fieldName { field };
    const auto fieldStart { declaration.find (fieldName) };
    const auto valueStart { fieldStart != std::string_view::npos ? fieldStart + fieldName.size() : declaration.size() };
    const auto valueEnd { std::min (declaration.find (static_cast<char> (Chars::newline), valueStart), declaration.size()) };
    const std::string_view line { declaration.substr (valueStart, valueEnd - valueStart) };
    const std::string blanks { static_cast<char> (Chars::space), static_cast<char> (Chars::tab), static_cast<char> (Chars::carriageReturn) };
    const auto first { line.find_first_not_of (blanks) };
    const auto last { line.find_last_not_of (blanks) };

    return first != std::string_view::npos ? line.substr (first, last - first + 1) : std::string_view {};
}

```
```getFlagPosition
static int getFlagPosition (const ling::Texts& texts, const ling::WordLists& unitArguments, int unit, std::string_view flag)
{
    const auto key { static_cast<unsigned long long> (unit) };

    for (int position { 0 }; position + 1 < unitArguments.getSize (key); ++position)
        if (texts.get (static_cast<int> (unitArguments.at (key, position))).compare (flag) == 0) return position + 1;

    return invalidPosition;
}

```
```applyToRows
static void applyToRows (const char* const* arguments, const int* argumentCounts, int rowCount, const std::function<void (const char* const* row, int argumentCount)>& function)
{
    int offset { 0 };

    for (int rowIndex { 0 }; rowIndex < rowCount; ++rowIndex)
    {
        function (arguments + offset, argumentCounts[rowIndex]);
        offset += argumentCounts[rowIndex];
    }
}

