```getHoverParameters
static std::string getHoverParameters (IndexContext& context, Cursor cursor)
{
    const char space { static_cast<char> (Chars::space) };
    const char newline { static_cast<char> (Chars::newline) };
    const std::string defaultMarker (space + std::string (HoverLabel::defaultValue) + space);
    std::string parameters;

    const auto canonical { context.libclang.getCanonicalCursor (cursor) };

    for (int index { 0 }; index < context.libclang.getNumArguments (cursor); ++index)
    {
        const auto parameter { context.libclang.getArgument (cursor, static_cast<unsigned> (index)) };
        const auto canonicalParameter { context.libclang.getArgument (canonical, static_cast<unsigned> (index)) };
        const auto parameterType { context.libclang.getCursorType (parameter) };
        const auto aka { getHoverDesugaredType (context.libclang, parameterType) };
        auto name { getText (context.libclang, context.libclang.getCursorSpelling (parameter)) };

        if (name.empty()) name = getText (context.libclang, context.libclang.getCursorSpelling (canonicalParameter));

        const auto definitionRange { context.libclang.getCursorExtent (canonicalParameter) };
        SourceFile definitionFile { nullptr };
        unsigned definitionStart { 0 };
        unsigned definitionEnd { 0 };

        context.libclang.getSpellingLocation (context.libclang.getRangeStart (definitionRange), &definitionFile, nullptr, nullptr, &definitionStart);
        context.libclang.getSpellingLocation (context.libclang.getRangeEnd (definitionRange), nullptr, nullptr, nullptr, &definitionEnd);

        context.addPreprocessedFile (definitionFile);
        const auto contents { definitionFile != nullptr ? context.getFileContents (definitionFile) : std::string_view {} };
        const std::string_view definition { definitionEnd <= contents.size() and definitionStart <= definitionEnd ? contents.substr (definitionStart, definitionEnd - definitionStart) : std::string_view {} };
        const auto defaultStart { definition.find (defaultMarker) };

        parameters += (parameters.empty() ? std::string() : std::string (1, newline)) + HoverLabel::bullet + space + getHoverType (context.libclang, parameterType, false);
        parameters += name.empty() ? std::string() : space + name;
        parameters += defaultStart == std::string::npos ? std::string() : std::string (definition.substr (defaultStart));
        parameters += aka.empty() ? std::string() : space + std::string (HoverLabel::akaOpen) + space + aka + HoverLabel::akaClose;
    }

    return parameters;
}

```
```getHoverDesugaredType
static std::string getHoverDesugaredType (const LibClang& libclang, ValueType type)
{
    const char space { static_cast<char> (Chars::space) };
    bool isAka { false };
    bool isConst { false };
    bool isVolatile { false };
    bool isDesugaring { true };

    while (isDesugaring)
    {
        const auto underlying { type.type == ValueCategory::typeDefinition ? libclang.getTypedefDeclUnderlyingType (libclang.getTypeDeclaration (type)) : type };
        const bool isOpaque { underlying.type == ValueCategory::vector or underlying.type == ValueCategory::extendedVector or (underlying.type == ValueCategory::record and libclang.isAnonymous (libclang.getTypeDeclaration (underlying)) != 0) };

        isConst = isConst or libclang.isConstQualifiedType (type) != 0;
        isVolatile = isVolatile or libclang.isVolatileQualifiedType (type) != 0;

        if (type.type == ValueCategory::elaborated) type = libclang.getNamedType (type);
        else if (type.type == ValueCategory::attributed) type = libclang.getModifiedType (type);
        else if (type.type == ValueCategory::typeDefinition and not isOpaque) { type = underlying; isAka = true; }
        else isDesugaring = false;
    }

    const bool isPointerLike { type.type == ValueCategory::pointer or type.type == ValueCategory::lValueReference or type.type == ValueCategory::rValueReference };
    const auto pointee { isPointerLike ? getHoverDesugaredType (libclang, libclang.getPointeeType (type)) : std::string() };
    const char* suffix { type.type == ValueCategory::pointer ? HoverLabel::akaPointer : type.type == ValueCategory::lValueReference ? HoverLabel::akaReference : HoverLabel::akaRvalueReference };
    const auto text { pointee.empty() ? getText (libclang, libclang.getTypeSpelling (libclang.getUnqualifiedType (type))) : pointee + space + suffix };
    const auto qualifiers { (isConst ? std::string (HoverLabel::passedConst) + space : std::string()) + (isVolatile ? std::string (HoverLabel::volatileQualifier) + space : std::string()) };

    return isAka or not pointee.empty() ? qualifiers + text : std::string();
}

```
```getHoverType
static std::string getHoverType (const LibClang& libclang, ValueType type, bool isAkaShown)
{
    const char space { static_cast<char> (Chars::space) };
    const bool isTag { type.type == ValueCategory::record or type.type == ValueCategory::enumeration };
    const bool isQualified { libclang.isConstQualifiedType (type) != 0 or libclang.isVolatileQualifiedType (type) != 0 or libclang.isRestrictQualifiedType (type) != 0 };
    const auto spelling { getText (libclang, libclang.getTypeSpelling (type)) };
    const auto aka { isAkaShown ? getHoverDesugaredType (libclang, type) : std::string() };
    const auto text { isTag and not isQualified ? std::string (getHoverWord (libclang, libclang.getTypeDeclaration (type))) + space + spelling : spelling };

    return aka.empty() ? text : text + space + HoverLabel::akaOpen + space + aka + HoverLabel::akaClose;
}

```
```getHoverName
static std::string getHoverName (const LibClang& libclang, Cursor cursor)
{
    const auto lexicalParent { libclang.getCursorLexicalParent (cursor) };
    const bool isSpecialization { static_cast<HoverScope> (hoverScopes[libclang.getCursorKind (cursor)]) == HoverScope::record and libclang.isInvalid (static_cast<int> (libclang.getSpecializedCursorTemplate (cursor).type)) == 0 };
    std::string qualifier;

    for (auto parent { libclang.getCursorSemanticParent (cursor) }; libclang.equalCursors (parent, lexicalParent) == 0 and libclang.isInvalid (static_cast<int> (parent.type)) == 0 and parent.type != CursorType::translationUnit; parent = libclang.getCursorSemanticParent (parent))
        qualifier = getText (libclang, libclang.getCursorSpelling (parent)) + HoverLabel::scopeSeparator + qualifier;

    return qualifier + getText (libclang, isSpecialization ? libclang.getCursorDisplayName (cursor) : libclang.getCursorSpelling (cursor));
}

