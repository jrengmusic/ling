```getSnippetParameters
static std::string getSnippetParameters (const LibClang& libclang, Cursor cursor)
{
    std::string parameters;

    for (int index { 0 }; index < libclang.getNumArguments (cursor); ++index)
    {
        const auto parameter { libclang.getArgument (cursor, static_cast<unsigned> (index)) };

        if (index > 0)
            parameters += ", ";

        parameters += "${" + std::to_string (index + 1) + ":" + getText (libclang, libclang.getCursorSpelling (parameter)) + "}";
    }

    return parameters;
}

