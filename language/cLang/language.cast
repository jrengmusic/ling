```isSelfContained
static bool isSelfContained (const IndexContext& context, SourceFile file)
{
    const std::string_view includeWord { ToolchainWord::includeWord };
    bool isDontIncludeMe { false };
    std::string_view content { context.getFileContents (file).substr (0, ToolchainValue::sniffByteCount) };

    for (int index { 0 }; index < ToolchainValue::sniffLineCount and not content.empty() and not isDontIncludeMe; ++index)
    {
        const auto line { content.substr (0, std::min (content.find (static_cast<char> (Chars::newline)), content.size())) };

        content.remove_prefix (std::min (line.size() + 1, content.size()));

        const auto next { content.substr (0, std::min (content.find (static_cast<char> (Chars::newline)), content.size())) };
        const auto match { std::search (next.begin(), next.end(), includeWord.begin(), includeWord.end(), [] (char first, char second) { return std::tolower (static_cast<unsigned char> (first)) == std::tolower (static_cast<unsigned char> (second)); }) };

        isDontIncludeMe = isDirective (line, ToolchainWord::conditionalDirective) and isDirective (next, ToolchainWord::errorDirective) and match != next.end();
    }

    return context.libclang.isFileMultipleIncludeGuarded (context.translationUnit, file) != 0 and not isDontIncludeMe;
}

