```getOrCreateProvider
static int getOrCreateProvider (const LibClang& libclang, IndexContext& context, Cursor cursor, unsigned long long symbol, SourceFile mainFile)
{
    const auto key { ling::Wyhash::mix (symbol, getFileWord (mainFile)) };

    if (context.providers.contains (key)) return static_cast<int> (context.providers.at (key));

    const auto textIndex { context.texts.add (getHoverProvider (libclang, context, cursor, symbol, mainFile)) };

    context.providers.add (key, static_cast<unsigned long long> (textIndex));

    return textIndex;
}

