```getTypeHintDeclaration
static std::string getTypeHintDeclaration (const LibClang& libclang, Cursor cursor)
{
    static const ling::Words typeHintPrinting {
:::[list]:::
    };

    const auto policy { libclang.getCursorPrintingPolicy (cursor) };

    for (const auto word : typeHintPrinting)
        libclang.setPrintingPolicyProperty (policy, ling::HalfWords::unpackFirst (word), static_cast<unsigned> (ling::HalfWords::unpackSecond (word)));

    const auto declaration { getText (libclang, libclang.getCursorPrettyPrinted (cursor, policy)) };

    libclang.disposePrintingPolicy (policy);

    return declaration;
}

