```getCursor
static Cursor getCursor (const ling::Words& cursors, int position)
{
    const auto row { position * cursorStride };

    return Cursor { static_cast<CursorType> (ling::HalfWords::unpackFirst (cursors.at (row))), ling::HalfWords::unpackSecond (cursors.at (row)),
                    { reinterpret_cast<const void*> (static_cast<std::uintptr_t> (cursors.at (row + 1))), reinterpret_cast<const void*> (static_cast<std::uintptr_t> (cursors.at (row + 2))), reinterpret_cast<const void*> (static_cast<std::uintptr_t> (cursors.at (row + 3))) } };
}

