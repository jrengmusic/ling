```getRankedHeaders
static ling::Words getRankedHeaders (const LibClang& libclang, const IndexContext& context, Cursor cursor, unsigned long long symbol, SourceFile mainFile)
{
    ling::Words headers;
    const auto* standardHeader { getStandardHeader (libclang, cursor) };
    const auto symbolName { getText (libclang, libclang.getCursorSpelling (cursor)) };

    if (standardHeader != nullptr)
    {
        headers.add (static_cast<unsigned long long> (HeaderHint::publicHeader | HeaderHint::origin | HeaderHint::preferred | HeaderHint::complete));
        headers.add (getFileWord (nullptr));
        headers.add (static_cast<unsigned long long> (reinterpret_cast<std::uintptr_t> (standardHeader)));
    }
    else
    {
        for (int position { 0 }; position < context.declarationFiles.getSize (symbol); position += declarationFileStride)
            addPhysicalHeaders (context, headers, getSourceFile (context.declarationFiles.at (symbol, position)), context.declarationFiles.at (symbol, position + 1) != 0, mainFile);
    }

    for (int position { 0 }; position < headers.size(); position += headerStride)
    {
        const auto file { getSourceFile (headers.at (position + 1)) };

        if (file != nullptr and (headers.at (position) & HeaderHint::origin) != 0 and isPreferredHeader (libclang, file, symbolName)) headers.set (position, headers.at (position) | HeaderHint::preferred);
    }

    ling::Words order;

    for (int position { 0 }; position < headers.size() / headerStride; ++position)
        order.add (static_cast<unsigned long long> (position));

    order.sort ([&libclang, &headers] (unsigned long long first, unsigned long long second)
    {
        const auto firstHint { headers.at (static_cast<int> (first) * headerStride) };
        const auto secondHint { headers.at (static_cast<int> (second) * headerStride) };
        const auto firstFile { getSourceFile (headers.at (static_cast<int> (first) * headerStride + 1)) };
        const auto secondFile { getSourceFile (headers.at (static_cast<int> (second) * headerStride + 1)) };

        return firstHint != secondHint ? firstHint > secondHint : getText (libclang, libclang.getFileName (firstFile)) < getText (libclang, libclang.getFileName (secondFile));
    });

    ling::Words rankedHeaders;

    for (int position { 0 }; position < order.size(); ++position)
        for (int index { 0 }; index < headerStride; ++index)
            rankedHeaders.add (headers.at (static_cast<int> (order.at (position)) * headerStride + index));

    return rankedHeaders;
}

