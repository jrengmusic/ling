```getDepthChange
static int getDepthChange (std::string_view source, const Token& token)
{
    static const ling::LookupTable depthChanges {
        {
:::[list]:::
        }
    };

    return token.type == map::SyntaxTokenType::punctuation ? depthChanges[source.at (token.start)] : 0;
}

```
```getPreludeEnd
static int getPreludeEnd (std::string_view source, const ling::Tokens& tokens, int position, int end)
{
    int depth { 0 };

    for (int index { position }; index < end; ++index)
    {
        const auto& token { tokens.at (index) };

        if (depth == 0 and (isPunctuation (source, token, Chars::semicolon) or isPunctuation (source, token, Chars::openBrace)))
            return index;

        depth = std::max (0, depth + getDepthChange (source, token));
    }

    return end;
}

```
```getBlockEnd
static int getBlockEnd (std::string_view source, const ling::Tokens& tokens, int blockStart, int end)
{
    int depth { 0 };

    for (int index { blockStart }; index < end; ++index)
    {
        depth += getDepthChange (source, tokens.at (index));

        if (depth == 0)
            return index;
    }

    return end;
}

```
```getBlockClose
static int getBlockClose (std::string_view source, const ling::Tokens& tokens, int open, int end)
{
    const auto blockEnd { getBlockEnd (source, tokens, open, end) };

    return (open < end and isPunctuation (source, tokens.at (open), Chars::openBrace) and blockEnd < end) ? blockEnd : invalidPosition;
}

```
```getBaseStart
static int getBaseStart (std::string_view source, const ling::Tokens& tokens, int start, int end)
{
    for (int index { start }; index < end; ++index)
        if (isSingleColon (source, tokens, index, start, end))
            return index;

    return end;
}

```
```getCandidateEnd
static int getCandidateEnd (std::string_view source, const ling::Tokens& tokens, int start, int end)
{
    int depth { 0 };

    for (int index { start }; index < end; ++index)
    {
        if (depth == 0 and (isPunctuation (source, tokens.at (index), Chars::semicolon) or isSingleColon (source, tokens, index, start, end)))
            return index;

        depth += getDepthChange (source, tokens.at (index));
    }

    return end;
}

```
```getListItemEnd
static int getListItemEnd (std::string_view source, const ling::Tokens& tokens, int start, int end)
{
    int depth { 0 };

    for (int index { start }; index < end; ++index)
    {
        if (depth == 0 and isPunctuation (source, tokens.at (index), Chars::comma))
            return index;

        depth += getDepthChange (source, tokens.at (index));
    }

    return end;
}

