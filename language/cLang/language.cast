```addSearchDirectories
static void addSearchDirectories (IndexContext& context, const ling::Pointers& commandLine, const char* directory)
{
    static const ling::LookupTable searchRanks {
        {
:::[list]:::
        }
    };

    const std::filesystem::path workingDirectory (directory);
    const std::string_view sdkFlag { getSdkFlags().contains (currentPlatform) ? std::string_view (static_cast<const char*> (getSdkFlags().getAddress (currentPlatform))) : std::string_view {} };
    std::string sysroot;

    for (int position { 0 }; position < commandLine.size(); ++position)
    {
        const std::string_view argument { commandLine.at (position) };
        const std::string_view next { position + 1 < commandLine.size() ? std::string_view (commandLine.at (position + 1)) : std::string_view {} };

        getSearchFlags().applyToEntries ([&argument, &context, &next, &workingDirectory] (std::string_view key, unsigned long long word)
        {
            if (argument.compare (0, key.size(), key) == 0) addSearchDirectory (context, workingDirectory, argument.size() > key.size() ? argument.substr (key.size()) : next, static_cast<int> (word));
        });

        if (not sdkFlag.empty() and argument.compare (sdkFlag) == 0) sysroot = next;
    }

    if (not sysroot.empty())
    {
        addSearchDirectory (context, workingDirectory, (std::filesystem::path (sysroot) / ToolchainWord::sdkIncludeDirectory).string(), SearchGroup::system);
        addSearchDirectory (context, workingDirectory, (std::filesystem::path (sysroot) / ToolchainWord::sdkFrameworkDirectory).string(), SearchGroup::systemFramework);
    }

    context.searchDirectories.sort ([] (unsigned long long first, unsigned long long second)
    {
        return searchRanks[ling::HalfWords::unpackSecond (first)] < searchRanks[ling::HalfWords::unpackSecond (second)];
    });
}

