```getUnbracedBodyEnd
static int getUnbracedBodyEnd (std::string_view source, const ling::Tokens& tokens, int bodyStart, int end)
{
    using BodyEnd = int (*) (std::string_view, const ling::Tokens&, int, int);

    static const ling::AddressTable bodyEnds {
        {
            { 0, reinterpret_cast<const void*> (static_cast<BodyEnd> (getStatementEnd)) },
            { map::CppKeyword::tokenIf, reinterpret_cast<const void*> (static_cast<BodyEnd> (getConditionalEnd)) },
            { map::CppKeyword::tokenDo, reinterpret_cast<const void*> (static_cast<BodyEnd> (getDoLoopEnd)) },
            { map::CppKeyword::tokenFor, reinterpret_cast<const void*> (static_cast<BodyEnd> (getControlEnd)) },
            { map::CppKeyword::tokenWhile, reinterpret_cast<const void*> (static_cast<BodyEnd> (getControlEnd)) },
            { map::CppKeyword::tokenSwitch, reinterpret_cast<const void*> (static_cast<BodyEnd> (getControlEnd)) },
        }
    };

    return bodyStart < end and tokens.at (bodyStart).type == map::SyntaxTokenType::keyword
           ? reinterpret_cast<BodyEnd> (reinterpret_cast<std::uintptr_t> (bodyEnds[tokens.at (bodyStart).key])) (source, tokens, bodyStart, end)
           : getStatementEnd (source, tokens, bodyStart, end);
}

```
```getDoLoopEnd
static int getDoLoopEnd (std::string_view source, const ling::Tokens& tokens, int position, int end)
{
    return getStatementEnd (source, tokens, getBodyEnd (source, tokens, position + 1, end), end);
}

```
```getControlEnd
static int getControlEnd (std::string_view source, const ling::Tokens& tokens, int position, int end)
{
    return getBodyEnd (source, tokens, getControlBodyStart (source, tokens, position, end), end);
}

```
```getStatementStart
static int getStatementStart (std::string_view source, const ling::Tokens& tokens, int candidateStart)
{
    if (candidateStart > 0 and isPunctuation (source, tokens.at (candidateStart - 1), Chars::greaterThan))
    {
        int depth { 0 };
        int open { candidateStart };

        do
        {
            --open;

            if (isPunctuation (source, tokens.at (open), Chars::greaterThan)) ++depth;
            if (isPunctuation (source, tokens.at (open), Chars::lessThan)) --depth;
        }
        while (open > 0 and depth > 0);

        if (depth == 0 and open > 0 and isKeyword (tokens.at (open - 1), map::CppKeyword::tokenTemplate))
            return getStatementStart (source, tokens, open - 1);
    }

    return candidateStart;
}

```
```getLastIdentifierPosition
static int getLastIdentifierPosition (const ling::Tokens& tokens, int start, int end)
{
    for (int index { end - 1 }; index >= start; --index)
        if (tokens.at (index).type == map::SyntaxTokenType::identifier)
            return index;

    return invalidPosition;
}

```
```addStatements
static void addStatements (CLanguageDocument& document, int scope, const ling::Tokens& tokens, int start, int end)
{
    const auto source { document.source };
    const auto& statementConstruction { getStatementConstruction() };
    const auto& punctuationConstruction { getPunctuationConstruction() };
    int position { start };

    while (position < end)
    {
        const auto& token { tokens.at (position) };
        const bool isKeywordToken { token.type == map::SyntaxTokenType::keyword };
        const bool isPunctuationToken { token.type == map::SyntaxTokenType::punctuation };
        const int key { isKeywordToken ? token.key
                        : isPunctuationToken ? static_cast<int> (source.at (token.start))
                        : token.type };

        position = isKeywordToken ? reinterpret_cast<Construction> (reinterpret_cast<std::uintptr_t> (statementConstruction[key])) (key, document, scope, tokens, position, end)
                   : isPunctuationToken ? reinterpret_cast<Construction> (reinterpret_cast<std::uintptr_t> (punctuationConstruction[key])) (key, document, scope, tokens, position, end)
                   : addDeclaration (key, document, scope, tokens, position, end);
    }
}

```
```skipStatement
static int skipStatement (const int&, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto statementEnd { getStatementEnd (document.source, tokens, position, end) };

    addReferences (document, scope, tokens, position, statementEnd, map::SyntaxTokenType::reference);
    return statementEnd;
}

```
```skipTemplateParameters
static int skipTemplateParameters (const int&, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };

    if (position + 1 < end and isPunctuation (source, tokens.at (position + 1), Chars::lessThan))
    {
        int depth { 0 };

        for (int index { position + 1 }; index < end; ++index)
        {
            if (isPunctuation (source, tokens.at (index), Chars::lessThan)) ++depth;
            if (isPunctuation (source, tokens.at (index), Chars::greaterThan)) --depth;

            if (depth == 0)
            {
                addReferences (document, scope, tokens, position + 1, index, map::SyntaxTokenType::reference);
                return index + 1;
            }
        }

        addReferences (document, scope, tokens, position + 1, end, map::SyntaxTokenType::reference);
        return end;
    }

    return position + 1;
}

```
```addBlock
static int addBlock (const int&, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto blockEnd { getBlockEnd (document.source, tokens, position, end) };

    if (isFunctionScope (document, scope))
        addStatements (document, scope, tokens, position + 1, blockEnd);
    else
        addReferences (document, scope, tokens, position + 1, blockEnd, map::SyntaxTokenType::reference);

    return getNextPosition (blockEnd, end);
}

```
```addExtern
static int addExtern (const int& key, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };

    const auto linkage { position + 1 };
    const auto blockStart { linkage + 1 };

    if (blockStart < end and tokens.at (linkage).type == map::SyntaxTokenType::string
        and isPunctuation (source, tokens.at (blockStart), Chars::openBrace))
    {
        const auto blockEnd { getBlockEnd (source, tokens, blockStart, end) };

        addStatements (document, scope, tokens, blockStart + 1, blockEnd);
        return getNextPosition (blockEnd, end);
    }

    return addDeclaration (key, document, scope, tokens, position, end);
}

```
```addNamespace
static int addNamespace (const int& key, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto preludeEnd { getPreludeEnd (source, tokens, position + 1, end) };

    if (preludeEnd < end and isPunctuation (source, tokens.at (preludeEnd), Chars::openBrace))
    {
        const auto blockEnd { getBlockEnd (source, tokens, preludeEnd, end) };
        const auto blockClose { getBlockClose (source, tokens, preludeEnd, end) };
        const auto constructEnd { getNextPosition (blockEnd, end) };
        auto namespaceScope { scope };

        for (int index { position + 1 }; index < preludeEnd; ++index)
        {
            if (tokens.at (index).type == map::SyntaxTokenType::identifier)
            {
                namespaceScope = addElement (document, tokens, namespaceScope, addNameTokens (document, tokens, index, index), map::SyntaxTokenType::namespaceToken, position, constructEnd, preludeEnd, blockClose);
                addComment (document, namespaceScope, tokens, position);
            }
        }

        addStatements (document, namespaceScope, tokens, preludeEnd + 1, blockEnd);
        return constructEnd;
    }

    return skipStatement (key, document, scope, tokens, position, end);
}

```
```addClass
static int addClass (const int& key, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto preludeEnd { getPreludeEnd (source, tokens, position + 1, end) };

    if (preludeEnd < end and isPunctuation (source, tokens.at (preludeEnd), Chars::openBrace))
    {
        const auto baseStart { getBaseStart (source, tokens, position + 1, preludeEnd) };
        const auto namePosition { getLastIdentifierPosition (tokens, position + 1, baseStart) };
        const auto blockEnd { getBlockEnd (source, tokens, preludeEnd, end) };
        const int classType { key == map::CppKeyword::tokenClass ? map::SyntaxTokenType::classToken : map::SyntaxTokenType::structToken };

        if (namePosition != invalidPosition)
        {
            const auto qualifierStart { getQualifierStart (source, tokens, position + 1, namePosition) };
            const auto classElement { addElement (document, tokens, scope, addNameTokens (document, tokens, qualifierStart, namePosition), classType, position, getNextPosition (blockEnd, end), preludeEnd, getBlockClose (source, tokens, preludeEnd, end)) };

            addComment (document, classElement, tokens, position);
            addReferences (document, classElement, tokens, position + 1, qualifierStart, map::SyntaxTokenType::reference);
            addReferences (document, classElement, tokens, namePosition + 1, baseStart, map::SyntaxTokenType::reference);
            addReferences (document, classElement, tokens, baseStart, preludeEnd, map::SyntaxTokenType::base);
            addStatements (document, classElement, tokens, preludeEnd + 1, blockEnd);
        }
        else
        {
            addReferences (document, scope, tokens, baseStart, preludeEnd, map::SyntaxTokenType::base);
            addReferences (document, scope, tokens, preludeEnd + 1, blockEnd, map::SyntaxTokenType::reference);
        }

        return skipStatement (key, document, scope, tokens, blockEnd + 1, end);
    }

    return skipStatement (key, document, scope, tokens, position, end);
}

```
```addEnum
static int addEnum (const int& key, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto preludeEnd { getPreludeEnd (source, tokens, position + 1, end) };

    if (preludeEnd < end and isPunctuation (source, tokens.at (preludeEnd), Chars::openBrace))
    {
        const auto& first { tokens.at (position + 1) };
        int nameIndex { position + 1 };

        if (isKeyword (first, map::CppKeyword::tokenClass) or isKeyword (first, map::CppKeyword::tokenStruct))
            ++nameIndex;

        const auto blockEnd { getBlockEnd (source, tokens, preludeEnd, end) };
        auto constantScope { scope };

        if (nameIndex < preludeEnd and tokens.at (nameIndex).type == map::SyntaxTokenType::identifier)
        {
            constantScope = addElement (document, tokens, scope, addNameTokens (document, tokens, nameIndex, nameIndex), map::SyntaxTokenType::enumToken, position, getNextPosition (blockEnd, end), preludeEnd, getBlockClose (source, tokens, preludeEnd, end));
            addComment (document, constantScope, tokens, position);
        }

        addReferences (document, constantScope, tokens, nameIndex + 1, preludeEnd, map::SyntaxTokenType::reference);
        addEnumConstants (document, constantScope, tokens, preludeEnd + 1, blockEnd);
        return skipStatement (key, document, scope, tokens, blockEnd + 1, end);
    }

    return skipStatement (key, document, scope, tokens, position, end);
}

```
```addEnumConstants
static void addEnumConstants (CLanguageDocument& document, int scope, const ling::Tokens& tokens, int start, int end)
{
    const auto source { document.source };
    int depth { 0 };
    int referenceStart { start };

    for (int index { start }; index < end; ++index)
    {
        const auto& token { tokens.at (index) };

        if (depth == 0 and token.type == map::SyntaxTokenType::identifier
            and (index == start or isPunctuation (source, tokens.at (index - 1), Chars::comma)))
        {
            addReferences (document, scope, tokens, referenceStart, index, map::SyntaxTokenType::reference);
            addComment (document, addElement (document, tokens, scope, addNameTokens (document, tokens, index, index), map::SyntaxTokenType::enumConstant, index, getListItemEnd (source, tokens, index, end), invalidPosition, invalidPosition), tokens, index);
            referenceStart = index + 1;
        }

        depth += getDepthChange (source, token);
    }

    addReferences (document, scope, tokens, referenceStart, end, map::SyntaxTokenType::reference);
}

```
```getControlOpen
static int getControlOpen (std::string_view source, const ling::Tokens& tokens, int position, int end)
{
    int open { position + 1 };

    while (open < end and not isPunctuation (source, tokens.at (open), Chars::openParen)
           and not isPunctuation (source, tokens.at (open), Chars::semicolon)
           and not isPunctuation (source, tokens.at (open), Chars::openBrace))
        ++open;

    return open;
}

```
```getControlBodyStart
static int getControlBodyStart (std::string_view source, const ling::Tokens& tokens, int position, int end)
{
    const auto open { getControlOpen (source, tokens, position, end) };

    return (open < end and isPunctuation (source, tokens.at (open), Chars::openParen))
           ? getNextPosition (getBlockEnd (source, tokens, open, end), end)
           : position + 1;
}

```
```addControl
static int addControl (const int&, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto open { getControlOpen (source, tokens, position, end) };

    if (open < end and isPunctuation (source, tokens.at (open), Chars::openParen))
    {
        const auto close { getBlockEnd (source, tokens, open, end) };
        const auto candidateEnd { getCandidateEnd (source, tokens, open + 1, close) };

        addReferences (document, scope, tokens, position + 1, open, map::SyntaxTokenType::reference);
        addDeclarationCandidate (document, scope, tokens, open + 1, candidateEnd, candidateEnd, invalidPosition, invalidPosition);
        addReferences (document, scope, tokens, candidateEnd, close, map::SyntaxTokenType::reference);
        return getNextPosition (close, end);
    }

    return position + 1;
}

```
```addLoop
static int addLoop (const int& key, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto bodyStart { getControlBodyStart (source, tokens, position, end) };
    const auto bodyClose { getBlockClose (source, tokens, bodyStart, end) };

    addElement (document, tokens, scope, addNameTokens (document, tokens, position, position), map::SyntaxTokenType::loop, position, getBodyEnd (source, tokens, bodyStart, end), bodyClose != invalidPosition ? bodyStart : invalidPosition, bodyClose);
    return addControl (key, document, scope, tokens, position, end);
}

```
```getConditionalEnd
static int getConditionalEnd (std::string_view source, const ling::Tokens& tokens, int position, int end)
{
    const auto bodyEnd { getControlEnd (source, tokens, position, end) };

    if (bodyEnd < end and isKeyword (tokens.at (bodyEnd), map::CppKeyword::tokenElse))
    {
        if (bodyEnd + 1 < end and isKeyword (tokens.at (bodyEnd + 1), map::CppKeyword::tokenIf))
            return getConditionalEnd (source, tokens, bodyEnd + 1, end);

        return getBodyEnd (source, tokens, bodyEnd + 1, end);
    }

    return bodyEnd;
}

```
```addConditional
static int addConditional (const int& key, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };

    if (position >= 1 and isKeyword (tokens.at (position - 1), map::CppKeyword::tokenElse))
        return addControl (key, document, scope, tokens, position, end);

    const auto bodyStart { getControlBodyStart (source, tokens, position, end) };
    const auto bodyClose { getBlockClose (source, tokens, bodyStart, end) };

    addElement (document, tokens, scope, addNameTokens (document, tokens, position, position), map::SyntaxTokenType::conditional, position, getConditionalEnd (source, tokens, position, end), bodyClose != invalidPosition ? bodyStart : invalidPosition, bodyClose);
    return addControl (key, document, scope, tokens, position, end);
}

```
```addDoLoop
static int addDoLoop (const int&, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto bodyStart { position + 1 };
    const auto bodyEnd { getBodyEnd (source, tokens, bodyStart, end) };
    const auto statementEnd { getDoLoopEnd (source, tokens, position, end) };
    const auto bodyClose { getBlockClose (source, tokens, bodyStart, end) };

    addElement (document, tokens, scope, addNameTokens (document, tokens, position, position), map::SyntaxTokenType::loop, position, statementEnd, bodyClose != invalidPosition ? bodyStart : invalidPosition, bodyClose);
    addStatements (document, scope, tokens, bodyStart, bodyEnd);
    addReferences (document, scope, tokens, bodyEnd, statementEnd, map::SyntaxTokenType::reference);
    return statementEnd;
}

```
```addDirective
static int addDirective (const int&, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto row { tokens.at (position).line };
    int directiveEnd { position + 1 };

    while (directiveEnd < end and tokens.at (directiveEnd).line == row)
        ++directiveEnd;

    const auto keywordPosition { position + 1 };
    const auto macroPosition { keywordPosition + 1 };

    if (macroPosition < directiveEnd and isKeyword (tokens.at (keywordPosition), map::CppKeyword::tokenDefine)
        and tokens.at (macroPosition).type == map::SyntaxTokenType::identifier)
        addComment (document, addElement (document, tokens, scope, addNameTokens (document, tokens, macroPosition, macroPosition), map::SyntaxTokenType::macro, position, directiveEnd, invalidPosition, invalidPosition), tokens, position);

    return directiveEnd;
}

```
```addDeclaration
static int addDeclaration (const int&, CLanguageDocument& document, int scope, const ling::Tokens& tokens, int position, int end)
{
    const auto source { document.source };
    const auto preludeEnd { getPreludeEnd (source, tokens, position, end) };
    const auto statementEnd { getStatementEnd (source, tokens, position, end) };
    const auto bodyOpen { getBodyOpen (source, tokens, position, preludeEnd, end) };
    const auto bodyClose { bodyOpen != invalidPosition ? getBlockClose (source, tokens, bodyOpen, end) : invalidPosition };
    const auto element { addDeclarationCandidate (document, scope, tokens, position, preludeEnd, statementEnd, bodyOpen, bodyClose) };

    if (element != invalidPosition and isFunctionScope (document, element) and bodyOpen != invalidPosition)
    {
        const auto blockEnd { getBlockEnd (source, tokens, bodyOpen, end) };

        addReferences (document, element, tokens, preludeEnd, bodyOpen, map::SyntaxTokenType::reference);
        addStatements (document, element, tokens, bodyOpen + 1, blockEnd);
        return getNextPosition (blockEnd, end);
    }

    addReferences (document, getReferenceOwner (document, scope, element), tokens, preludeEnd, statementEnd, map::SyntaxTokenType::reference);

    return statementEnd;
}

```
```getBodyOpen
static int getBodyOpen (std::string_view source, const ling::Tokens& tokens, int position, int preludeEnd, int end)
{
    const auto bodyStart { getBodyStart (source, tokens, position, preludeEnd, end) };

    return (preludeEnd < end and isPunctuation (source, tokens.at (preludeEnd), Chars::openBrace)
            and bodyStart < end and isPunctuation (source, tokens.at (bodyStart), Chars::openBrace))
           ? bodyStart
           : invalidPosition;
}

```
```getBodyStart
static int getBodyStart (std::string_view source, const ling::Tokens& tokens, int position, int preludeEnd, int end)
{
    int depth { 0 };

    for (int index { position }; index < preludeEnd; ++index)
    {
        if (depth == 0 and isSingleColon (source, tokens, index, position, preludeEnd))
        {
            int bodyStart { preludeEnd };

            while (bodyStart < end and isPunctuation (source, tokens.at (bodyStart), Chars::openBrace)
                   and (tokens.at (bodyStart - 1).type == map::SyntaxTokenType::identifier
                        or isPunctuation (source, tokens.at (bodyStart - 1), Chars::greaterThan)))
                bodyStart = getPreludeEnd (source, tokens, getBlockEnd (source, tokens, bodyStart, end) + 1, end);

            return bodyStart;
        }

        depth += getDepthChange (source, tokens.at (index));
    }

    return preludeEnd;
}

```
```addDeclarationCandidate
static int addDeclarationCandidate (CLanguageDocument& document, int scope, const ling::Tokens& tokens, int start, int end, int constructEnd, int bodyOpen, int bodyClose)
{
    const auto source { document.source };
    const auto boundary { getBoundary (source, tokens, start, end) };
    const auto namePosition { getNamePosition (tokens, start, boundary) };

    if (namePosition == invalidPosition and boundary < end and isPunctuation (source, tokens.at (boundary), Chars::openBracket)) return addStructuredBindings (document, scope, tokens, start, boundary, end, constructEnd);

    if (namePosition != invalidPosition)
    {
        const auto qualifierStart { getQualifierStart (source, tokens, start, namePosition) };
        const bool isFunctionShape { boundary < end and isPunctuation (source, tokens.at (boundary), Chars::openParen) };
        const auto type { getDeclarationType (document, scope, tokens, start, boundary, qualifierStart, namePosition, isFunctionShape) };

        if (isDeclaration (source, tokens, start, qualifierStart)
            or type == map::SyntaxTokenType::constructor or type == map::SyntaxTokenType::destructor)
        {
            const bool isFunctionBody { bodyClose != invalidPosition and getTypeScope (type) == map::SyntaxTokenType::function };
            const auto element { addElement (document, tokens, scope, addNameTokens (document, tokens, qualifierStart, namePosition), type, start,
                                            isFunctionBody ? bodyClose + 1 : constructEnd,
                                            isFunctionBody ? bodyOpen : invalidPosition,
                                            isFunctionBody ? bodyClose : invalidPosition) };

            addComment (document, element, tokens, start);
            addReferences (document, getReferenceOwner (document, scope, element), tokens, start, qualifierStart, map::SyntaxTokenType::reference);

            addDeclarationContents (document, scope, element, tokens, namePosition, boundary, end, isFunctionShape, start);
            return element;
        }
    }

    addReferences (document, scope, tokens, start, end, map::SyntaxTokenType::reference);
    return invalidPosition;
}

```
```addStructuredBindings
static int addStructuredBindings (CLanguageDocument& document, int scope, const ling::Tokens& tokens, int start, int boundary, int end, int constructEnd)
{
    const auto source { document.source };
    const auto close { getBlockEnd (source, tokens, boundary, end) };
    int lastElement { invalidPosition };

    addReferences (document, scope, tokens, start, boundary, map::SyntaxTokenType::reference);

    for (int index { boundary + 1 }; index < close; ++index)
    {
        if (tokens.at (index).type == map::SyntaxTokenType::identifier)
        {
            const auto type { getDeclarationType (document, scope, tokens, start, boundary, index, index, false) };

            lastElement = addElement (document, tokens, scope, addNameTokens (document, tokens, index, index), type, start, constructEnd, invalidPosition, invalidPosition);
            addComment (document, lastElement, tokens, start);
        }
    }

    addReferences (document, scope, tokens, close + 1, end, map::SyntaxTokenType::reference);
    return lastElement;
}

```
```addDeclarationContents
static void addDeclarationContents (CLanguageDocument& document, int scope, int element, const ling::Tokens& tokens, int namePosition, int boundary, int end, bool isFunctionShape, int candidateStart)
{
    const auto owner { getReferenceOwner (document, scope, element) };

    if (isFunctionShape)
    {
        const bool hasParameters { not isFunctionScope (document, scope) };
        const auto close { hasParameters ? getBlockEnd (document.source, tokens, boundary, end) : boundary - 1 };

        addReferences (document, owner, tokens, namePosition + 1, boundary, map::SyntaxTokenType::reference);

        if (hasParameters)
            addParameters (document, element, tokens, boundary, close);

        addReferences (document, owner, tokens, close + 1, end, map::SyntaxTokenType::reference);
    }
    else
    {
        addDeclarators (document, scope, element, tokens, namePosition + 1, end, getElementType (document, element), candidateStart);
    }
}

```
```getReferenceOwner
static int getReferenceOwner (const CLanguageDocument& document, int scope, int element)
{
    return element != invalidPosition and not isFunctionScope (document, scope) ? element : scope;
}

```
```getBoundary
static int getBoundary (std::string_view source, const ling::Tokens& tokens, int start, int end)
{
    static const ling::LookupTable comparisonPrefixes {
        {
:::[list]:::
        }
    };

    if (start + 1 < end and isPunctuation (source, tokens.at (start), Chars::openBracket) and isPunctuation (source, tokens.at (start + 1), Chars::openBracket))
        return getBoundary (source, tokens, std::min (getBlockEnd (source, tokens, start, end) + 1, end), end);

    int angleDepth { 0 };

    for (int index { start }; index < end; ++index)
    {
        const auto& token { tokens.at (index) };
        const bool hasPreviousOperator { index > start
                                         and ((tokens.at (index - 1).type == map::SyntaxTokenType::punctuation
                                               and comparisonPrefixes[source.at (tokens.at (index - 1).start)] != 0)
                                              or isKeyword (tokens.at (index - 1), map::CppKeyword::tokenOperator)) };
        const bool hasNextEquals { index + 1 < end and isPunctuation (source, tokens.at (index + 1), Chars::equals) };

        if (index > start and isPunctuation (source, token, Chars::lessThan) and tokens.at (index - 1).type == map::SyntaxTokenType::identifier)
            ++angleDepth;
        else if (angleDepth > 0 and isPunctuation (source, token, Chars::greaterThan))
            --angleDepth;
        else if (angleDepth == 0
                 and (isPunctuation (source, token, Chars::openParen) or isPunctuation (source, token, Chars::openBracket)
                      or (isPunctuation (source, token, Chars::equals) and not hasPreviousOperator and not hasNextEquals)))
            return index;
    }

    return end;
}

```
```getNamePosition
static int getNamePosition (const ling::Tokens& tokens, int start, int boundary)
{
    for (int index { start }; index < boundary; ++index)
        if (isKeyword (tokens.at (index), map::CppKeyword::tokenOperator))
            return index;

    return getLastIdentifierPosition (tokens, start, boundary);
}

```
```getQualifierStart
static int getQualifierStart (std::string_view source, const ling::Tokens& tokens, int start, int namePosition)
{
    int qualifierStart { namePosition };

    if (qualifierStart - 1 >= start and isPunctuation (source, tokens.at (qualifierStart - 1), Chars::tilde))
        --qualifierStart;

    while (qualifierStart - qualifierLength >= start
           and isPunctuation (source, tokens.at (qualifierStart - 1), Chars::colon)
           and isPunctuation (source, tokens.at (qualifierStart - 2), Chars::colon)
           and tokens.at (qualifierStart - qualifierLength).type == map::SyntaxTokenType::identifier)
        qualifierStart -= qualifierLength;

    return qualifierStart;
}

```
```addNameTokens
static int addNameTokens (CLanguageDocument& document, const ling::Tokens& tokens, int qualifierStart, int namePosition)
{
    const auto nameStart { document.nameTokens.size() };

    for (int index { qualifierStart }; index <= namePosition; ++index)
    {
        const auto& token { tokens.at (index) };

        if (index == namePosition or token.type == map::SyntaxTokenType::identifier)
            document.nameTokens.add (Token { token.start, token.end, token.type, -1, 0 });
    }

    return nameStart;
}

```
```isDeclaration
static bool isDeclaration (std::string_view source, const ling::Tokens& tokens, int start, int qualifierStart)
{
    static const ling::LookupTable declaratorBytes {
        {
:::[list]:::
        }
    };

    if (qualifierStart - 1 >= start)
    {
        const auto& previous { tokens.at (qualifierStart - 1) };

        return previous.type == map::SyntaxTokenType::identifier or previous.type == map::SyntaxTokenType::keyword
               or (previous.type == map::SyntaxTokenType::punctuation and declaratorBytes[source.at (previous.start)] != 0);
    }

    return false;
}

```
```isNamedParameter
static bool isNamedParameter (std::string_view source, const ling::Tokens& tokens, int start, int boundary)
{
    return boundary - 1 >= start
           and tokens.at (boundary - 1).type == map::SyntaxTokenType::identifier
           and std::any_of (tokens.begin() + start, tokens.begin() + getQualifierStart (source, tokens, start, boundary - 1),
                            [] (const Token& token)
                            { return not isKeyword (token, map::CppKeyword::tokenConst) and not isKeyword (token, map::CppKeyword::tokenVolatile); });
}

```
```isConstructor
static bool isConstructor (const CLanguageDocument& document, int scope, const ling::Tokens& tokens, int qualifierStart, int namePosition, bool hasTilde)
{
    const auto scopeType { getScopeType (document, scope) };
    const auto& name { tokens.at (namePosition) };

    if (scopeType == map::SyntaxTokenType::classToken)
        return not hasTilde and isSameName (document.source, getLastNameToken (document, scope), name);

    if (scopeType == map::SyntaxTokenType::namespaceToken)
        return not hasTilde and namePosition - qualifierLength >= qualifierStart and isSameName (document.source, tokens.at (namePosition - qualifierLength), name);

    return false;
}

```
```isDestructor
static bool isDestructor (const CLanguageDocument& document, int scope, const ling::Tokens& tokens, int qualifierStart, int namePosition, bool hasTilde)
{
    const auto scopeType { getScopeType (document, scope) };
    const auto& name { tokens.at (namePosition) };

    if (hasTilde and scopeType == map::SyntaxTokenType::classToken)
        return true;

    if (hasTilde and scopeType == map::SyntaxTokenType::namespaceToken)
        return namePosition - qualifierLength - 1 >= qualifierStart and isSameName (document.source, tokens.at (namePosition - qualifierLength - 1), name);

    return false;
}

```
```getDeclarationType
static int getDeclarationType (const CLanguageDocument& document, int scope, const ling::Tokens& tokens, int start, int boundary, int qualifierStart, int namePosition, bool isFunctionShape)
{
    const auto scopeType { getElementType (document, scope) };
    const bool hasTilde { namePosition - 1 >= qualifierStart and isPunctuation (document.source, tokens.at (namePosition - 1), Chars::tilde) };

    if (isFunctionShape and isConstructor (document, scope, tokens, qualifierStart, namePosition, hasTilde)) return map::SyntaxTokenType::constructor;
    if (isFunctionShape and isDestructor (document, scope, tokens, qualifierStart, namePosition, hasTilde)) return map::SyntaxTokenType::destructor;
    if (isFunctionShape and qualifierStart < namePosition and scopeType == map::SyntaxTokenType::namespaceToken) return map::SyntaxTokenType::instanceMethod;

    static const ling::LookupTable functionTypes {
        {
:::[list]:::
        }
    };
    static const ling::LookupTable staticFunctionTypes {
        {
:::[list]:::
        }
    };
    static const ling::LookupTable variableTypes {
        {
:::[list]:::
        }
    };
    static const ling::LookupTable staticVariableTypes {
        {
:::[list]:::
        }
    };

    const bool hasStaticKeyword { std::any_of (tokens.begin() + start, tokens.begin() + boundary, [] (const Token& token) { return isKeyword (token, map::CppKeyword::tokenStatic); }) };

    return isFunctionShape ? (hasStaticKeyword ? staticFunctionTypes[scopeType] : functionTypes[scopeType])
                           : (hasStaticKeyword ? staticVariableTypes[scopeType] : variableTypes[scopeType]);
}

```
```addDeclarators
static void addDeclarators (CLanguageDocument& document, int scope, int element, const ling::Tokens& tokens, int start, int end, int type, int candidateStart)
{
    const auto source { document.source };
    auto declarator { element };
    int depth { 0 };
    int referenceStart { start };

    for (int index { start }; index < end; ++index)
    {
        if (depth == 0 and isPunctuation (source, tokens.at (index), Chars::comma))
        {
            int nameIndex { index + 1 };

            while (nameIndex < end and (isPunctuation (source, tokens.at (nameIndex), Chars::asterisk)
                                        or isPunctuation (source, tokens.at (nameIndex), Chars::ampersand)))
                ++nameIndex;

            if (nameIndex < end and tokens.at (nameIndex).type == map::SyntaxTokenType::identifier)
            {
                addReferences (document, getReferenceOwner (document, scope, declarator), tokens, referenceStart, nameIndex, map::SyntaxTokenType::reference);
                declarator = addElement (document, tokens, scope, addNameTokens (document, tokens, nameIndex, nameIndex), type, nameIndex, getListItemEnd (source, tokens, nameIndex, end), invalidPosition, invalidPosition);
                addComment (document, declarator, tokens, candidateStart);
                referenceStart = nameIndex + 1;
            }
        }

        depth += getDepthChange (source, tokens.at (index));
    }

    addReferences (document, getReferenceOwner (document, scope, declarator), tokens, referenceStart, end, map::SyntaxTokenType::reference);
}

```
```addParameter
static Token addParameter (CLanguageDocument& document, int function, const ling::Tokens& tokens, int start, int end)
{
    const auto boundary { getBoundary (document.source, tokens, start, end) };

    if (isNamedParameter (document.source, tokens, start, boundary))
    {
        const auto& name { tokens.at (boundary - 1) };

        addDeclarationCandidate (document, function, tokens, start, end, end, invalidPosition, invalidPosition);
        return Token { name.start, name.end, map::SyntaxTokenType::variable, -1, 0 };
    }

    const auto lastPosition { boundary > start ? boundary - 1 : end - 1 };

    addReferences (document, function, tokens, start, end, map::SyntaxTokenType::reference);
    return Token { tokens.at (start).start, tokens.at (lastPosition).end, map::SyntaxTokenType::variable, -1, 0 };
}

```
```addParameters
static void addParameters (CLanguageDocument& document, int function, const ling::Tokens& tokens, int open, int close)
{
    const auto source { document.source };
    int depth { 0 };
    int partStart { open + 1 };
    ling::Tokens parameters;

    for (int index { open + 1 }; index < close; ++index)
    {
        if (depth == 0 and isPunctuation (source, tokens.at (index), Chars::comma))
        {
            if (partStart < index)
                parameters.add (addParameter (document, function, tokens, partStart, index));

            partStart = index + 1;
        }

        depth += getDepthChange (source, tokens.at (index));
    }

    if (partStart < close)
        parameters.add (addParameter (document, function, tokens, partStart, close));

    document.callbacks.addParameters (document.callbacks.context, function, parameters.begin(), parameters.size());
}

```
```addElement
static int addElement (CLanguageDocument& document, const ling::Tokens& tokens, int scope, int nameStart, int type, int constructStart, int constructEnd, int bodyOpen, int bodyClose)
{
    const auto element { document.callbacks.addElement (document.callbacks.context, scope, type, document.nameTokens.begin() + nameStart, document.nameTokens.size() - nameStart,
                                                       tokens.at (constructStart).start, tokens.at (constructEnd - 1).end,
                                                       bodyClose != invalidPosition ? tokens.at (bodyOpen).end : invalidPosition,
                                                       bodyClose != invalidPosition ? tokens.at (bodyClose).start : invalidPosition) };

    document.elements.add (ling::HalfWords::pack (scope, type));
    document.elements.add (ling::HalfWords::pack (nameStart, document.nameTokens.size() - nameStart));
    document.elements.add (0);
    document.children.add (static_cast<unsigned long long> (scope), static_cast<unsigned long long> (element));
    return element;
}

```
```addComment
static void addComment (CLanguageDocument& document, int element, const ling::Tokens& tokens, int candidateStart)
{
    const auto statementStart { getStatementStart (document.source, tokens, candidateStart) };

    const auto previousEnd { statementStart > 0 ? tokens.at (statementStart - 1).end : 0 };
    const auto isBefore { [] (const Token& token, int position) { return token.start < position; } };
    const auto first { std::lower_bound (document.tokens.begin(), document.tokens.end(), previousEnd, isBefore) };
    const auto last { std::lower_bound (first, document.tokens.end(), tokens.at (statementStart).start, isBefore) };

    if (first != last)
        document.callbacks.addComment (document.callbacks.context, element, &*first, static_cast<int> (last - first));
}

```
```addReferences
static void addReferences (CLanguageDocument& document, int owner, const ling::Tokens& tokens, int start, int end, int type)
{
    const auto source { document.source };

    for (int index { start }; index < end; ++index)
    {
        if (tokens.at (index).type == map::SyntaxTokenType::identifier)
        {
            const auto qualifierStart { index };

            while (index + qualifierLength < end
                   and isPunctuation (source, tokens.at (index + 1), Chars::colon)
                   and isPunctuation (source, tokens.at (index + 2), Chars::colon)
                   and tokens.at (index + qualifierLength).type == map::SyntaxTokenType::identifier)
                index += qualifierLength;

            const bool isCall { type == map::SyntaxTokenType::reference and index + 1 < tokens.size()
                                and isPunctuation (source, tokens.at (index + 1), Chars::openParen) };
            const auto reference { addElement (document, tokens, owner, addNameTokens (document, tokens, qualifierStart, index), isCall ? map::SyntaxTokenType::call : type, qualifierStart, index + 1, invalidPosition, invalidPosition) };

            if (isMemberAccess (source, tokens, qualifierStart))
            {
                document.elements.set (reference * elementStride + 2, 1);
                document.callbacks.addMember (document.callbacks.context, reference);
            }
        }
    }
}

