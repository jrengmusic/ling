```addCursor
static int addCursor (ling::Words& cursors, Cursor cursor)
{
    const auto position { cursors.size() / cursorStride };

    cursors.add (ling::HalfWords::pack (static_cast<int> (cursor.type), cursor.xdata));
    cursors.add (static_cast<unsigned long long> (reinterpret_cast<std::uintptr_t> (cursor.data[0])));
    cursors.add (static_cast<unsigned long long> (reinterpret_cast<std::uintptr_t> (cursor.data[1])));
    cursors.add (static_cast<unsigned long long> (reinterpret_cast<std::uintptr_t> (cursor.data[2])));
    return position;
}

