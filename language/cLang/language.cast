```getStandardHeader
static const char* getStandardHeader (const LibClang& libclang, Cursor cursor)
{
    auto name { getText (libclang, libclang.getCursorSpelling (cursor)) };
    auto parent { libclang.getCursorSemanticParent (cursor) };
    std::string scope;

    for (; libclang.isInvalid (static_cast<int> (parent.type)) == 0 and parent.type != CursorType::cursorNamespace and parent.type != CursorType::translationUnit; parent = libclang.getCursorSemanticParent (parent))
    {
        const auto owner { getText (libclang, libclang.getCursorSpelling (parent)) };

        if (libclang.isAnonymous (parent) == 0 and not owner.empty()) name = owner;
    }

    const bool isAnonymousScope { parent.type == CursorType::cursorNamespace and libclang.isAnonymous (parent) != 0 };

    for (; libclang.isInvalid (static_cast<int> (parent.type)) == 0 and parent.type == CursorType::cursorNamespace; parent = libclang.getCursorSemanticParent (parent))
        if (libclang.isInlineNamespace (parent) == 0 and libclang.isAnonymous (parent) == 0)
            scope = getText (libclang, libclang.getCursorSpelling (parent)) + HoverLabel::scopeSeparator + scope;

    const auto qualifiedName { scope + name };

    if (not isAnonymousScope and getStandardHeaders().contains (qualifiedName))
    {
        return static_cast<const char*> (getStandardHeaders().getAddress (qualifiedName));
    }

    return nullptr;
}

