```getOrCreateHoverText
static int getOrCreateHoverText (const LibClang& libclang, IndexContext& context, Cursor cursor, unsigned long long symbol, SourceFile mainFile, bool hasDefinition)
{
    const auto key { ling::Wyhash::mix (static_cast<unsigned long long> (libclang.hashCursor (cursor)), getFileWord (mainFile)) };

    for (int candidate { 0 }; candidate < context.hoverTexts.getSize (key); ++candidate)
    {
        const auto word { context.hoverTexts.at (key, candidate) };

        if (libclang.equalCursors (getCursor (context.cursors, ling::HalfWords::unpackFirst (word)), cursor) != 0)
            return ling::HalfWords::unpackSecond (word);
    }

    const auto textIndex { context.texts.add (getHover (context, cursor, std::string_view {}, context.texts.get (getOrCreateProvider (libclang, context, cursor, symbol, mainFile)), hasDefinition)) };

    context.hoverTexts.add (key, ling::HalfWords::pack (addCursor (context.cursors, cursor), textIndex));

    return textIndex;
}

```
```addHovers
static void addHovers (const LibClang& libclang, IndexContext& context)
{
    for (int position { 0 }; position < context.hoverPositions.size(); position += hoverPositionStride)
    {
        const auto file { getSourceFile (context.hoverPositions.at (position)) };
        const auto cursor { getCursor (context.cursors, ling::HalfWords::unpackSecond (context.hoverPositions.at (position + 2))) };
        const auto passing { context.getPassing (file, static_cast<unsigned> (ling::HalfWords::unpackFirst (context.hoverPositions.at (position + 2)))) };
        const auto symbol { context.hoverPositions.at (position + 3) };
        SourceFile definitionFile { nullptr };

        libclang.getExpansionLocation (libclang.getRangeStart (libclang.getCursorExtent (cursor)), &definitionFile, nullptr, nullptr, nullptr);

        const bool hasDefinition { definitionFile != nullptr and hasDefinitionText (libclang, cursor) };
        const auto textIndex { passing.empty() ? getOrCreateHoverText (libclang, context, cursor, symbol, file, hasDefinition) : context.texts.add (getHover (context, cursor, passing, context.texts.get (getOrCreateProvider (libclang, context, cursor, symbol, file)), hasDefinition)) };

        context.hoverPositions.set (position + 4, ling::HalfWords::pack (textIndex, invalidPosition));
    }
}

```
```getEndPosition
static std::pair<unsigned, unsigned> getEndPosition (const LibClang& libclang, SourceRange range, SourceFile file, unsigned line, unsigned column)
{
    SourceFile endFile { nullptr };
    unsigned endLine { 0 };
    unsigned endColumn { 0 };

    libclang.getSpellingLocation (libclang.getRangeEnd (range), &endFile, &endLine, &endColumn, nullptr);

    if (endFile == file) return { endLine, endColumn };

    return { line, column };
}

```
```addFixIts
static void addFixIts (const LibClang& libclang, IndexContext& context, Diagnostic diagnostic)
{
    for (unsigned position { 0 }; position < libclang.getDiagnosticNumFixIts (diagnostic); ++position)
    {
        SourceRange range {};
        const auto text { getText (libclang, libclang.getDiagnosticFixIt (diagnostic, position, &range)) };
        SourceFile file { nullptr };
        unsigned line { 0 };
        unsigned column { 0 };

        libclang.getSpellingLocation (libclang.getRangeStart (range), &file, &line, &column, nullptr);
        const auto [endLine, endColumn] { getEndPosition (libclang, range, file, line, column) };

        if (file != nullptr and context.callbacks.addFixIt != nullptr and not context.isForeign (file))
        {
            const auto path { libclang.getFileName (file) };
            const auto normalPath { getNormalPath (libclang.getCString (path)) };

            context.callbacks.addFixIt (context.callbacks.context, normalPath.c_str(), static_cast<int> (line), static_cast<int> (column), static_cast<int> (endLine), static_cast<int> (endColumn), text.c_str());
            libclang.disposeString (path);
        }
    }
}

```
```addDiagnostics
static void addDiagnostics (const LibClang& libclang, IndexContext& context, TranslationUnit translationUnit)
{
    for (unsigned position { 0 }; position < libclang.getNumDiagnostics (translationUnit); ++position)
    {
        const std::unique_ptr<void, decltype (LibClang::disposeDiagnostic)> diagnostic { libclang.getDiagnostic (translationUnit, position), libclang.disposeDiagnostic };
        const auto severity { libclang.getDiagnosticSeverity (diagnostic.get()) };
        SourceFile file { nullptr };
        unsigned line { 0 };
        unsigned column { 0 };

        libclang.getSpellingLocation (libclang.getDiagnosticLocation (diagnostic.get()), &file, &line, &column, nullptr);
        const auto [endLine, endColumn] { libclang.getDiagnosticNumRanges (diagnostic.get()) > 0 ? getEndPosition (libclang, libclang.getDiagnosticRange (diagnostic.get(), 0), file, line, column) : std::make_pair (line, column) };

        if (file != nullptr and severity >= ToolchainValue::reportedSeverity)
        {
            if (not context.isForeign (file))
            {
                const auto path { libclang.getFileName (file) };
                const auto normalPath { getNormalPath (libclang.getCString (path)) };
                const auto message { libclang.getDiagnosticSpelling (diagnostic.get()) };

                context.callbacks.addDiagnostic (context.callbacks.context, normalPath.c_str(), static_cast<int> (line), static_cast<int> (column), static_cast<int> (endLine), static_cast<int> (endColumn), diagnosticSeverities[severity], libclang.getCString (message));
                libclang.disposeString (message);
                libclang.disposeString (path);
            }

            addFixIts (libclang, context, diagnostic.get());
        }
    }
}

