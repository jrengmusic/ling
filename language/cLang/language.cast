```getBareType
static ValueType getBareType (const LibClang& libclang, ValueType type)
{
    const bool isReference { type.type == ValueCategory::lValueReference or type.type == ValueCategory::rValueReference };

    return libclang.getUnqualifiedType (libclang.getCanonicalType (isReference ? libclang.getPointeeType (type) : type));
}

