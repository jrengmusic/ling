```getHoverProvider
static std::string getHoverProvider (const LibClang& libclang, const IndexContext& context, Cursor cursor, unsigned long long symbol, SourceFile mainFile)
{
    const auto headers (cursor.type == CursorType::cursorNamespace ? ling::Words() : getRankedHeaders (libclang, context, cursor, symbol, mainFile));
    const auto includer { getFileWord (mainFile) };
    const auto getMatch { [&context, includer] (SourceFile file, const char* standardName)
    {
        std::string match;

        for (int position { 0 }; position < context.includeDirectives.getSize (includer); position += includeDirectiveStride)
        {
            const auto includedFile { getSourceFile (context.includeDirectives.at (includer, position)) };
            const auto spelledWord { context.includeDirectives.at (includer, position + 1) };
            const std::string_view spelled { context.texts.get (ling::HalfWords::unpackFirst (spelledWord)) };
            const bool isAngled { ling::HalfWords::unpackSecond (spelledWord) != 0 };

            if (match.empty() and (file != nullptr ? includedFile == file : std::string_view (standardName).substr (1, std::string_view (standardName).size() - 2).compare (spelled) == 0))
                match = (isAngled ? static_cast<char> (Chars::lessThan) : static_cast<char> (Chars::doubleQuote)) + std::string (spelled) + (isAngled ? static_cast<char> (Chars::greaterThan) : static_cast<char> (Chars::doubleQuote));
        }

        return match;
    } };
    std::string provider;
    bool isStopped { false };

    for (int position { 0 }; position < headers.size() and provider.empty() and not isStopped; position += headerStride)
    {
        const auto file { getSourceFile (headers.at (position + 1)) };
        const auto standardName { reinterpret_cast<const char*> (static_cast<std::uintptr_t> (headers.at (position + 2))) };

        isStopped = file == mainFile;
        provider = isStopped ? std::string() : getMatch (file, standardName);
    }

    if (provider.empty() and headers.size() > 0)
    {
        const auto frontFile { getSourceFile (headers.at (1)) };
        const auto frontName { reinterpret_cast<const char*> (static_cast<std::uintptr_t> (headers.at (2))) };

        provider = frontFile == mainFile ? std::string() : frontFile == nullptr ? std::string (frontName) : getSpelledHeader (context, frontFile, mainFile);
    }

    return provider;
}

