```libclang
static constexpr int platformNone { 0 };
static constexpr int platformMac { 1 };
static constexpr int platformWindows { 2 };

#if defined (_WIN32)
static constexpr int currentPlatform { platformWindows };
using LibraryHandle = HMODULE;
#elif defined (__APPLE__)
static constexpr int currentPlatform { platformMac };
using LibraryHandle = void*;
#else
static constexpr int currentPlatform { platformNone };
using LibraryHandle = void*;
#endif

static LibraryHandle openLibrary (const char* path)
{
#if defined (_WIN32)
    return LoadLibraryA (path);
#else
    return dlopen (path, RTLD_NOW | RTLD_LOCAL);
#endif
}

static void closeLibrary (LibraryHandle library)
{
#if defined (_WIN32)
    FreeLibrary (library);
#else
    dlclose (library);
#endif
}

template <typename Function>
static Function getFunction (LibraryHandle library, const char* name)
{
    Function function { nullptr };

    if (library != nullptr)
    {
#if defined (_WIN32)
        function = reinterpret_cast<Function> (GetProcAddress (library, name));
#else
        function = reinterpret_cast<Function> (dlsym (library, name));
#endif
    }

    return function;
}

static FILE* openPipe (const char* command)
{
#if defined (_WIN32)
    return _popen (command, ToolchainWord::pipeReadMode);
#else
    return popen (command, ToolchainWord::pipeReadMode);
#endif
}

static void closePipe (FILE* pipe)
{
#if defined (_WIN32)
    _pclose (pipe);
#else
    pclose (pipe);
#endif
}

using CXFile = void*;
using CXIndex = void*;
using CXIndexAction = void*;
using CXClientData = void*;
using CXIdxClientFile = void*;
using CXIdxClientContainer = void*;
using CXIdxClientASTFile = void*;
using CXDiagnosticSet = void*;
using CXTranslationUnit = void*;

struct CXString
{
    const void* data;
    unsigned privateFlags;
};

struct CXCursor
{
    int kind;
    int xdata;
    const void* data[3];
};

struct CXIdxLoc
{
    void* ptrData[2];
    unsigned intData;
};

struct CXIdxEntityInfo
{
    int kind;
    int templateKind;
    int lang;
    const char* name;
    const char* USR;
    CXCursor cursor;
    const void* const* attributes;
    unsigned numAttributes;
};

struct CXIdxDeclInfo
{
    const CXIdxEntityInfo* entityInfo;
    CXCursor cursor;
    CXIdxLoc loc;
    const void* semanticContainer;
    const void* lexicalContainer;
    int isRedeclaration;
    int isDefinition;
    int isContainer;
    const void* declAsContainer;
    int isImplicit;
    const void* const* attributes;
    unsigned numAttributes;
    unsigned flags;
};

struct CXIdxBaseClassInfo
{
    const CXIdxEntityInfo* base;
    CXCursor cursor;
    CXIdxLoc loc;
};

struct CXIdxCXXClassDeclInfo
{
    const CXIdxDeclInfo* declInfo;
    const CXIdxBaseClassInfo* const* bases;
    unsigned numBases;
};

enum CXSymbolRole
{
    CXSymbolRole_None = 0,
    CXSymbolRole_Declaration = 1 << 0,
    CXSymbolRole_Definition = 1 << 1,
    CXSymbolRole_Reference = 1 << 2,
    CXSymbolRole_Read = 1 << 3,
    CXSymbolRole_Write = 1 << 4,
    CXSymbolRole_Call = 1 << 5,
    CXSymbolRole_Dynamic = 1 << 6,
    CXSymbolRole_AddressOf = 1 << 7,
    CXSymbolRole_Implicit = 1 << 8
};

struct CXIdxEntityRefInfo
{
    int kind;
    CXCursor cursor;
    CXIdxLoc loc;
    const CXIdxEntityInfo* referencedEntity;
    const CXIdxEntityInfo* parentEntity;
    const void* container;
    CXSymbolRole role;
};

enum CXIndexOptFlags
{
    CXIndexOpt_None = 0x0,
    CXIndexOpt_SuppressRedundantRefs = 0x1,
    CXIndexOpt_IndexFunctionLocalSymbols = 0x2,
    CXIndexOpt_IndexImplicitTemplateInstantiations = 0x4,
    CXIndexOpt_SuppressWarnings = 0x8,
    CXIndexOpt_SkipParsedBodiesInSession = 0x10
};

struct IndexerCallbacks
{
    int (*abortQuery) (CXClientData clientData, void* reserved);
    void (*diagnostic) (CXClientData clientData, CXDiagnosticSet diagnostics, void* reserved);
    CXIdxClientFile (*enteredMainFile) (CXClientData clientData, CXFile mainFile, void* reserved);
    CXIdxClientFile (*ppIncludedFile) (CXClientData clientData, const void* includedFile);
    CXIdxClientASTFile (*importedASTFile) (CXClientData clientData, const void* importedFile);
    CXIdxClientContainer (*startedTranslationUnit) (CXClientData clientData, void* reserved);
    void (*indexDeclaration) (CXClientData clientData, const CXIdxDeclInfo* declaration);
    void (*indexEntityReference) (CXClientData clientData, const CXIdxEntityRefInfo* reference);
};

static constexpr unsigned indexOptions { CXIndexOpt_IndexFunctionLocalSymbols };

static constexpr LookupTable<int, int, CXSymbolRole_Call + 1> referenceRoles {
    {
        { CXSymbolRole_None, LanguageRole::reference },
        { CXSymbolRole_Call, LanguageRole::reference | LanguageRole::call }
    }
};

struct LibClang
{
    using CreateIndex = CXIndex (*) (int excludeDeclarationsFromPCH, int displayDiagnostics);
    using CreateIndexAction = CXIndexAction (*) (CXIndex index);
    using IndexSourceFileFullArgv = int (*) (CXIndexAction action, CXClientData clientData, IndexerCallbacks* callbacks, unsigned callbacksSize, unsigned options, const char* sourceFileName, const char* const* commandLineArguments, int commandLineArgumentCount, void* unsavedFiles, unsigned unsavedFileCount, CXTranslationUnit* translationUnit, unsigned translationUnitOptions);
    using GetCXXClassDeclInfo = const CXIdxCXXClassDeclInfo* (*) (const CXIdxDeclInfo* declaration);
    using GetFileLocation = void (*) (CXIdxLoc location, CXIdxClientFile* indexFile, CXFile* file, unsigned* line, unsigned* column, unsigned* offset);
    using GetFileName = CXString (*) (CXFile file);
    using GetCString = const char* (*) (CXString string);
    using DisposeString = void (*) (CXString string);
    using DisposeIndex = void (*) (CXIndex index);
    using DisposeIndexAction = void (*) (CXIndexAction action);

    explicit LibClang (const std::string& path)
        : library { openLibrary (path.c_str()), closeLibrary },
          createIndex { getFunction<CreateIndex> (library.get(), LibClangSymbol::createIndex) },
          createIndexAction { getFunction<CreateIndexAction> (library.get(), LibClangSymbol::createIndexAction) },
          indexSourceFileFullArgv { getFunction<IndexSourceFileFullArgv> (library.get(), LibClangSymbol::indexSourceFileFullArgv) },
          getCXXClassDeclInfo { getFunction<GetCXXClassDeclInfo> (library.get(), LibClangSymbol::getCXXClassDeclInfo) },
          getFileLocation { getFunction<GetFileLocation> (library.get(), LibClangSymbol::getFileLocation) },
          getFileName { getFunction<GetFileName> (library.get(), LibClangSymbol::getFileName) },
          getCString { getFunction<GetCString> (library.get(), LibClangSymbol::getCString) },
          disposeString { getFunction<DisposeString> (library.get(), LibClangSymbol::disposeString) },
          disposeIndex { getFunction<DisposeIndex> (library.get(), LibClangSymbol::disposeIndex) },
          disposeIndexAction { getFunction<DisposeIndexAction> (library.get(), LibClangSymbol::disposeIndexAction) }
    {
    }

    LibClang (const LibClang&) = delete;
    LibClang& operator= (const LibClang&) = delete;

    std::unique_ptr<std::remove_pointer_t<LibraryHandle>, void (*) (LibraryHandle)> library;
    CreateIndex createIndex;
    CreateIndexAction createIndexAction;
    IndexSourceFileFullArgv indexSourceFileFullArgv;
    GetCXXClassDeclInfo getCXXClassDeclInfo;
    GetFileLocation getFileLocation;
    GetFileName getFileName;
    GetCString getCString;
    DisposeString disposeString;
    DisposeIndex disposeIndex;
    DisposeIndexAction disposeIndexAction;
};

struct IndexContext
{
    const LibClang& libclang;
    const LanguageCallbacks& callbacks;

    void addSymbol (CXIdxLoc location, const char* symbol, int role) const
    {
        CXFile file { nullptr };
        unsigned line { 0 };
        unsigned column { 0 };

        libclang.getFileLocation (location, nullptr, &file, &line, &column, nullptr);

        if (file != nullptr and symbol != nullptr and *symbol != Chars::nullCharacter)
        {
            const auto path { libclang.getFileName (file) };

            callbacks.addSymbol (callbacks.context, libclang.getCString (path), static_cast<int> (line), static_cast<int> (column), symbol, role);
            libclang.disposeString (path);
        }
    }
};

