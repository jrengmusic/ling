```addLocalLinks
static void addLocalLinks (CLanguageDocument& document, int scope)
{
    for (int childIndex { 0 }; childIndex < document.children.getSize (static_cast<unsigned long long> (scope)); ++childIndex)
    {
        const auto element { static_cast<int> (document.children.at (static_cast<unsigned long long> (scope), childIndex)) };

        if (isFunctionScope (document, element))
        {
            for (int referenceIndex { 0 }; referenceIndex < document.children.getSize (static_cast<unsigned long long> (element)); ++referenceIndex)
            {
                const auto reference { static_cast<int> (document.children.at (static_cast<unsigned long long> (element), referenceIndex)) };

                if (isLocalReference (document, reference))
                    addLinkEndpoints (document, reference, getLocalDeclarations (document, element, getLastNameToken (document, reference)));
            }
        }

        addLocalLinks (document, element);
    }
}

```
```getLocalDeclarations
static ling::Words getLocalDeclarations (const CLanguageDocument& document, int function, const Token& name)
{
    ling::Words declarations;

    for (int childIndex { 0 }; childIndex < document.children.getSize (static_cast<unsigned long long> (function)); ++childIndex)
    {
        const auto declaration { static_cast<int> (document.children.at (static_cast<unsigned long long> (function), childIndex)) };
        const auto type { getElementType (document, declaration) };

        if (isSameName (document.source, getLastNameToken (document, declaration), name) and (type == map::SyntaxTokenType::variable or type == map::SyntaxTokenType::staticVariable))
            declarations.add (declaration);
    }

    return declarations;
}

