```addTypeHint
static void addTypeHint (IndexContext& context, SourceLocation location, std::string_view prefix, std::string_view type)
{
    if (not type.empty() and type.size() < static_cast<std::size_t> (ToolchainValue::typeNameLimit))
        context.addHint (location, std::string (prefix) + std::string (type), ToolchainValue::typeHintType, false, false);
}

