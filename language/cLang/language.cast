```addPhysicalHeaders
static void addPhysicalHeaders (const IndexContext& context, ling::Words& headers, SourceFile file, bool isComplete, SourceFile mainFile)
{
    int origin { HeaderHint::origin };
    const auto addHeader { [&headers] (int hint, SourceFile candidate)
    {
        int found { invalidPosition };

        for (int position { 0 }; position < headers.size(); position += headerStride)
            if (headers.at (position + 1) == getFileWord (candidate)) found = position;

        if (found != invalidPosition) headers.set (found, headers.at (found) | static_cast<unsigned long long> (hint));
        else
        {
            headers.add (static_cast<unsigned long long> (hint));
            headers.add (getFileWord (candidate));
            headers.add (static_cast<unsigned long long> (reinterpret_cast<std::uintptr_t> (nullptr)));
        }
    } };

    while (file != nullptr)
    {
        const bool isPublic { isSelfContained (context, file) };
        SourceFile next { nullptr };

        addHeader ((isPublic ? HeaderHint::publicHeader : 0) | origin | (isComplete ? HeaderHint::complete : 0), file);
        origin = 0;

        if (not (isPublic or file == mainFile) and context.includers.contains (getFileWord (file)))
        {
            next = getSourceFile (context.includers.at (getFileWord (file)));
        }

        file = next;
    }
}

