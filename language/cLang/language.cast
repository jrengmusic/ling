```addLambdaReturnHint
static void addLambdaReturnHint (const LibClang& libclang, IndexContext& context, Cursor lambda)
{
    const auto callOperator { getCallOperator (context, lambda) };

    if (isDeducedType (libclang, libclang.getCursorResultType (callOperator)))
    {
        const auto translationUnit { libclang.getCursorTranslationUnit (lambda) };
        SourceToken* tokens { nullptr };
        unsigned tokenCount { 0 };

        libclang.tokenize (translationUnit, libclang.getCursorExtent (lambda), &tokens, &tokenCount);

        if (tokenCount > 0 and isTokenByte (libclang, translationUnit, tokens[0], Chars::openBracket))
        {
            const auto introducerEnd { getClosingIndex (libclang, translationUnit, tokens, tokenCount, 0, Chars::openBracket, Chars::closeBracket) };
            const bool hasParameters { introducerEnd + 1 < tokenCount and isTokenByte (libclang, translationUnit, tokens[introducerEnd + 1], Chars::openParen) };
            const auto listEnd { hasParameters ? getClosingIndex (libclang, translationUnit, tokens, tokenCount, introducerEnd + 1, Chars::openParen, Chars::closeParen) : introducerEnd };

            addTypeHint (context, libclang.getRangeEnd (libclang.getTokenExtent (translationUnit, tokens[listEnd])), InlayHintLabel::returnPrefix, getReturnTypeText (libclang, callOperator));
        }

        libclang.disposeTokens (translationUnit, tokens, tokenCount);
    }
}

