```getOutputPath
static std::string getOutputPath (const char* const* arguments, int argumentCount, const char* directory)
{
    const std::string_view emitFlag { ToolchainWord::precompiledEmitFlag };
    const std::string_view outputFlag { ToolchainWord::outputFlag };
    const bool isPrecompiled { std::any_of (arguments, arguments + argumentCount, [emitFlag] (const char* argument) { return emitFlag.compare (argument) == 0; }) };
    const auto output { std::find_if (arguments, arguments + argumentCount, [outputFlag] (const char* argument) { return outputFlag.compare (argument) == 0; }) };

    if (isPrecompiled and output != arguments + argumentCount and output + 1 != arguments + argumentCount)
        return (std::filesystem::path (directory) / *(output + 1)).string();

    return {};
}

```
```getArguments
static ling::Pointers getArguments (const char* const* arguments, int argumentCount, const char* directory)
{
    ling::Pointers commandLine;
    commandLine.add (arguments[0]);
    commandLine.add (ToolchainWord::workingDirectoryFlag);
    commandLine.add (directory);

    for (int position { 1 }; position < argumentCount; ++position)
    {
        const std::string_view argument { arguments[position] };

        if (getArgumentRemovals().contains (argument))
        {
            position += static_cast<int> (getArgumentRemovals().at (argument));
        }
        else
            commandLine.add (arguments[position]);
    }

    getArgumentAdditions().applyToEntries ([&commandLine] (std::string_view key, unsigned long long)
    {
        commandLine.add (key.data());
    });

    return commandLine;
}

```
```addUnits
static void addUnits (const ling::Texts& texts, const ling::Words& unitRows, const ling::WordLists& unitArguments, const ling::WordLists& dependencies, const ling::WordLists& prerequisites, const LanguageCallbacks& callbacks)
{
    ling::WordLists consumers;

    for (int unit { 0 }; unit < unitRows.size() / unitStride; ++unit)
    {
        const auto key { static_cast<unsigned long long> (unit) };

        for (int position { 0 }; position < prerequisites.getSize (key); ++position)
            consumers.add (prerequisites.at (key, position), key);
    }

    for (int unit { 0 }; unit < unitRows.size() / unitStride; ++unit)
    {
        const auto key { static_cast<unsigned long long> (unit) };
        const auto row { unitRows.at (unit * unitStride) };
        const auto outputText { ling::HalfWords::unpackFirst (unitRows.at (unit * unitStride + 1)) };
        ling::Pointers commandLine;
        ling::Pointers unitDependencies;
        ling::Pointers unitPrerequisites;

        for (int position { 0 }; position < unitArguments.getSize (key); ++position)
            commandLine.add (texts.getPointer (static_cast<int> (unitArguments.at (key, position))));

        for (int position { 0 }; position < dependencies.getSize (key); ++position)
            unitDependencies.add (texts.getPointer (static_cast<int> (dependencies.at (key, position))));

        for (int position { 0 }; position < prerequisites.getSize (key); ++position)
            unitPrerequisites.add (texts.getPointer (ling::HalfWords::unpackFirst (unitRows.at (static_cast<int> (prerequisites.at (key, position)) * unitStride))));

        if (getFlagPosition (texts, unitArguments, unit, ToolchainWord::precompiledEmitFlag) == invalidPosition or consumers.contains (key))
            callbacks.addUnit (callbacks.context, texts.getPointer (ling::HalfWords::unpackFirst (row)), texts.getPointer (ling::HalfWords::unpackSecond (row)), outputText != invalidPosition ? texts.getPointer (outputText) : "", commandLine.begin(), commandLine.size(), unitDependencies.begin(), unitDependencies.size(), unitPrerequisites.begin(), unitPrerequisites.size());
    }
}

