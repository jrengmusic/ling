```getPointeeRoot
static ValueType getPointeeRoot (const LibClang& libclang, ValueType type)
{
    ValueType root { type };

    while (root.type == ValueCategory::pointer or root.type == ValueCategory::lValueReference or root.type == ValueCategory::rValueReference)
        root = libclang.getPointeeType (root);

    return root;
}

```
```isDeducedType
static bool isDeducedType (const LibClang& libclang, ValueType type)
{
    const auto canonical { libclang.getCanonicalType (type) };
    const bool isDeduced { getPointeeRoot (libclang, type).type == ValueCategory::typeAuto and getPointeeRoot (libclang, canonical).type != ValueCategory::typeAuto };

    return isDeduced and getText (libclang, libclang.getTypeSpelling (canonical)).find (ToolchainWord::templateParameterSpelling) == std::string::npos;
}

