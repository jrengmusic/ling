```getInitializerTokenCount
static unsigned getInitializerTokenCount (IndexContext& context, Cursor variable)
{
    unsigned tokenCount { 0 };

    applyToChildren (context.libclang, variable, [&context, &tokenCount, variable] (Cursor child)
    {
        if (child.type >= CursorType::unexposedExpression and child.type < CursorType::firstStatement)
        {
            SourceToken* tokens { nullptr };
            unsigned childTokenCount { 0 };

            context.libclang.tokenize (context.libclang.getCursorTranslationUnit (variable), context.libclang.getCursorExtent (child), &tokens, &childTokenCount);
            context.libclang.disposeTokens (context.libclang.getCursorTranslationUnit (variable), tokens, childTokenCount);
            tokenCount = childTokenCount;
        }

        return ChildVisitResult::visitContinue;
    });

    return tokenCount;
}

