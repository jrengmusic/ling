```getOutlineNameLength
static int getOutlineNameLength (const LibClang& libclang, Cursor cursor, unsigned offset, std::string_view name)
{
    const auto translationUnit { libclang.getCursorTranslationUnit (cursor) };
    const auto nameRange { libclang.getSpellingNameRange (cursor, 0, 0) };
    unsigned nameEnd { 0 };
    SourceToken* tokens { nullptr };
    unsigned tokenCount { 0 };

    libclang.getSpellingLocation (libclang.getRangeEnd (nameRange), nullptr, nullptr, nullptr, &nameEnd);
    libclang.tokenize (translationUnit, nameRange, &tokens, &tokenCount);

    const auto firstToken { tokenCount > 0 ? getText (libclang, libclang.getTokenSpelling (translationUnit, tokens[0])) : std::string {} };
    const bool isSpelled { not firstToken.empty() and name.compare (0, firstToken.size(), firstToken) == 0 };

    libclang.disposeTokens (translationUnit, tokens, tokenCount);

    return isSpelled ? static_cast<int> (nameEnd) - static_cast<int> (offset) : 0;
}

