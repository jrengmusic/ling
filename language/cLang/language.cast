```index
static int index (const char* const* arguments, int argumentCount, const char* directory, const LanguageCallbacks& callbacks)
{
    assert (argumentCount > 0);

    const auto installDirectory { getVersionInstallDirectory (getCommandOutput (getQuoted (arguments[0]) + static_cast<char> (Chars::space) + ToolchainWord::versionFlag)) };

    if (not installDirectory.empty())
    {
        const LibClang libclang ((std::filesystem::path (installDirectory) / getLibraryPaths().at (currentPlatform)).string());
        const std::initializer_list<const void*> symbols {
            libclang.library.get(),
            reinterpret_cast<const void*> (libclang.createIndex),
            reinterpret_cast<const void*> (libclang.createIndexAction),
            reinterpret_cast<const void*> (libclang.indexSourceFileFullArgv),
            reinterpret_cast<const void*> (libclang.getCXXClassDeclInfo),
            reinterpret_cast<const void*> (libclang.getFileLocation),
            reinterpret_cast<const void*> (libclang.getFileName),
            reinterpret_cast<const void*> (libclang.getCString),
            reinterpret_cast<const void*> (libclang.disposeString),
            reinterpret_cast<const void*> (libclang.disposeIndex),
            reinterpret_cast<const void*> (libclang.disposeIndexAction)
        };

        if (std::all_of (symbols.begin(), symbols.end(), [] (const void* symbol) { return symbol != nullptr; }))
        {
            const std::unique_ptr<void, LibClang::DisposeIndex> indexHandle { libclang.createIndex (excludeDeclarationsFromPCH, displayDiagnostics), libclang.disposeIndex };
            const std::unique_ptr<void, LibClang::DisposeIndexAction> action { libclang.createIndexAction (indexHandle.get()), libclang.disposeIndexAction };
            const auto commandLine (getArguments (arguments, argumentCount, installDirectory, directory));
            std::vector<const char*> commandLinePointers (commandLine.size());
            IndexContext context { libclang, callbacks };
            IndexerCallbacks indexerCallbacks {
                [] (CXClientData clientData, void*)
                {
                    const auto& indexContext { *static_cast<const IndexContext*> (clientData) };

                    return indexContext.callbacks.shouldExit (indexContext.callbacks.context);
                },
                nullptr, nullptr, nullptr, nullptr, nullptr, onDeclaration, onReference
            };

            std::transform (commandLine.begin(), commandLine.end(), commandLinePointers.begin(),
                            [] (const std::string& argument) { return argument.c_str(); });

            return libclang.indexSourceFileFullArgv (action.get(), &context, &indexerCallbacks, static_cast<unsigned> (sizeof (IndexerCallbacks)), indexOptions,
                                                     nullptr, commandLinePointers.data(), static_cast<int> (commandLinePointers.size()),
                                                     nullptr, unsavedFileCount, nullptr, translationUnitOptions);
        }
    }

    return indexFailure;
}

