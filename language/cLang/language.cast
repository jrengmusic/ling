```getInsertText
static std::string getInsertText (const LibClang& libclang, Cursor cursor, std::string_view name, int type)
{
    const bool isFunction { (roles[type] & LanguageRole::function) != 0 };

    return isFunction ? std::string (name) + "(" + getSnippetParameters (libclang, cursor) + ")" : std::string (name);
}

