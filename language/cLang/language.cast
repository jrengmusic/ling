```isPreferredHeader
static bool isPreferredHeader (const LibClang& libclang, SourceFile file, std::string_view symbolName)
{
    const auto fileName { std::filesystem::path (getText (libclang, libclang.getFileName (file))).filename().string() };
    const auto stem { fileName.substr (0, fileName.find (static_cast<char> (Chars::dot))) };

    return isSameText (stem, symbolName);
}

