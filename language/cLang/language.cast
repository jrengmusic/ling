```addMacroCompletion
static void addMacroCompletion (IndexContext& context, Cursor cursor)
{
    const auto& libclang { context.libclang };
    const auto usr { getText (libclang, libclang.getCursorUSR (cursor)) };
    const auto name { getText (libclang, libclang.getCursorSpelling (cursor)) };
    SourceFile file { nullptr };

    libclang.getSpellingLocation (libclang.getCursorLocation (cursor), &file, nullptr, nullptr, nullptr);

    if (cursor.type == CursorType::macroDefinition)
        addCompletionRow (context, 0, ling::Wyhash::hashBytes (usr.data(), usr.size()), name, name, map::SyntaxTokenType::macro, 0, file);
}

```
```addCompletionRecord
static void addCompletionRecord (IndexContext& context, const IndexDeclarationInfo* declaration, SourceFile file)
{
    const auto parent { context.libclang.getCursorLexicalParent (declaration->cursor) };
    const auto type { getEntityType (static_cast<int> (declaration->entityInfo->type)) };

    if (completionScopeTypes[static_cast<int> (parent.type)] != 0 and (roles[type] & LanguageRole::declaration) != 0 and isNamedDeclaration (declaration))
    {
        storeCompletion (context, declaration, parent, type, file);

        if (type == map::SyntaxTokenType::enumConstant and parent.type == CursorType::enumerationDeclaration)
            storeEnumeratorScope (context, declaration, parent, type, file);
    }
}

```
```addCompletionBases
static void addCompletionBases (IndexContext& context, const IndexDeclarationInfo* declaration, SourceFile file)
{
    const auto* classInfo { context.libclang.getCXXClassDeclInfo (declaration) };
    const auto derived { ling::Wyhash::hashBytes (declaration->entityInfo->USR, std::strlen (declaration->entityInfo->USR)) };

    if (classInfo != nullptr and declaration->isDefinition != 0)
    {
        std::for_each (classInfo->bases, classInfo->bases + classInfo->numBases,
                       [&context, derived] (const IndexBaseClassInfo* base)
                       {
                           if (base->base != nullptr)
                               context.completionBases.add (derived, ling::Wyhash::hashBytes (base->base->USR, std::strlen (base->base->USR)));
                       });

        if (classInfo->numBases != 0)
        {
            context.derivedClasses.add (derived);
            context.derivedPaths.add (derived, getFileWord (file));
        }
    }
}

```
```emitCompletion
static void emitCompletion (IndexContext& context, unsigned long long scope, unsigned long long row, unsigned long long fileWord)
{
    const auto file { getSourceFile (fileWord) };

    if (file == nullptr or not context.isForeign (file))
    {
        const auto base { static_cast<int> (row) * completionStride };
        const auto texts { ling::HalfWords::unpackFirst (context.completionRows.at (base + 2)) };
        const auto insertTexts { ling::HalfWords::unpackSecond (context.completionRows.at (base + 2)) };
        const auto pathText { getNormalPath (getText (context.libclang, context.libclang.getFileName (file))) };

        context.callbacks.addCompletion (context.callbacks.context, pathText.c_str(), scope, context.completionRows.at (base + 1), context.texts.getPointer (texts), context.texts.getPointer (insertTexts), ling::HalfWords::unpackFirst (context.completionRows.at (base + 3)));
    }
}

```
```addInheritedCompletions
static void addInheritedCompletions (IndexContext& context, unsigned long long derived, unsigned long long base, ling::WordSet& inheritedBases)
{
    if (not inheritedBases.contains (base))
    {
        inheritedBases.add (base);

        for (int position { 0 }; position < context.completionsByScope.getSize (base); ++position)
        {
            const auto row { context.completionsByScope.at (base, position) };

            if ((ling::HalfWords::unpackSecond (context.completionRows.at (static_cast<int> (row) * completionStride + 3)) & completionPrivateFlag) == 0)
                emitCompletion (context, derived, row, context.derivedPaths.at (derived));
        }

        for (int position { 0 }; position < context.completionBases.getSize (base); ++position)
            addInheritedCompletions (context, derived, context.completionBases.at (base, position), inheritedBases);
    }
}

```
```addCompletions
static void addCompletions (IndexContext& context)
{
    if (context.callbacks.addCompletion != nullptr)
    {
        for (int row { 0 }; row < context.completionRows.size() / completionStride; ++row)
            emitCompletion (context, context.completionRows.at (row * completionStride), static_cast<unsigned long long> (row), context.completionRows.at (row * completionStride + 4));

        for (int position { 0 }; position < context.derivedClasses.size(); ++position)
        {
            const auto derived { context.derivedClasses.at (position) };
            ling::WordSet inheritedBases;

            inheritedBases.add (derived);

            for (int basePosition { 0 }; basePosition < context.completionBases.getSize (derived); ++basePosition)
                addInheritedCompletions (context, derived, context.completionBases.at (derived, basePosition), inheritedBases);
        }
    }
}

```
```onDeclaration
static void onDeclaration (ClientData clientData, const IndexDeclarationInfo* declaration)
{
    auto& context { *static_cast<IndexContext*> (clientData) };
    const auto* classInfo { context.libclang.getCXXClassDeclInfo (declaration) };
    SourceFile file { nullptr };

    const auto symbolHash { context.getSymbolHash (declaration->entityInfo->USR, declaration->cursor) };
    const bool isComplete { declaration->isDefinition != 0 or definitionTypes[static_cast<int> (declaration->cursor.type)] == 0 };

    const auto record { context.addSymbol (declaration->loc, declaration->entityInfo->USR, declaration->cursor, LanguageRole::declaration | (isComplete ? LanguageRole::definition : 0), getEntityType (static_cast<int> (declaration->entityInfo->type)), declaration->entityInfo->name, context.addHover (declaration->loc, declaration->entityInfo->USR, declaration->cursor)) };
    context.libclang.getSpellingLocation (context.libclang.indexLocSourceLocation (declaration->loc), &file, nullptr, nullptr, nullptr);
    context.declarationFiles.add (symbolHash, getFileWord (file));
    context.declarationFiles.add (symbolHash, static_cast<unsigned long long> (isComplete ? 1 : 0));
    addOutline (context, declaration);
    addTypeDefinition (context, record, declaration->cursor);
    addCompletionRecord (context, declaration, file);
    addCompletionBases (context, declaration, file);

    if (classInfo != nullptr)
        std::for_each (classInfo->bases, classInfo->bases + classInfo->numBases,
                       [&context] (const IndexBaseClassInfo* base)
                       {
                           if (base->base != nullptr)
                           {
                               context.addSymbol (base->loc, base->base->USR, context.libclang.getCursorReferenced (base->cursor), LanguageRole::reference | LanguageRole::base, getEntityType (static_cast<int> (base->base->type)), base->base->name, context.addHover (base->loc, base->base->USR, context.libclang.getCursorReferenced (base->cursor)));
                           }
                       });
}

```
```onReference
static void onReference (ClientData clientData, const IndexEntityReferenceInfo* reference)
{
    auto& context { *static_cast<IndexContext*> (clientData) };

    const int role { referenceRoles[static_cast<int> (reference->role) & static_cast<int> (SymbolRole::call)] | (reference->cursor.type == CursorType::usingDeclaration ? LanguageRole::declaration : 0) };

    const auto referencedCursor { context.libclang.isInvalid (static_cast<int> (context.libclang.getCursorKind (context.libclang.getCursorReferenced (reference->cursor)))) == 0 ? context.libclang.getCursorReferenced (reference->cursor) : reference->referencedEntity->cursor };

    const auto entityCursor { reference->referencedEntity->cursor };
    const auto memberPattern { context.libclang.getSpecializedCursorTemplate (entityCursor) };
    const bool isMemberTemplate { (entityCursor.type == CursorType::functionTemplate or entityCursor.type == CursorType::classTemplate) and context.libclang.isInvalid (static_cast<int> (memberPattern.type)) == 0 };
    const std::string patternSymbol { isMemberTemplate ? getText (context.libclang, context.libclang.getCursorUSR (memberPattern)) : std::string {} };
    const char* symbol { isMemberTemplate ? patternSymbol.c_str() : reference->referencedEntity->USR };

    if (context.libclang.getCursorReferenced (reference->cursor).type != CursorType::overloadedDeclarationReference)
    {
        const auto record { context.addSymbol (reference->loc, symbol, referencedCursor, role, getEntityType (static_cast<int> (reference->referencedEntity->type)), reference->referencedEntity->name, context.addHover (reference->loc, symbol, referencedCursor)) };
        addTypeDefinition (context, record, context.libclang.getCursorReferenced (reference->cursor));
    }
}

