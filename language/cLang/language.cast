```getScopeSymbol
static unsigned long long getScopeSymbol (const LibClang& libclang, Cursor parent)
{
    const auto usr { getText (libclang, libclang.getCursorUSR (parent)) };

    return parent.type == CursorType::translationUnit ? 0 : ling::Wyhash::hashBytes (usr.data(), usr.size());
}

