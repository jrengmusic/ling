```getCachePath
static std::string getCachePath (const std::string& cacheDirectory, const std::string& output)
{
    const auto extension { std::filesystem::path (output).extension().string() };

    return (std::filesystem::path (cacheDirectory) / (std::to_string (ling::Wyhash::hashBytes (output.data(), output.size())) + extension)).string();
}

