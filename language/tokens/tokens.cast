```classes-function
static constexpr int byteCount { 256 };

static constexpr std::array<int, byteCount> getClasses (std::initializer_list<std::pair<int, int>> rows)
{
    std::array<int, byteCount> classes {};

    for (const auto& [key, value] : rows)
    {
        if (key == 0)
        {
            for (auto& classValue : classes)
                classValue = value;
        }
    }

    for (const auto& [key, value] : rows)
        classes.at (key) = value;

    return classes;
}

```
```keywords-class
class Keywords
{
public:
    explicit Keywords (std::string_view newText)
        : text (newText)
    {
        std::replace (text.begin(), text.end(), ' ', '\0');

        for (std::size_t start { 0 }; start < text.size(); start += std::char_traits<char>::length (text.data() + start) + 1)
            words.push_back (text.data() + start);

        words.push_back (nullptr);
    }

    Keywords (const Keywords&) = delete;
    Keywords& operator= (const Keywords&) = delete;

    const char* const* getWords() const noexcept
    {
        return words.data();
    }

private:
    std::string text;
    std::vector<const char*> words;
};

```
