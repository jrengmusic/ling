```language
static constexpr int :::name:::Escape { :::escape::: };

#if defined (_WIN32)
extern "C" __declspec (dllexport) const void* ling_get_:::name::: (const char* name);
#else
extern "C" __attribute__ ((visibility ("default"))) const void* ling_get_:::name::: (const char* name);
#endif

extern "C" const void* ling_get_:::name::: (const char* name)
{
    static const Keywords keywords { "" :::keywords::: };
    static const std::unordered_map<std::string_view, const void*> entries {
        { LanguageEntry::build, reinterpret_cast<const void*> (&build) },
        { LanguageEntry::index, reinterpret_cast<const void*> (&index) },
        { LanguageEntry::addUnits, reinterpret_cast<const void*> (&addUnits) },
        { LanguageEntry::code, :::classes:::.data() },
        { LanguageEntry::commentOpen, "" :::commentOpen::: },
        { LanguageEntry::commentClose, "" :::commentClose::: },
        { LanguageEntry::lineCommentOpen, "" :::lineCommentOpen::: },
        { LanguageEntry::escape, &:::name:::Escape },
        { LanguageEntry::rawStringOpen, "" :::rawStringOpen::: },
        { LanguageEntry::keywords, keywords.getWords() },
        { LanguageEntry::roles, zeroTypeTable.data() },
        { LanguageEntry::symbolTypes, zeroTypeTable.data() },
        { LanguageEntry::completionTypes, zeroTypeTable.data() },
        { LanguageEntry::semanticTokenTypes, nullStrings },
        { LanguageEntry::semanticTokenModifiers, nullStrings },
        { LanguageEntry::semanticTypes, zeroTypeTable.data() },
        { LanguageEntry::semanticModifiers, zeroTypeTable.data() },
        { LanguageEntry::extensionPairs, nullStrings }
    };

    return entries.count (name) != 0 ? entries.at (name) : nullptr;
}

