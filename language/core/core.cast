    std::unique_ptr<Implementation> implementation;
};

class Tokens
{
public:
    Tokens();
    Tokens (Tokens&& other) noexcept;
    Tokens& operator= (Tokens&& other) noexcept;
    Tokens (const Tokens&) = delete;
    Tokens& operator= (const Tokens&) = delete;
