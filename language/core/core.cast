class LookupTable
{
public:
    LookupTable (std::initializer_list<std::pair<int, int>> entries);
    LookupTable (const LookupTable&) = delete;
    LookupTable& operator= (const LookupTable&) = delete;
    ~LookupTable();

    int operator[] (int key) const;
    const int* begin() const;

private:
    struct Implementation;
    std::unique_ptr<Implementation> implementation;
};

class AddressTable
{
public:
    AddressTable (std::initializer_list<std::pair<int, const void*>> entries);
    AddressTable (const AddressTable&) = delete;
    AddressTable& operator= (const AddressTable&) = delete;
    ~AddressTable();

    const void* operator[] (int key) const;

private:
    struct Implementation;
    std::unique_ptr<Implementation> implementation;
};

class HalfWords
{
public:
    static unsigned long long pack (int first, int second);
    static int unpackFirst (unsigned long long bits);
    static int unpackSecond (unsigned long long bits);
};

class Wyhash
{
public:
    static unsigned long long hashBytes (const void* key, std::size_t length);
    static unsigned long long mix (unsigned long long first, unsigned long long second);
};

class Subprocess
{
public:
    static std::optional<std::string> getOutput (std::string_view commandLine, const char* workingDirectory);
};

class DynamicLibrary
{
public:
    explicit DynamicLibrary (const char* path);
    DynamicLibrary (const DynamicLibrary&) = delete;
    DynamicLibrary& operator= (const DynamicLibrary&) = delete;
    ~DynamicLibrary();

    void* getFunction (const char* name);

private:
    struct Implementation;
    std::unique_ptr<Implementation> implementation;
};

class File
{
public:
    explicit File (const char* path);
    File (const File&) = delete;
    File& operator= (const File&) = delete;
    ~File();

    std::string loadFileAsString() const;

private:
    struct Implementation;
    std::unique_ptr<Implementation> implementation;
};
}
