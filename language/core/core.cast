```cmake
cmake_minimum_required (VERSION 3.25)

set (CMAKE_CXX_STANDARD 17)
set (CMAKE_CXX_STANDARD_REQUIRED ON)
set (CMAKE_CXX_EXTENSIONS OFF)
set (CMAKE_BUILD_TYPE Release CACHE STRING "")
set (CMAKE_C_VISIBILITY_PRESET hidden)
set (CMAKE_CXX_VISIBILITY_PRESET hidden)
set (CMAKE_VISIBILITY_INLINES_HIDDEN ON)
set (CMAKE_OSX_DEPLOYMENT_TARGET "11.0" CACHE STRING "")
set (CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded")

project (languageCore LANGUAGES C CXX)

set (jucePath "${CMAKE_CURRENT_SOURCE_DIR}/../../../../../JUCE")

add_subdirectory ("${jucePath}" "${CMAKE_BINARY_DIR}/JUCE")
juce_add_module ("${CMAKE_CURRENT_SOURCE_DIR}/../../../../jam/jam_core")
juce_add_module ("${CMAKE_CURRENT_SOURCE_DIR}/../../../../jam/jam_subprocess")

add_library (languageCore STATIC ling_LanguageCore.cpp)
target_include_directories (languageCore PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} "${jucePath}/modules/juce_graphics/fonts/harfbuzz")
target_link_libraries (languageCore PRIVATE jam_core jam_subprocess)
