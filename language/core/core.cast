#pragma once

#include <cstddef>
#include <cstdint>
#include <functional>
#include <initializer_list>
#include <memory>
#include <optional>
#include <string>
#include <string_view>
#include <utility>

#include "jam_LanguageInterface.h"

namespace ling
{
class Words
{
public:
    Words();
    Words (std::initializer_list<unsigned long long> words);
    Words (Words&& other) noexcept;
    Words& operator= (Words&& other) noexcept;
    Words (const Words&) = delete;
    Words& operator= (const Words&) = delete;
    ~Words();

    void add (unsigned long long word);
    void set (int index, unsigned long long word);
    unsigned long long at (int index) const;
    int size() const;
    void resize (int newSize);
    const unsigned long long* begin() const;
    const unsigned long long* end() const;
    void sort (const std::function<bool (unsigned long long first, unsigned long long second)>& isBefore);

private:
    struct Implementation;
    std::unique_ptr<Implementation> implementation;
};

class WordLists
{
public:
    WordLists();
    WordLists (WordLists&& other) noexcept;
    WordLists& operator= (WordLists&& other) noexcept;
    WordLists (const WordLists&) = delete;
    WordLists& operator= (const WordLists&) = delete;
    ~WordLists();

    void add (unsigned long long key, unsigned long long word);
    void insert (unsigned long long key, int index, unsigned long long word);
    void removeRange (unsigned long long key, int start, int count);
    void set (unsigned long long key, int index, unsigned long long word);
    bool contains (unsigned long long key) const;
    int getSize (unsigned long long key) const;
    unsigned long long at (unsigned long long key, int index) const;
    bool isEmpty() const;
    void sort (unsigned long long key, const std::function<bool (unsigned long long first, unsigned long long second)>& isBefore);
    void applyToKeys (const std::function<void (unsigned long long key)>& function) const;

private:
    struct Implementation;
    std::unique_ptr<Implementation> implementation;
};

class WordMap
{
public:
    WordMap();
    WordMap (std::initializer_list<std::pair<int, const void*>> entries);
    WordMap (WordMap&& other) noexcept;
    WordMap& operator= (WordMap&& other) noexcept;
    WordMap (const WordMap&) = delete;
    WordMap& operator= (const WordMap&) = delete;
    ~WordMap();

    void add (unsigned long long key, unsigned long long word);
    void set (unsigned long long key, unsigned long long word);
    bool contains (unsigned long long key) const;
    unsigned long long at (unsigned long long key) const;
    const void* getAddress (unsigned long long key) const;

private:
    struct Implementation;
    std::unique_ptr<Implementation> implementation;
};

class WordSet
{
public:
    WordSet();
    WordSet (WordSet&& other) noexcept;
    WordSet& operator= (WordSet&& other) noexcept;
    WordSet (const WordSet&) = delete;
    WordSet& operator= (const WordSet&) = delete;
    ~WordSet();

    void add (unsigned long long word);
    bool contains (unsigned long long word) const;

private:
    struct Implementation;
    std::unique_ptr<Implementation> implementation;
};

class TextMap
{
public:
    TextMap();
    TextMap (std::initializer_list<std::pair<std::string_view, int>> entries);
    TextMap (std::initializer_list<std::pair<std::string_view, const void*>> entries);
    TextMap (TextMap&& other) noexcept;
    TextMap& operator= (TextMap&& other) noexcept;
    TextMap (const TextMap&) = delete;
    TextMap& operator= (const TextMap&) = delete;
    ~TextMap();

    void add (std::string_view key, unsigned long long word);
    void set (std::string_view key, unsigned long long word);
    bool contains (std::string_view key) const;
    unsigned long long at (std::string_view key) const;
    const void* getAddress (std::string_view key) const;
    void applyToEntries (const std::function<void (std::string_view key, unsigned long long word)>& function) const;

private:
    struct Implementation;
    std::unique_ptr<Implementation> implementation;
};

class Texts
{
public:
    Texts();
    Texts (Texts&& other) noexcept;
    Texts& operator= (Texts&& other) noexcept;
    Texts (const Texts&) = delete;
    Texts& operator= (const Texts&) = delete;
    ~Texts();

    int add (std::string_view text);
    bool contains (std::string_view text) const;
    std::string_view get (int index) const;
    const char* getPointer (int index) const;
    int size() const;

private:
